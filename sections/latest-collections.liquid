{%- liquid
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign padding_top = section.settings.padding_top | default: 60
  assign padding_bottom = section.settings.padding_bottom | default: 60

  assign active_index = 0
  for block in section.blocks
    assign link = block.settings.link | default: '#'
    if link contains 'natural-diamond'
      assign active_index = forloop.index0
      break
    endif
  endfor

  assign last_index = section.blocks.size | minus: 1
  assign left_idx = active_index | minus: 1
  if active_index == 0
    assign left_idx = last_index
  endif
  assign right_idx = active_index | plus: 1
  if active_index == last_index
    assign right_idx = 0
  endif
-%}

<latest-collections-slider class="latest-collections" data-active-index="{{ active_index }}" style="--bg-color: {{ bg_color }}; --padding-top: {{ padding_top }}px; --padding-bottom: {{ padding_bottom }}px;">
  <style>
    @media screen and (max-width: 768px) {
      latest-collections-slider:not([js-initialized]) .latest-collections__col[data-index="{{ active_index }}"] {
        transform: translate3d(-50%, -50%, 0) scale(1) !important;
        opacity: 1 !important;
        z-index: 3 !important;
        pointer-events: auto !important;
      }
      latest-collections-slider:not([js-initialized]) .latest-collections__col[data-index="{{ left_idx }}"] {
        transform: translate3d(calc(-50% - 96%), calc(-50% + 12px), 0) scale(0.85) !important;
        opacity: 0.8 !important;
        z-index: 2 !important;
        pointer-events: auto !important;
      }
      latest-collections-slider:not([js-initialized]) .latest-collections__col[data-index="{{ right_idx }}"] {
        transform: translate3d(calc(-50% + 96%), calc(-50% + 12px), 0) scale(0.85) !important;
        opacity: 0.8 !important;
        z-index: 2 !important;
        pointer-events: auto !important;
      }
    }
  </style>
  <div class="latest-collections__container">
    <div class="latest-collections__header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="latest-collections__eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="latest-collections__heading serif-font">{{ section.settings.title | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.subtitle != blank -%}
        <p class="latest-collections__description">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
    </div>

    <div class="latest-collections__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign title = block.settings.title
          assign subtitle = block.settings.subtitle
          assign image = block.settings.image
          assign link = block.settings.link | default: '#'
          assign text_pos = block.settings.text_position | default: 'bottom-center'
          assign title_style = block.settings.title_style | default: 'white'
          assign custom_color = block.settings.custom_title_color | default: '#ffffff'
          assign subtitle_color = block.settings.subtitle_color | default: '#ffffff'
          assign font_sz_desktop = block.settings.title_font_size_desktop | default: 28
          assign font_sz_mobile = block.settings.title_font_size_mobile | default: 20
          assign font_weight = block.settings.title_font_weight | default: '400'
          
          assign fallback_image_name = 'fallback-image.png'
        -%}
        
        <div class="latest-collections__col {% if forloop.index0 == active_index %}is-active{% endif %}" data-index="{{ forloop.index0 }}">
          <div class="latest-collections__card" {{ block.shopify_attributes }}>
            <a href="{{ link }}" class="latest-collections__card-link" aria-label="{{ title | escape }}">
              <div class="latest-collections__image-wrap">
                {%- if image != blank -%}
                  {{ image | image_url: width: 800 | image_tag: loading: 'lazy', alt: title, class: 'latest-collections__img' }}
                {%- else -%}
                  <img src="{{ fallback_image_name | asset_url }}" alt="{{ title | escape }}" loading="lazy" class="latest-collections__img" width="800" height="550">
                {%- endif -%}
              </div>
              
              <div class="latest-collections__card-overlay latest-collections__card-overlay--{{ text_pos }}">
                <div class="latest-collections__card-content">
                  <h3 class="latest-collections__card-title latest-collections__card-title--{{ title_style }} serif-font" 
                      style="--custom-color: {{ custom_color }}; --font-size-desktop: {{ font_sz_desktop }}px; --font-size-mobile: {{ font_sz_mobile }}px; --font-weight: {{ font_weight }};">
                    {{ title | escape }}
                  </h3>
                  {%- if subtitle != blank -%}
                    <p class="latest-collections__card-subtitle" style="--subtitle-color: {{ subtitle_color }};">
                      {{ subtitle | escape }}
                    </p>
                  {%- endif -%}
                </div>
              </div>
            </a>
          </div>
        </div>
      {%- endfor -%}
    </div>

    <div class="latest-collections__nav">
      <button class="latest-collections__nav-btn latest-collections__nav-btn--prev" aria-label="Previous">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      
      <div class="latest-collections__pagination">
        <div class="latest-collections__pagination-text">
          <span class="latest-collections__current-page">0{{ active_index | plus: 1 }}</span>
          <span class="latest-collections__divider">/</span>
          <span class="latest-collections__total-pages">{% if section.blocks.size < 10 %}0{% endif %}{{ section.blocks.size }}</span>
        </div>
        <div class="latest-collections__pagination-bars">
          {%- for block in section.blocks -%}
            <button class="latest-collections__bar {% if forloop.index0 == active_index %}is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>
          {%- endfor -%}
        </div>
      </div>

      <button class="latest-collections__nav-btn latest-collections__nav-btn--next" aria-label="Next">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="latest-collections__button-container">
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" 
           class="latest-collections__btn pill-button"
           style="--btn-bg: {{ section.settings.btn_bg_color }}; --btn-text: {{ section.settings.btn_text_color }}; --btn-hover-bg: {{ section.settings.btn_hover_bg_color }}; --btn-hover-text: {{ section.settings.btn_hover_text_color }};">
          {{ section.settings.button_label | escape }} &rarr;
        </a>
      </div>
    {%- endif -%}
  </div>
</latest-collections-slider>

{% stylesheet %}
  .latest-collections {
    display: block;
    background-color: var(--bg-color);
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    width: 100%;
    box-sizing: border-box;
  }

  .latest-collections__nav {
    display: none;
  }

  .latest-collections__container {
    max-width: 1400px;
    margin: 0 auto;
    padding-left: 4.8rem;
    padding-right: 4.8rem;
    box-sizing: border-box;
  }

  .latest-collections__header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 50px auto;
  }

  .latest-collections__eyebrow {
    display: block;
    font-size: 14px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #c5a47e;
    margin-bottom: 12px;
    font-weight: 600;
  }

  .latest-collections__heading {
    font-size: 36px;
    line-height: 1.2;
    color: var(--color-primary, #013F3E);
    margin: 0 0 16px 0;
    font-weight: 500;
    letter-spacing: 0.05em;
  }

  .latest-collections__description {
    font-size: 16px;
    line-height: 1.6;
    color: #555555;
    margin: 0;
  }

  .latest-collections__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.4rem;
    align-items: flex-start;
    max-width: 1240px;
    margin: 0 auto;
  }

  .latest-collections__col {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .latest-collections__card {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    width: 100%;
    max-width: 396px;
    margin: 0 auto;
    aspect-ratio: 396 / 460;
    background-color: #faf7f2;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
    border: 1px solid rgba(1, 63, 62, 0.03);
  }

  /* Shift outer cards down on desktop */
  .latest-collections__col:nth-child(1),
  .latest-collections__col:nth-child(3) {
    margin-top: 6rem;
  }

  .latest-collections__card:hover {
    transform: translateY(-8px);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.12);
    border-color: rgba(212, 175, 55, 0.2);
  }

  .latest-collections__card-link {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }

  .latest-collections__image-wrap {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: #f0ebe1;
  }

  /* Soft Gradient Scrim Overlay for Enhanced Text Contrast */
  .latest-collections__image-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 35%, rgba(0, 0, 0, 0.45) 100%);
    pointer-events: none;
    z-index: 1;
    opacity: 0.85;
    transition: opacity 0.4s ease;
  }

  .latest-collections__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .latest-collections__card:hover .latest-collections__img {
    transform: scale(1.05);
  }

  .latest-collections__card-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    padding: 3.2rem 2.4rem;
    box-sizing: border-box;
    z-index: 2;
    background: transparent;
    pointer-events: none;
  }

  .latest-collections__card-content {
    display: flex;
    flex-direction: column;
    max-width: 100%;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .latest-collections__card:hover .latest-collections__card-content {
    transform: translateY(-4px);
  }

  .latest-collections__card-overlay--top-left,
  .latest-collections__card-overlay--top-center,
  .latest-collections__card-overlay--top-right {
    align-items: flex-start;
  }
  
  .latest-collections__card-overlay--middle-left,
  .latest-collections__card-overlay--middle-center,
  .latest-collections__card-overlay--middle-right {
    align-items: center;
  }
  
  .latest-collections__card-overlay--bottom-left,
  .latest-collections__card-overlay--bottom-center,
  .latest-collections__card-overlay--bottom-right {
    align-items: flex-end;
  }

  .latest-collections__card-overlay--top-left,
  .latest-collections__card-overlay--middle-left,
  .latest-collections__card-overlay--bottom-left {
    justify-content: flex-start;
    text-align: left;
  }
  
  .latest-collections__card-overlay--top-center,
  .latest-collections__card-overlay--middle-center,
  .latest-collections__card-overlay--bottom-center {
    justify-content: center;
    text-align: center;
  }
  
  .latest-collections__card-overlay--top-right,
  .latest-collections__card-overlay--middle-right,
  .latest-collections__card-overlay--bottom-right {
    justify-content: flex-end;
    text-align: right;
  }

  .latest-collections__card-title {
    font-size: var(--font-size-desktop);
    font-weight: var(--font-weight);
    margin: 0;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .latest-collections__card-title--white {
    color: #ffffff;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  .latest-collections__card-title--gold {
    color: var(--color-accent, #D4AF37);
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
  }

  .latest-collections__card-title--gradient {
    background: linear-gradient(90deg, #ffffff 0%, #D4AF37 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: inline-block;
  }

  .latest-collections__card-title--custom {
    color: var(--custom-color);
  }

  .latest-collections__card-subtitle {
    font-family: 'Montserrat', sans-serif;
    font-size: 1rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--subtitle-color);
    margin: 1rem 0 0 0;
    opacity: 0.9;
  }

  .latest-collections__button-container {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-top: -5.4rem; /* Tucked directly below center card */
    position: relative;
    z-index: 10;
  }

  .latest-collections__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1.4rem 4rem;
    background-color: var(--btn-bg, #013F3E);
    color: var(--btn-text, #ffffff);
    font-family: 'Montserrat', sans-serif;
    font-size: 1.3rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    text-decoration: none;
    border-radius: 5rem;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    border: 1px solid rgba(1, 63, 62, 0.1);
    box-shadow: 0 4px 15px rgba(1, 63, 62, 0.08);
  }

  .latest-collections__btn:hover {
    background-color: var(--btn-hover-bg, #025654);
    color: var(--btn-hover-text, #ffffff);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(1, 63, 62, 0.16);
  }

  @media screen and (max-width: 1200px) {
    .latest-collections__container {
      padding-left: 2rem;
      padding-right: 2rem;
    }
    .latest-collections__grid {
      gap: 1.6rem;
    }
    .latest-collections__card-overlay {
      padding: 2.4rem;
    }
    .latest-collections__col:nth-child(1),
    .latest-collections__col:nth-child(3) {
      margin-top: 4.8rem;
    }
    .latest-collections__button-container {
      margin-top: -4.2rem;
    }
  }

  .latest-collections__col.is-clone {
    display: none;
  }

  @media screen and (max-width: 768px) {
    .latest-collections__col.is-clone {
      display: block;
    }

    .latest-collections {
      padding-top: calc(var(--padding-top, 60px) * 0.6);
      padding-bottom: calc(var(--padding-bottom, 60px) * 0.6);
    }
    
    .latest-collections__container {
      padding-left: 0;
      padding-right: 0;
    }

    .latest-collections__header {
      margin-bottom: 10px;
    }

    .latest-collections__eyebrow {
      display: block;
      text-align: center;
      font-family: 'Montserrat', sans-serif;
      font-size: 0.95rem;
      font-weight: 500;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--color-accent, #D4AF37);
      margin-bottom: 0.8rem;
    }

    .latest-collections__heading {
      font-size: 28px;
      margin-bottom: 8px;
      padding-left: 20px;
      padding-right: 20px;
    }

    .latest-collections__description {
      font-size: 13px;
      padding-left: 20px;
      padding-right: 20px;
      text-align: center;
    }

    .latest-collections__grid {
      --card-width: clamp(250px, 68vw, 290px);
      position: relative;
      width: 100%;
      height: 350px; /* Perfectly tailored height for mobile card + shadow without excess white space */
      display: flex;
      justify-content: center;
      align-items: center;
      overflow: hidden;
      margin: 0 auto;
      padding: 0;
      box-sizing: border-box;
      touch-action: pan-y;
    }

    .latest-collections__col {
      position: absolute;
      width: var(--card-width);
      max-width: var(--card-width);
      margin: 0 !important;
      padding: 0;
      left: 50%;
      top: 50%;
      transform: translate3d(-50%, -50%, 0) scale(0.7);
      opacity: 0;
      z-index: 1;
      pointer-events: none;
      transition: transform 0.6s cubic-bezier(0.25, 0.8, 0.25, 1), opacity 0.6s ease;
      will-change: transform, opacity;
      cursor: pointer;
    }

    /* Initial 3-card layout before JS runs */
    .latest-collections__col:nth-child(1) {
      transform: translate3d(-50%, -50%, 0) scale(1);
      opacity: 1;
      z-index: 3;
      pointer-events: auto;
    }

    .latest-collections__col:nth-child(2) {
      transform: translate3d(calc(-50% + 96%), calc(-50% + 12px), 0) scale(0.85);
      opacity: 0.8;
      z-index: 2;
      pointer-events: auto;
    }

    .latest-collections__col:nth-child(3) {
      transform: translate3d(calc(-50% - 96%), calc(-50% + 12px), 0) scale(0.85);
      opacity: 0.8;
      z-index: 2;
      pointer-events: auto;
    }

    .latest-collections__card-title {
      font-size: var(--font-size-mobile);
    }

    .latest-collections__card-subtitle {
      font-size: 0.9rem;
      letter-spacing: 0.1em;
    }

    .latest-collections__nav {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 24px;
      margin-top: 1rem;
      margin-bottom: 1.5rem;
    }

    .latest-collections__nav-btn {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 1px solid #c5a47e;
      background: transparent;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #013F3E;
      cursor: pointer;
      transition: all 0.3s ease;
      padding: 0;
    }
    
    .latest-collections__nav-btn:hover {
      background: rgba(197, 164, 126, 0.1);
    }

    .latest-collections__pagination {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
    }

    .latest-collections__pagination-text {
      font-size: 1.3rem;
      font-family: var(--font-heading-family);
      color: #666;
    }

    .latest-collections__current-page {
      color: #013F3E;
      font-weight: 600;
      font-size: 1.4rem;
    }

    .latest-collections__divider {
      margin: 0 4px;
      color: #999;
      font-weight: 400;
      font-size: 1.2rem;
    }

    .latest-collections__total-pages {
      color: #666;
      font-weight: 400;
      font-size: 1.2rem;
    }

    .latest-collections__pagination-bars {
      display: flex;
      gap: 6px;
    }

    .latest-collections__bar {
      position: relative;
      width: 16px;
      height: 2px;
      background-color: #EADCD0;
      border: none;
      padding: 0;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .latest-collections__bar::before {
      content: '';
      position: absolute;
      top: -12px;
      bottom: -12px;
      left: -4px;
      right: -4px;
    }
    
    .latest-collections__bar.is-active {
      background-color: #c5a47e;
    }

    .latest-collections__button-container {
      margin-top: 0;
    }

    .latest-collections__btn {
      padding: 1.2rem 3.2rem;
      font-size: 1.2rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  class LatestCollectionsSlider extends HTMLElement {
    constructor() {
      super();
      this.slider = this.querySelector('.latest-collections__grid');
      this.dots = Array.from(this.querySelectorAll('.latest-collections__bar'));
      
      const prevBtn = this.querySelector('.latest-collections__nav-btn--prev');
      const nextBtn = this.querySelector('.latest-collections__nav-btn--next');
      if (prevBtn) prevBtn.addEventListener('click', () => { if (window.innerWidth <= 768) this.prev(); });
      if (nextBtn) nextBtn.addEventListener('click', () => { if (window.innerWidth <= 768) this.next(); });
      
      if (!this.slider) return;
      this.slides = Array.from(this.slider.children);
      if (this.slides.length === 0) return;

      const activeIdxAttr = this.getAttribute('data-active-index');
      this.currentIndex = activeIdxAttr ? parseInt(activeIdxAttr) : 0;
      this.totalSlides = this.slides.length;

      this.init();
    }

    init() {
      // On mobile, if fewer than 5 slides, clone them so wrap-around happens invisibly in deep background without card recycling overlap
      if (this.slides.length > 0 && this.slides.length < 5) {
        const initialCount = this.slides.length;
        for (let i = 0; i < initialCount; i++) {
          const clone = this.slides[i].cloneNode(true);
          clone.classList.add('is-clone');
          this.slider.appendChild(clone);
        }
        this.slides = Array.from(this.slider.children);
        this.totalSlides = this.slides.length;
      }

      // Dot click handling
      this.dots.forEach((dot, index) => {
        dot.addEventListener('click', () => {
          const numDots = this.dots.length;
          if ((this.currentIndex % numDots) !== index) {
            this.currentIndex = index;
            this.update();
          }
        });
      });

      // Card tap handling (side peek cards navigate to center)
      this.slides.forEach((slide, index) => {
        slide.addEventListener('click', (e) => {
          if (window.innerWidth <= 768 && index !== this.currentIndex) {
            e.preventDefault();
            this.currentIndex = index;
            this.update();
          }
        });
      });

      // Touch swipe handling for horizontal coverflow carousel
      let startX = 0;
      let startY = 0;
      let isDragging = false;

      this.slider.addEventListener('touchstart', (e) => {
        if (window.innerWidth > 768) return;
        startX = e.touches[0].clientX;
        startY = e.touches[0].clientY;
        isDragging = true;
      }, { passive: true });

      this.slider.addEventListener('touchmove', (e) => {
        if (!isDragging || window.innerWidth > 768) return;
        const currentX = e.touches[0].clientX;
        const currentY = e.touches[0].clientY;
        const diffX = startX - currentX;
        const diffY = startY - currentY;

        // Ignore if scrolling vertically up/down the webpage
        if (Math.abs(diffY) > Math.abs(diffX)) return;

        if (Math.abs(diffX) > 35) {
          if (diffX > 0) {
            this.next();
          } else {
            this.prev();
          }
          isDragging = false;
        }
      }, { passive: true });

      this.slider.addEventListener('touchend', () => {
        isDragging = false;
      });

      window.addEventListener('resize', () => {
        this.update();
      });

      this.setAttribute('js-initialized', 'true');
      this.update();
    }

    next() {
      this.currentIndex = (this.currentIndex + 1) % this.totalSlides;
      this.update();
    }

    prev() {
      this.currentIndex = (this.currentIndex - 1 + this.totalSlides) % this.totalSlides;
      this.update();
    }

    update() {
      const isMobile = window.innerWidth <= 768;
      const total = this.totalSlides;

      if (!isMobile) {
        // Reset inline styles on desktop so standard grid takes over and hide clones
        this.slides.forEach((slide) => {
          if (slide.classList.contains('is-clone')) {
            slide.style.display = 'none';
          } else {
            slide.style.display = '';
            slide.style.transform = '';
            slide.style.opacity = '';
            slide.style.zIndex = '';
            slide.style.pointerEvents = '';
            slide.classList.remove('is-active', 'is-peek-left', 'is-peek-right');
          }
        });
        return;
      } else {
        this.slides.forEach((slide) => {
          slide.style.display = '';
        });
      }

      const xStep = 96; // Percentage shift to maintain clean gap and visible side cards

      this.slides.forEach((slide, index) => {
        let diff = index - this.currentIndex;
        let offset = ((diff % total) + total) % total;
        if (offset > Math.floor(total / 2)) {
          offset -= total;
        }

        // Detect if card is wrapping around the back of the carousel (jumping between opposite sides)
        const prevOffset = slide._prevOffset;
        const isWrapping = prevOffset !== undefined && Math.abs(offset - prevOffset) > 1;
        slide._prevOffset = offset;

        if (isWrapping) {
          slide.style.transition = 'none';
        } else {
          slide.style.transition = '';
        }

        let translateX, translateY, scale, opacity, zIndex, pointerEvents;
        let isCenter = false;
        let isLeft = false;
        let isRight = false;

        if (offset === 0) {
          // Active center card
          translateX = '-50%';
          translateY = '-50%';
          scale = 1;
          opacity = 1;
          zIndex = 3;
          pointerEvents = 'auto';
          isCenter = true;
        } else if (offset === -1 || (offset === total - 1 && total > 2)) {
          // Left side peeking card
          translateX = `calc(-50% - ${xStep}%)`;
          translateY = 'calc(-50% + 12px)';
          scale = 0.85;
          opacity = 0.8;
          zIndex = 2;
          pointerEvents = 'auto';
          isLeft = true;
        } else if (offset === 1 || (offset === -(total - 1) && total > 2)) {
          // Right side peeking card
          translateX = `calc(-50% + ${xStep}%)`;
          translateY = 'calc(-50% + 12px)';
          scale = 0.85;
          opacity = 0.8;
          zIndex = 2;
          pointerEvents = 'auto';
          isRight = true;
        } else {
          // Hidden back cards
          translateX = `calc(-50% + ${offset > 0 ? 120 : -120}%)`;
          translateY = 'calc(-50% + 24px)';
          scale = 0.7;
          opacity = 0;
          zIndex = 1;
          pointerEvents = 'none';
        }

        slide.style.transform = `translate3d(${translateX}, ${translateY}, 0) scale(${scale})`;
        slide.style.opacity = opacity;
        slide.style.zIndex = zIndex;
        slide.style.pointerEvents = pointerEvents;

        slide.classList.toggle('is-active', isCenter);
        slide.classList.toggle('is-peek-left', isLeft);
        slide.classList.toggle('is-peek-right', isRight);
      });

      const numDots = this.dots.length;
      this.dots.forEach((dot, index) => {
        dot.classList.toggle('is-active', index === (this.currentIndex % numDots));
      });
      
      const currentPageEl = this.querySelector('.latest-collections__current-page');
      if (currentPageEl) {
        const pageNum = (this.currentIndex % numDots) + 1;
        currentPageEl.textContent = pageNum < 10 ? '0' + pageNum : pageNum;
      }
    }
  }

  if (!customElements.get('latest-collections-slider')) {
    customElements.define('latest-collections-slider', LatestCollectionsSlider);
  }
{% endjavascript %}

