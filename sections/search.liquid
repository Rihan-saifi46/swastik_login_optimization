{% comment %}
  This section is used in the search template to render search results in a
  luxury collection-like product grid layout, reusing existing styling and snippets.
{% endcomment %}
{%- assign clean_terms = search.terms | split: ' OR sku:' | first -%}

<div class="collection-page" style="background-color: #ffffff; padding: 3rem 0 6rem;">
  
  <!-- Breadcrumb Navigation -->
  <div style="--breadcrumb-max-width: 1600px; --breadcrumb-padding: 0 4rem; --breadcrumb-padding-mobile: 0 1.2rem;">
    <nav class="pp-breadcrumb-nav" aria-label="Breadcrumb">
      <div class="pp-breadcrumb-container">
        <ol class="pp-breadcrumb-list">
          <li class="pp-breadcrumb-item">
            <a href="{{ routes.root_url }}" class="pp-breadcrumb-link" title="Home">Home</a>
          </li>
          <li class="pp-breadcrumb-item is-active" aria-current="page">
            <span class="pp-breadcrumb-separator" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
            </span>
            <span class="pp-breadcrumb-current">Search Results</span>
          </li>
        </ol>
      </div>
    </nav>
  </div>

  <div class="collection-page__container" style="max-width: 1600px; margin: 0 auto; padding: 0 4rem; box-sizing: border-box;">
    
    <!-- Toolbar -->
    <div class="collection-toolbar" style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(0,46,40,0.08); padding-bottom: 1rem;">
      <h1 style="color: #013F3E; font-family: 'Outfit', sans-serif; font-size: 1.75rem; font-weight: 600; margin: 0;">
        {% if search.performed %}
          Search Results: "{{ clean_terms | escape }}"
        {% else %}
          Search Swastik Jewels
        {% endif %}
      </h1>
      <div class="collection-toolbar__count" style="font-family: 'Inter', sans-serif; font-size: 0.95rem; color: #013F3E; font-weight: 500;">
        {% if search.performed %}
          {{ search.results_count }} Products Found
        {% endif %}
      </div>
    </div>

    <!-- Product Grid -->
    {% if search.performed and search.results_count > 0 %}
      {% paginate search.results by 24 %}
        <div class="collection-grid">
          {% for item in search.results %}
            {% if item.object_type == 'product' %}
              {% render 'product-card', product: item, class_prefix: 'best-sellers' %}
            {% endif %}
          {% endfor %}
        </div>
        
        <!-- Pagination -->
        {% if paginate.pages > 1 %}
          <div class="collection-pagination" style="margin-top: 4rem; display: flex; justify-content: center; gap: 0.5rem;">
            {% if paginate.previous %}
              <a href="{{ paginate.previous.url }}" style="padding: 0.5rem 1rem; background: #faf7f2; color: #333; text-decoration: none; border-radius: 4px;">&laquo; Previous</a>
            {% endif %}
            
            {% for part in paginate.parts %}
              {% if part.is_link %}
                <a href="{{ part.url }}" style="padding: 0.5rem 1rem; background: #faf7f2; color: #333; text-decoration: none; border-radius: 4px;">{{ part.title }}</a>
              {% else %}
                {% if part.title == paginate.current_page %}
                  <span class="current" style="padding: 0.5rem 1rem; background: #013F3E; color: #fff; border-radius: 4px;">{{ part.title }}</span>
                {% else %}
                  <span style="padding: 0.5rem 1rem; background: #faf7f2; color: #777; border-radius: 4px;">{{ part.title }}</span>
                {% endif %}
              {% endif %}
            {% endfor %}

            {% if paginate.next %}
              <a href="{{ paginate.next.url }}" style="padding: 0.5rem 1rem; background: #faf7f2; color: #333; text-decoration: none; border-radius: 4px;">Next &raquo;</a>
            {% endif %}
          </div>
        {% endif %}
      {% endpaginate %}
    {% else %}
      <div style="text-align: center; padding: 6rem 0; background: #FAF8F2; border-radius: 8px; border: 1px solid rgba(1, 63, 62, 0.05);">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#013F3E" stroke-width="1.5" style="margin-bottom: 1.5rem; opacity: 0.7;">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <p style="font-family: 'Inter', sans-serif; font-size: 1.1rem; color: #013F3E; font-weight: 500; margin: 0 0 0.5rem 0;">
          No jewelry found for "{{ clean_terms | escape }}"
        </p>
        <p style="font-family: 'Inter', sans-serif; font-size: 0.95rem; color: #666; margin: 0;">
          Try searching for "rings", "necklaces", or "diamonds".
        </p>
      </div>
    {% endif %}

  </div>
</div>

{% stylesheet %}
  /* Reusing the collection grid layout styling specifically for search pages */
  .collection-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }
  
  @media screen and (max-width: 1200px) {
    .collection-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  
  @media screen and (max-width: 900px) {
    .collection-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
  }
  
  @media screen and (max-width: 500px) {
    .collection-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Search Results",
  "settings": []
}
{% endschema %}
