{% comment %}
  This section is used in the search template to render search results in a
  luxury collection-like product grid layout, reusing existing styling and snippets.
{% endcomment %}
{%- assign clean_terms = search.terms | split: ' OR sku:' | first -%}
{%- assign query_sku = clean_terms | strip | downcase -%}

{%- comment -%}
  Exact SKU Detection: If any returned product has a variant with an exact matching SKU,
  narrow results exclusively to products matching that exact SKU.
{%- endcomment -%}
{%- assign exact_sku_count = 0 -%}
{%- if search.performed and search.results_count > 0 and query_sku != blank -%}
  {%- for item in search.results -%}
    {%- if item.object_type == 'product' -%}
      {%- for variant in item.variants -%}
        {%- assign v_sku = variant.sku | strip | downcase -%}
        {%- if v_sku == query_sku -%}
          {%- assign exact_sku_count = exact_sku_count | plus: 1 -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

<div class="collection-page" style="background-color: #ffffff; padding: 3rem 0 6rem;">
  
  <!-- Breadcrumb Navigation -->
  <div style="--breadcrumb-max-width: 1600px; --breadcrumb-padding: 0 4rem; --breadcrumb-padding-mobile: 0 1.2rem;">
    <nav class="pp-breadcrumb-nav" aria-label="Breadcrumb">
      <div class="pp-breadcrumb-container">
        <ol class="pp-breadcrumb-list">
          <li class="pp-breadcrumb-item">
            <a href="{{ routes.root_url }}" class="pp-breadcrumb-link" title="Home">Home</a>
          </li>
          <li class="pp-breadcrumb-item is-active" aria-current="page">
            <span class="pp-breadcrumb-separator" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
            </span>
            <span class="pp-breadcrumb-current">Search Results</span>
          </li>
        </ol>
      </div>
    </nav>
  </div>

  <div class="collection-page__container" style="max-width: 1600px; margin: 0 auto; padding: 0 4rem; box-sizing: border-box;">
    
    <!-- Dedicated Search Form (Desktop & Mobile) -->
    <div class="search-page__form-wrapper">
      <form action="{{ routes.search_url }}" method="get" class="search-page__form" role="search">
        <div class="search-page__input-container">
          <svg class="search-page__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input 
            type="search" 
            name="q" 
            class="search-page__input" 
            placeholder="Search for rings, earrings, necklaces and more..." 
            value="{{ clean_terms | escape }}" 
            autocomplete="off" 
            autocorrect="off" 
            required
            aria-label="Search Swastik Jewels"
          >
          <input type="hidden" name="type" value="product">
          <input type="hidden" name="options[prefix]" value="last">
          <button type="submit" class="search-page__submit-button">
            Search
          </button>
        </div>
      </form>
    </div>

    <!-- Toolbar -->
    <div class="collection-toolbar" style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(0,46,40,0.08); padding-bottom: 1rem;">
      <h1 style="color: #013F3E; font-family: 'Outfit', sans-serif; font-size: 1.75rem; font-weight: 600; margin: 0;">
        {% if search.performed %}
          Search Results: "{{ clean_terms | escape }}"
        {% else %}
          Search Swastik Jewels
        {% endif %}
      </h1>
      <div class="collection-toolbar__count" style="font-family: 'Inter', sans-serif; font-size: 0.95rem; color: #013F3E; font-weight: 500;">
        {% if search.performed %}
          {% if exact_sku_count > 0 %}
            {{ exact_sku_count }} {% if exact_sku_count == 1 %}Product{% else %}Products{% endif %} Found
          {% else %}
            {{ search.results_count }} Products Found
          {% endif %}
        {% endif %}
      </div>
    </div>

    <!-- Product Grid -->
    {% if search.performed and search.results_count > 0 %}
      {% paginate search.results by 24 %}
        <div class="collection-grid">
          {% for item in search.results %}
            {% if item.object_type == 'product' %}
              {% if exact_sku_count > 0 %}
                {% assign is_exact_sku = false %}
                {% for variant in item.variants %}
                  {% assign v_sku = variant.sku | strip | downcase %}
                  {% if v_sku == query_sku %}
                    {% assign is_exact_sku = true %}
                    {% break %}
                  {% endif %}
                {% endfor %}
                {% if is_exact_sku %}
                  {% render 'product-card', product: item, class_prefix: 'best-sellers' %}
                {% endif %}
              {% else %}
                {% render 'product-card', product: item, class_prefix: 'best-sellers' %}
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>
        
        <!-- Pagination -->
        {% if exact_sku_count == 0 and paginate.pages > 1 %}
          <div class="collection-pagination">
            {% if paginate.previous %}
              <span class="prev"><a href="{{ paginate.previous.url }}">&laquo; Prev</a></span>
            {% endif %}
            
            {% for part in paginate.parts %}
              {% if part.is_link %}
                <span class="page"><a href="{{ part.url }}">{{ part.title }}</a></span>
              {% else %}
                {% if part.title == paginate.current_page %}
                  <span class="page current">{{ part.title }}</span>
                {% else %}
                  <span class="deco">{{ part.title }}</span>
                {% endif %}
              {% endif %}
            {% endfor %}

            {% if paginate.next %}
              <span class="next"><a href="{{ paginate.next.url }}">Next &raquo;</a></span>
            {% endif %}
          </div>
        {% endif %}
      {% endpaginate %}
    {% else %}
      <div style="text-align: center; padding: 6rem 0; background: #FAF8F2; border-radius: 8px; border: 1px solid rgba(1, 63, 62, 0.05);">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#013F3E" stroke-width="1.5" style="margin-bottom: 1.5rem; opacity: 0.7;">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <p style="font-family: 'Inter', sans-serif; font-size: 1.1rem; color: #013F3E; font-weight: 500; margin: 0 0 0.5rem 0;">
          No jewelry found for "{{ clean_terms | escape }}"
        </p>
        <p style="font-family: 'Inter', sans-serif; font-size: 0.95rem; color: #666; margin: 0;">
          Try searching for "rings", "necklaces", or "diamonds".
        </p>
      </div>
    {% endif %}

  </div>
</div>

<script>
  (function() {
    function initSearchPageAutoSubmit() {
      const searchForm = document.querySelector('.search-page__form');
      if (!searchForm) return;

      const searchInput = searchForm.querySelector('.search-page__input');
      if (!searchInput) return;

      let debounceTimer = null;
      const initialQuery = (searchInput.value || '').trim();

      searchInput.addEventListener('input', function(e) {
        clearTimeout(debounceTimer);
        const currentQuery = e.target.value.trim();

        // Do not auto-submit if the field is empty or unchanged from currently loaded page query
        if (currentQuery.length === 0 || currentQuery.toLowerCase() === initialQuery.toLowerCase()) {
          return;
        }

        // Auto-submit after 500ms of typing inactivity
        debounceTimer = setTimeout(function() {
          if (typeof searchForm.requestSubmit === 'function') {
            searchForm.requestSubmit();
          } else {
            searchForm.submit();
          }
        }, 500);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSearchPageAutoSubmit);
    } else {
      initSearchPageAutoSubmit();
    }
  })();
</script>

{% stylesheet %}
  /* Search Page Form Styling - Mobile / Tablet Only (<=1150px) */
  .search-page__form-wrapper {
    display: none;
  }

  @media screen and (max-width: 1150px) {
    .search-page__form-wrapper {
      display: block;
      max-width: 680px;
      margin: 0 auto 2rem;
      box-sizing: border-box;
    }
  }
  
  .search-page__form {
    width: 100%;
  }
  
  .search-page__input-container {
    display: flex;
    align-items: center;
    position: relative;
    background: #FAF8F2;
    border: 1px solid rgba(1, 63, 62, 0.15);
    border-radius: 30px;
    padding: 4px 6px 4px 18px;
    transition: all 0.25s ease;
    box-sizing: border-box;
  }
  
  .search-page__input-container:focus-within {
    border-color: #013F3E;
    background: #FFFFFF;
    box-shadow: 0 0 0 3px rgba(1, 63, 62, 0.08);
  }
  
  .search-page__icon {
    width: 20px;
    height: 20px;
    color: #013F3E;
    opacity: 0.6;
    flex-shrink: 0;
    margin-right: 12px;
  }
  
  .search-page__input {
    flex: 1;
    min-width: 0;
    border: none;
    background: transparent;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 1rem;
    color: #013F3E;
    padding: 11px 8px 11px 0;
    outline: none;
    -webkit-appearance: none;
  }
  
  .search-page__input::placeholder {
    color: #888888;
    font-size: 0.95rem;
  }
  
  .search-page__submit-button {
    background: #013F3E;
    color: #FFFFFF;
    border: none;
    border-radius: 24px;
    padding: 10px 22px;
    font-family: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.5px;
    cursor: pointer;
    flex-shrink: 0;
    transition: background-color 0.2s ease, transform 0.15s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  
  .search-page__submit-button:hover {
    background: #022B2A;
    transform: translateY(-1px);
  }
  
  .search-page__submit-button:active {
    transform: translateY(0);
  }

  @media screen and (max-width: 768px) {
    .collection-page__container {
      padding: 0 1.2rem !important;
    }
    .search-page__form-wrapper {
      margin-bottom: 2rem;
    }
    .search-page__input-container {
      padding: 3px 4px 3px 14px;
    }
    .search-page__icon {
      width: 18px;
      height: 18px;
      margin-right: 8px;
    }
    .search-page__input {
      font-size: 0.95rem;
      padding: 9px 6px 9px 0;
    }
    .search-page__input::placeholder {
      font-size: 0.85rem;
    }
    .search-page__submit-button {
      padding: 9px 18px;
      font-size: 0.88rem;
    }
  }

  @media screen and (max-width: 360px) {
    .search-page__input::placeholder {
      font-size: 0.78rem;
    }
    .search-page__submit-button {
      padding: 8px 14px;
      font-size: 0.82rem;
    }
  }

  /* Reusing the collection grid layout styling specifically for search pages */
  .collection-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }
  
  @media screen and (max-width: 1200px) {
    .collection-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  
  @media screen and (max-width: 900px) {
    .collection-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
  }
  
  @media screen and (max-width: 500px) {
    .collection-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
  }

  /* Search Page Pagination Styling */
  .collection-pagination {
    margin-top: 4rem;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
  }

  .collection-pagination span {
    background: #faf7f2;
    color: #333;
    border-radius: 4px;
    font-family: inherit;
    font-size: 1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    height: 40px;
    box-sizing: border-box;
  }

  .collection-pagination a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 1rem;
    color: inherit;
    text-decoration: none;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    white-space: nowrap;
  }

  .collection-pagination .current {
    background: #013F3E;
    color: #fff;
    padding: 0 1rem;
    box-sizing: border-box;
  }

  .collection-pagination .deco {
    color: #777;
    background: #faf7f2;
    padding: 0 0.5rem;
    box-sizing: border-box;
  }

  @media screen and (max-width: 900px) {
    .collection-pagination {
      margin-top: 2.5rem;
      gap: 4px;
      flex-wrap: nowrap;
      width: 100%;
      max-width: 100%;
      box-sizing: border-box;
      padding: 0;
    }

    .collection-pagination span {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      height: 34px;
      min-width: 26px;
      padding: 0 4px;
      box-sizing: border-box;
      background: #FAF7F2;
      color: #333333;
      border-radius: 4px;
      font-size: 12px;
      font-weight: 500;
      line-height: 1;
      text-align: center;
      flex-shrink: 0;
    }

    .collection-pagination a {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100%;
      padding: 0;
      margin: 0;
      background: transparent;
      color: inherit;
      text-decoration: none;
      border-radius: inherit;
      white-space: nowrap;
    }

    .collection-pagination .page.current,
    .collection-pagination .current {
      background: #013F3E;
      color: #FFFFFF;
      font-weight: 600;
      min-width: 26px;
      padding: 0 4px;
    }

    .collection-pagination .prev,
    .collection-pagination .next {
      min-width: 38px;
      padding: 0 6px;
      font-weight: 600;
      font-size: 11.5px;
    }

    .collection-pagination .deco {
      background: transparent;
      color: #888888;
      min-width: 12px;
      padding: 0 1px;
    }
  }

  @media screen and (max-width: 365px) {
    .collection-pagination {
      gap: 2px;
    }

    .collection-pagination span {
      min-width: 23px;
      height: 30px;
      font-size: 11px;
      padding: 0 2px;
    }

    .collection-pagination .page.current,
    .collection-pagination .current {
      min-width: 23px;
    }

    .collection-pagination .prev,
    .collection-pagination .next {
      min-width: 32px;
      padding: 0 4px;
      font-size: 10.5px;
    }

    .collection-pagination .deco {
      min-width: 8px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Search Results",
  "settings": []
}
{% endschema %}
