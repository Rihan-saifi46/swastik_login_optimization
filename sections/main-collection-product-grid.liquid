  .filter-checkbox input:checked ~ .filter-checkbox__box {
    background-color: #013F3E;
    border-color: #013F3E;
    box-shadow: 0 3px 8px rgba(1, 63, 62, 0.25);
  }
  
  .filter-checkbox input:checked ~ .filter-checkbox__box::after {
    content: '';
    position: absolute;
    left: 6px;
    top: 2px;
    width: 5px;
    height: 9px;
    border: solid #FFFFFF;
    border-width: 0 2.2px 2.2px 0;
