{%- assign active_min_price = null -%}
{%- assign active_max_price = null -%}
{%- for filter in collection.filters -%}
  {%- if filter.type == 'price_range' -%}
    {%- if filter.min_value.value -%}
      {%- assign active_min_price = filter.min_value.value | divided_by: 100.0 | floor -%}
    {%- endif -%}
    {%- if filter.max_value.value -%}
      {%- assign active_max_price = filter.max_value.value | divided_by: 100.0 | ceil -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}

{%- capture cfh -%}{{ content_for_header }}{%- endcapture -%}
{%- assign pageurl = cfh | split: '"pageurl":"' | last | split: '"' | first | replace: '\/', '/' | replace: '\u0026', '&' | replace: '%20', '+' -%}

{%- if active_min_price == null and pageurl contains 'filter.v.price.gte=' -%}
  {%- assign gte_part = pageurl | split: 'filter.v.price.gte=' | last | split: '&' | first | url_decode -%}
  {%- if gte_part != blank -%}
    {%- assign active_min_price = gte_part | plus: 0 -%}
  {%- endif -%}
{%- endif -%}
{%- if active_max_price == null and pageurl contains 'filter.v.price.lte=' -%}
  {%- assign lte_part = pageurl | split: 'filter.v.price.lte=' | last | split: '&' | first | url_decode -%}
  {%- if lte_part != blank -%}
    {%- assign active_max_price = lte_part | plus: 0 -%}
  {%- endif -%}
{%- endif -%}

{%- assign active_filter_count = 0 -%}
{%- for filter in collection.filters -%}
  {%- if filter.label == 'Gender' -%}
    {%- if collection.handle == 'everyday-sparkle' or collection.handle == 'close-to-heart' -%}
      {%- continue -%}
    {%- endif -%}
  {%- endif -%}
  {%- if filter.type == 'price_range' -%}
    {%- if filter.min_value.value or filter.max_value.value -%}
      {%- assign active_filter_count = active_filter_count | plus: 1 -%}
    {%- endif -%}
  {%- else -%}
    {%- assign active_filter_count = active_filter_count | plus: filter.active_values.size -%}
  {%- endif -%}
{%- endfor -%}

{%- if active_min_price or active_max_price -%}
  {%- assign has_native_price_filter = false -%}
  {%- for filter in collection.filters -%}
    {%- if filter.type == 'price_range' and filter.min_value.value or filter.max_value.value -%}
      {%- assign has_native_price_filter = true -%}
    {%- endif -%}
  {%- endfor -%}
  {%- unless has_native_price_filter -%}
    {%- assign active_filter_count = active_filter_count | plus: 1 -%}
  {%- endunless -%}
{%- endif -%}

<div class="collection-page" style="background-color: {{ section.settings.bg_color }};">
  
  <!-- Mobile Filter Overlay Backdrop -->
  <div class="collection-filters-overlay" id="CollectionFiltersOverlay"></div>

  <div style="--breadcrumb-max-width: 1600px; --breadcrumb-padding: 0 4rem; --breadcrumb-padding-mobile: 0 1.2rem;">
    {% render 'breadcrumb', collection: collection %}
  </div>

  <div class="collection-page__container">
    
    <!-- Sidebar Filters (Desktop Sidebar / Mobile Bottom Sheet) -->
    <aside class="collection-page__sidebar" id="CollectionPageSidebar">
      <div class="collection-filters">
        <div class="collection-filters__drag-handle"></div>
        <div class="collection-filters__header">
          <div class="collection-filters__header-title">
            <h3 class="collection-filters__title">FILTERS</h3>
            {% if active_filter_count > 0 %}
              <span class="collection-filters__badge">{{ active_filter_count }}</span>
            {% endif %}
          </div>
          <div class="collection-filters__header-actions">
            {% if active_filter_count > 0 %}
              <a href="{{ collection.url }}" class="collection-filters__clear">Clear All</a>
            {% endif %}
            <button type="button" class="collection-filters__close-btn" id="CollectionFiltersClose" aria-label="Close filters">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>
        </div>
        
        <form id="CollectionFiltersForm" class="collection-filters__form">
          <div class="collection-filters__body">
            <!-- Custom Tag Filter for Bonds -->
            {%- if collection.handle == 'all' or collection.handle == 'made-for-every-bond' or collection.all_tags contains 'For Mothers' or collection.all_tags contains 'For Sisters' or collection.all_tags contains 'For Brides' or collection.all_tags contains 'for-mothers' or collection.all_tags contains 'for-sisters' or collection.all_tags contains 'for-brides' -%}
              {%- assign bond_tags = "For Mothers, For Sisters, For Brides" | split: ", " -%}
              {%- assign showable_bond_count = 0 -%}
              {%- for bond_tag in bond_tags -%}
                {%- assign tag_handle = bond_tag | handleize -%}
                {%- for tag in collection.all_tags -%}
                  {%- assign t_handle = tag | handleize -%}
                  {%- if t_handle == tag_handle -%}
                    {%- assign showable_bond_count = showable_bond_count | plus: 1 -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endfor -%}

              {%- if collection.handle == 'all' or showable_bond_count > 1 or current_tags.size > 0 -%}
                <div class="filter-group">
                  <details class="filter-group__details" open>
                    <summary class="filter-group__summary">
                      <span class="filter-group__name">Shop by Bond</span>
                      <svg class="icon-caret" width="12" height="7" viewBox="0 0 12 7" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M1 1L6 6L11 1" stroke="#D4AF37" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </summary>
                    <div class="filter-group__display">
                      <ul class="filter-group__list">
                        {%- assign has_any_active_bond = false -%}
                        {%- for active_tag in current_tags -%}
                          {%- assign active_tag_h = active_tag | handleize -%}
                          {%- if active_tag_h == 'for-mothers' or active_tag_h == 'for-sisters' or active_tag_h == 'for-brides' -%}
                            {%- assign has_any_active_bond = true -%}
                            {%- break -%}
                          {%- endif -%}
                        {%- endfor -%}
                        {%- for bond_tag in bond_tags -%}
                          {%- assign tag_handle = bond_tag | handleize -%}
                          {%- assign show_bond_tag = false -%}
                          {%- if has_any_active_bond -%}
                            {%- if current_tags contains bond_tag or current_tags contains tag_handle -%}
                              {%- assign show_bond_tag = true -%}
                            {%- endif -%}
                          {%- else -%}
                            {%- if collection.handle == 'all' -%}
                              {%- assign show_bond_tag = true -%}
                            {%- else -%}
                              {%- for tag in collection.all_tags -%}
                                {%- assign t_handle = tag | handleize -%}
                                {%- if t_handle == tag_handle -%}
                                  {%- assign show_bond_tag = true -%}
                                  {%- break -%}
                                {%- endif -%}
                              {%- endfor -%}
                            {%- endif -%}
                          {%- endif -%}

                          {%- if show_bond_tag -%}
                            <li class="filter-group__list-item">
                              {%- if current_tags contains bond_tag or current_tags contains tag_handle -%}
                                <a href="{{ '' | link_to_remove_tag: bond_tag | split: 'href="' | last | split: '"' | first }}" class="filter-checkbox is-active-tag">
                                  <span class="filter-checkbox__box"></span>
                                  <span class="filter-checkbox__label">{{ bond_tag }}</span>
                                </a>
                              {%- else -%}
                                <a href="{{ bond_tag | link_to_add_tag: bond_tag | split: 'href="' | last | split: '"' | first }}" class="filter-checkbox">
                                  <span class="filter-checkbox__box"></span>
                                  <span class="filter-checkbox__label">{{ bond_tag }}</span>
                                </a>
                              {%- endif -%}
                            </li>
                          {%- endif -%}
                        {%- endfor -%}
                      </ul>
                    </div>
                  </details>
                </div>
            {%- endif -%}
          {%- endif -%}

            {%- assign has_price_filter_in_loop = false -%}
            {%- for filter in collection.filters -%}
              {%- if filter.type == 'price_range' -%}
                {%- assign has_price_filter_in_loop = true -%}
              {%- endif -%}
              {%- if filter.label == 'Gender' -%}
                {%- if collection.handle == 'everyday-sparkle' or collection.handle == 'close-to-heart' -%}
                  {%- continue -%}
                {%- endif -%}
              {%- endif -%}
              {%- assign show_filter_group = false -%}
              {%- assign valid_values_count = 0 -%}
              
              {%- if filter.type == 'boolean' or filter.type == 'list' -%}
                {%- for filter_value in filter.values -%}
                  {%- assign valid_values_count = valid_values_count | plus: 1 -%}
                {%- endfor -%}
              {%- else -%}
                {%- assign show_filter_group = true -%}
              {%- endif -%}

              {%- if valid_values_count > 0 -%}
                {%- assign show_filter_group = true -%}
              {%- endif -%}

              {%- if show_filter_group -%}
                <div class="filter-group filter-group--{{ filter.type }}">
                  <details class="filter-group__details" open>
                    <summary class="filter-group__summary">
                      <span class="filter-group__name">{% if filter.type == 'price_range' %}PRICE{% else %}{{ filter.label }}{% endif %}</span>
                      <svg class="icon-caret" width="12" height="7" viewBox="0 0 12 7" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M1 1L6 6L11 1" stroke="#D4AF37" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </summary>
                    
                    <div class="filter-group__display">
                      {%- case filter.type -%}
                        {%- when 'boolean' or 'list' -%}
                          <ul class="filter-group__list">
                            {%- for filter_value in filter.values -%}
                              <li class="filter-group__list-item">
                                <label for="Filter-{{ filter.param_name }}-{{ forloop.index }}" class="filter-checkbox">
                                  <input type="checkbox" 
                                    name="{{ filter_value.param_name }}"
                                    value="{{ filter_value.value }}"
                                    id="Filter-{{ filter.param_name }}-{{ forloop.index }}"
                                    {% if filter_value.active -%}checked{%- endif %}>
                                  <span class="filter-checkbox__box"></span>
                                  <span class="filter-checkbox__label">{{ filter_value.label }}</span>
                                </label>
                              </li>
                            {%- endfor -%}
                          </ul>
                          
                        {%- when 'price_range' -%}
                          <div class="filter-group__price-inputs">
                            <div class="price-inputs-row">
                              <div class="price-input-field">
                                <span class="price-input-currency">{{ cart.currency.symbol | default: '₹' }}</span>
                                <input 
                                  type="number" 
                                  name="{{ filter.min_value.param_name | default: 'filter.v.price.gte' }}" 
                                  id="PriceFilterMin" 
                                  class="price-input" 
                                  placeholder="Min price" 
                                  min="0" 
                                  step="1"
                                  value="{{ active_min_price }}"
                                  aria-label="Minimum price"
                                >
                              </div>
                              <span class="price-input-divider">-</span>
                              <div class="price-input-field">
                                <span class="price-input-currency">{{ cart.currency.symbol | default: '₹' }}</span>
                                <input 
                                  type="number" 
                                  name="{{ filter.max_value.param_name | default: 'filter.v.price.lte' }}" 
                                  id="PriceFilterMax" 
                                  class="price-input" 
                                  placeholder="Max price" 
                                  min="0" 
                                  step="1"
                                  value="{{ active_max_price }}"
                                  aria-label="Maximum price"
                                >
                              </div>
                            </div>
                            <button type="submit" class="price-filter-apply-btn">
                              Apply
                            </button>
                          </div>
                      {%- endcase -%}
                    </div>
                  </details>
                </div>
              {%- endif -%}
            {%- endfor -%}

            {%- unless has_price_filter_in_loop -%}
              <!-- Dedicated PRICE Filter Section -->
              <div class="filter-group filter-group--price">
                <details class="filter-group__details" open>
                  <summary class="filter-group__summary">
                    <span class="filter-group__name">PRICE</span>
                    <svg class="icon-caret" width="12" height="7" viewBox="0 0 12 7" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M1 1L6 6L11 1" stroke="#D4AF37" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </summary>
                  
                  <div class="filter-group__display">
                    <div class="filter-group__price-inputs">
                      <div class="price-inputs-row">
                        <div class="price-input-field">
                          <span class="price-input-currency">{{ cart.currency.symbol | default: '₹' }}</span>
                          <input 
                            type="number" 
                            name="filter.v.price.gte" 
                            id="PriceFilterMinStandalone" 
                            class="price-input" 
                            placeholder="Min price" 
                            min="0" 
                            step="1"
                            value="{{ active_min_price }}"
                            aria-label="Minimum price"
                          >
                        </div>
                        <span class="price-input-divider">-</span>
                        <div class="price-input-field">
                          <span class="price-input-currency">{{ cart.currency.symbol | default: '₹' }}</span>
                          <input 
                            type="number" 
                            name="filter.v.price.lte" 
                            id="PriceFilterMaxStandalone" 
                            class="price-input" 
                            placeholder="Max price" 
                            min="0" 
                            step="1"
                            value="{{ active_max_price }}"
                            aria-label="Maximum price"
                          >
                        </div>
                      </div>
                      <button type="submit" class="price-filter-apply-btn">
                        Apply
                      </button>
                    </div>
                  </div>
                </details>
              </div>
            {%- endunless -%}
          </div>
          
          {%- if collection.sort_by -%}
            <input type="hidden" name="sort_by" value="{{ collection.sort_by }}">
          {%- endif -%}

          <div class="collection-filters__footer">
            <a href="{{ collection.url }}" class="collection-filters__reset-btn">Reset</a>
            <button type="submit" class="collection-filters__apply-btn">
              Apply Filters{% if active_filter_count > 0 %} ({{ active_filter_count }}){% endif %}
            </button>
          </div>
        </form>
      </div>
    </aside>
    
    <!-- Main Content -->
    <main class="collection-page__main">
      
      <!-- Mobile Bar (Shown on Mobile <= 900px) -->
      <div class="mobile-collection-bar">
        <button type="button" class="mobile-collection-bar__btn js-open-mobile-filters" id="MobileFilterToggle">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
          </svg>
          <span>FILTERS</span>
          {% if active_filter_count > 0 %}
            <span class="mobile-filter-count-badge">{{ active_filter_count }}</span>
          {% endif %}
        </button>
        

      </div>

      <!-- Active Filters Chips -->
      {% if active_filter_count > 0 %}
        <div class="active-filters-chips">
          {% for filter in collection.filters %}
            {%- if filter.label == 'Gender' -%}
              {%- if collection.handle == 'everyday-sparkle' or collection.handle == 'close-to-heart' -%}
                {%- continue -%}
              {%- endif -%}
            {%- endif -%}
            {% for filter_value in filter.active_values %}
              <a href="{{ filter_value.url_to_remove }}" class="active-filter-chip">
                <span>{{ filter_value.label }}</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </a>
            {% endfor %}
            {% if filter.type == 'price_range' %}
              {% if filter.min_value.value or filter.max_value.value %}
                <a href="{{ filter.url_to_remove }}" class="active-filter-chip">
                  <span>Price: {{ filter.min_value.value | default: 0 | money }} - {{ filter.max_value.value | default: filter.range_max | money }}</span>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </a>
              {% endif %}
            {% endif %}
          {% endfor %}

          {% if active_min_price or active_max_price %}
            {%- assign has_native_price_chip = false -%}
            {%- for filter in collection.filters -%}
              {%- if filter.type == 'price_range' and filter.min_value.value or filter.max_value.value -%}
                {%- assign has_native_price_chip = true -%}
              {%- endif -%}
            {%- endfor -%}
            {%- unless has_native_price_chip -%}
              <a href="#" class="active-filter-chip js-remove-price-chip" data-remove-price="true">
                <span>Price: 
                  {% if active_min_price and active_max_price %}
                    {{ cart.currency.symbol | default: '₹' }}{{ active_min_price | round }} - {{ cart.currency.symbol | default: '₹' }}{{ active_max_price | round }}
                  {% elsif active_min_price %}
                    &ge; {{ cart.currency.symbol | default: '₹' }}{{ active_min_price | round }}
                  {% elsif active_max_price %}
                    &le; {{ cart.currency.symbol | default: '₹' }}{{ active_max_price | round }}
                  {% endif %}
                </span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </a>
            {%- endunless -%}
          {% endif %}
          <a href="{{ collection.url }}" class="active-filter-chip active-filter-chip--clear-all">Clear All</a>
        </div>
      {% endif %}

      <!-- Standard Desktop Toolbar -->
      <div class="collection-toolbar">
        <div class="collection-toolbar__count">
          All Products ({{ collection.products_count }})
        </div>
        

      </div>
      
      {% paginate collection.products by 24 %}
        <div class="collection-grid">
          {%- assign rendered_product_count = 0 -%}
          {%- for product in collection.products -%}
            {%- assign current_card_variant = product.selected_or_first_available_variant -%}
            {%- assign prod_selling_price = current_card_variant.price | default: product.price | divided_by: 100.0 -%}
            {%- if active_min_price and prod_selling_price < active_min_price -%}
              {%- continue -%}
            {%- endif -%}
            {%- if active_max_price and prod_selling_price > active_max_price -%}
              {%- continue -%}
            {%- endif -%}
            {%- assign rendered_product_count = rendered_product_count | plus: 1 -%}
            {% render 'product-card', product: product, class_prefix: 'best-sellers' %}
          {%- endfor -%}

          {%- if rendered_product_count == 0 -%}
            {%- if section.settings.show_coming_soon -%}
              {{ 'component-product-card.css' | asset_url | stylesheet_tag }}
              {%- for i in (1..8) -%}
                <div class="product-card-ui" style="pointer-events: none; opacity: 0.85;">
                  <div class="product-card-ui__image-wrapper" style="position: relative;">
                    <div style="position: absolute; background-color: #013F3E; color: #fff; padding: 6px 14px; border-radius: 20px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; z-index: 2; font-family: 'Inter', sans-serif; font-size: 0.75rem; box-shadow: 0 4px 10px rgba(1, 63, 62, 0.2);">COMING SOON</div>
                    <div style="opacity: 0.04; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;">
                      <svg xmlns="http://www.w3.org/2000/svg" width="160" height="160" viewBox="0 0 24 24" fill="none" stroke="#013F3E" stroke-width="0.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M6 3h12l4 6-10 13L2 9Z"></path>
                        <path d="M11 3 8 9l4 13"></path>
                        <path d="M12 15V3"></path>
                      </svg>
                    </div>
                  </div>
                  <div class="product-card-ui__content" style="align-items: center; justify-content: center; text-align: center;">
                    <h3 class="product-card-ui__title" style="color: #013F3E; font-family: 'Inter', serif;">{{ section.settings.coming_soon_text | default: 'New Design' }}</h3>
                    <div class="product-card-ui__price-row" style="justify-content: center;">
                      <span class="price-current" style="color: #7B6A58; font-size: 14px; text-transform: uppercase; letter-spacing: 1px;">Launching Soon</span>
                    </div>
                  </div>
                </div>
              {%- endfor -%}
            {%- else -%}
              <div class="collection-grid__empty">
                <p>No products found matching your filters.</p>
                <a href="{{ collection.url }}" class="btn">Clear Filters</a>
              </div>
            {%- endif -%}
          {%- endif -%}
        </div>
        
        {%- if paginate.pages > 1 -%}
          <div class="collection-pagination">
            {{ paginate | default_pagination: next: 'Next', previous: 'Prev' }}
          </div>
        {%- endif -%}
      {% endpaginate %}
    </main>
  </div>
</div>

{% stylesheet %}
  .collection-page {
    padding: 3rem 0 5rem;
    font-family: 'Inter', sans-serif;
  }
  
  .collection-page__container {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 4rem;
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 4rem;
    align-items: start;
  }
  
  /* Sidebar Styles */
  .collection-filters {
    background-color: #fcf9f5;
    border-radius: 12px;
    padding: 1.5rem;
    border: 1px solid rgba(1, 63, 62, 0.08);
  }
  
  .collection-filters__drag-handle {
    display: none;
  }

  .collection-filters__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #F0EAE1;
  }
  
  .collection-filters__header-title {
    display: flex;
    align-items: center;
  }

  .collection-filters__title {
    font-size: 1.25rem;
    font-weight: 600;
    font-family: 'Cormorant Garamond', 'Montserrat', serif;
    margin: 0;
    letter-spacing: 0.08em;
    color: #013F3E;
    text-transform: uppercase;
  }

  .collection-filters__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #013F3E 0%, #025553 100%);
    color: #D4AF37;
    font-size: 0.75rem;
    font-weight: 700;
    border-radius: 20px;
    padding: 2px 10px;
    margin-left: 10px;
    border: 1px solid rgba(212, 175, 55, 0.4);
  }
  
  .collection-filters__header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .collection-filters__clear {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    color: #013F3E;
    text-decoration: underline;
    letter-spacing: 0.04em;
  }

  .collection-filters__close-btn {
    display: none;
    background: #FAF4F0;
    border: 1px solid #EAE0D5;
    border-radius: 50%;
    width: 34px;
    height: 34px;
    color: #013F3E;
    cursor: pointer;
    padding: 0;
    align-items: center;
    justify-content: center;
    transition: all 0.25s ease;
  }
  .collection-filters__close-btn:hover {
    background-color: #013F3E;
    color: #FFFFFF;
    border-color: #013F3E;
  }

  .collection-filters__footer {
    display: none;
  }
  
  .filter-group {
    border-bottom: 1px solid #F3EDE6;
  }
  .filter-group:last-child {
    border-bottom: none;
  }
  
  .filter-group__summary {
    display: flex;
