{% javascript %}
  class CollectionFilters {
    constructor() {
      this.sectionId = 'main-collection-product-grid';
      this.bindEvents();
      this.initSliders();
    }

    bindEvents() {
      this.debouncedSubmit = this.debounce((e, form) => this.onSubmit(e, form), 500);

      document.addEventListener('change', (e) => {
        const form = e.target.closest('#CollectionFiltersForm');
        if (form) {
          if (e.target.type === 'range' || e.target.classList.contains('price-input')) return;
          this.onSubmit(e, form);
        }
      });

      document.addEventListener('submit', (e) => {
        const form = e.target.closest('#CollectionFiltersForm');
        if (form) {
          this.onSubmit(e, form);
        }
      });

      document.addEventListener('click', (e) => {
        if (e.target.closest('#MobileFilterToggle')) {
          this.openFilters();
        }
        if (e.target.closest('#CollectionFiltersClose') || e.target.closest('#CollectionFiltersOverlay')) {
          this.closeFilters();
        }

        const removePriceChip = e.target.closest('.js-remove-price-chip');
        if (removePriceChip) {
          e.preventDefault();
          const currentUrl = new URL(window.location.href);
          currentUrl.searchParams.delete('filter.v.price.gte');
          currentUrl.searchParams.delete('filter.v.price.lte');
          const finalUrl = `${currentUrl.pathname}${currentUrl.search ? currentUrl.search : ''}`;
          this.renderPage(finalUrl);
          return;
        }

        const link = e.target.closest('a');
        if (link && link.closest('.collection-page')) {
          const isFilterLink = link.classList.contains('filter-checkbox') || 
                               link.classList.contains('active-filter-chip') ||
                               link.classList.contains('collection-filters__clear') ||
                               link.classList.contains('collection-filters__reset-btn') ||
                               link.closest('.collection-pagination');
          if (isFilterLink) {
            e.preventDefault();
            this.renderPage(link.href);
          }
        }
      });

      window.addEventListener('popstate', (e) => {
        const url = e.state ? e.state.url : window.location.href;
        this.renderPage(url, false);
      });
    }

    onSubmit(e, form = null) {
      if (e) e.preventDefault();
      form = form || (e.target ? e.target.closest('form') : null);
      if (!form) return;

      const minInput = form.querySelector('input[name*="price.gte"], #PriceFilterMin, #PriceFilterMinStandalone');
      const maxInput = form.querySelector('input[name*="price.lte"], #PriceFilterMax, #PriceFilterMaxStandalone');

      if (minInput && maxInput) {
        let minRaw = minInput.value ? minInput.value.toString().replace(/[^0-9.]/g, '') : '';
        let maxRaw = maxInput.value ? maxInput.value.toString().replace(/[^0-9.]/g, '') : '';
        let minVal = parseFloat(minRaw);
        let maxVal = parseFloat(maxRaw);

        if (!isNaN(minVal) && minVal < 0) minVal = 0;
        if (!isNaN(maxVal) && maxVal < 0) maxVal = 0;

        if (!isNaN(minVal) && !isNaN(maxVal) && minVal > maxVal) {
          const temp = minVal;
          minVal = maxVal;
          maxVal = temp;
        }

        minInput.value = !isNaN(minVal) && minVal > 0 ? minVal : '';
        maxInput.value = !isNaN(maxVal) && maxVal > 0 ? maxVal : '';
      }

      const formData = new FormData(form);
      const searchParams = new URLSearchParams(formData);

      for (const [key, value] of Array.from(searchParams.entries())) {
        if (!value || value.trim() === '') searchParams.delete(key);
      }

      const url = `${window.location.pathname}${searchParams.toString() ? '?' + searchParams.toString() : ''}`;
      this.renderPage(url);
    }

    async renderPage(url, pushState = true) {
      const mainArea = document.querySelector('.collection-page__main');
      if (mainArea) mainArea.style.opacity = '0.5';
      this.closeFilters();

      try {
        const fetchUrl = url.includes('?') ? `${url}&section_id=${this.sectionId}` : `${url}?section_id=${this.sectionId}`;
        const response = await fetch(fetchUrl);
        const html = await response.text();
        
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');
        
        const newContainer = doc.querySelector('.collection-page__container');
        const currentContainer = document.querySelector('.collection-page__container');
        
        if (newContainer && currentContainer) {
          currentContainer.innerHTML = newContainer.innerHTML;
          
          if (pushState) {
            window.history.pushState({ url: url }, '', url);
          }
          
          this.initSliders();
          if (window.updateWishlistBadge && typeof wishlist !== 'undefined') {
            document.querySelectorAll('.collection-page__container [data-product-id]').forEach(card => {
              const id = card.getAttribute('data-product-id');
              if (wishlist.includes(id)) {
                const heart = card.querySelector('.best-sellers__wishlist-btn, .new-arrivals__wishlist-btn, .product-single__wishlist-btn, .product-card-ui__wishlist');
                if (heart) heart.classList.add('active');
              }
            });
          }
        }
      } catch (error) {
        console.error('Error fetching collection page:', error);
        window.location.href = url;
      } finally {
        const newMainArea = document.querySelector('.collection-page__main');
        if (newMainArea) newMainArea.style.opacity = '1';
      }
    }

    openFilters() {
      const filterSidebar = document.getElementById('CollectionPageSidebar');
      const filterOverlay = document.getElementById('CollectionFiltersOverlay');
      if (filterSidebar && filterOverlay) {
        filterSidebar.classList.add('open');
        filterOverlay.classList.add('open');
        document.body.style.overflow = 'hidden';
      }
    }

    closeFilters() {
      const filterSidebar = document.getElementById('CollectionPageSidebar');
      const filterOverlay = document.getElementById('CollectionFiltersOverlay');
      if (filterSidebar && filterOverlay) {
        filterSidebar.classList.remove('open');
        filterOverlay.classList.remove('open');
        document.body.style.overflow = '';
      }
    }

    initSliders() {
      const minSliders = document.querySelectorAll('.price-slider__range--min');
      const maxSliders = document.querySelectorAll('.price-slider__range--max');

      minSliders.forEach((minSlider, index) => {
        const maxSlider = maxSliders[index];
        if (!maxSlider) return;
        const track = minSlider.parentElement.querySelector('.price-slider__track');
        const minLabel = minSlider.parentElement.nextElementSibling.querySelector('span[id^="label-min"]');
        const maxLabel = minSlider.parentElement.nextElementSibling.querySelector('span[id^="label-max"]');
        const hiddenMin = minSlider.parentElement.parentElement.querySelector('input[name*="gte"]');
        const hiddenMax = minSlider.parentElement.parentElement.querySelector('input[name*="lte"]');

        const updateSlider = () => {
          let minVal = parseInt(minSlider.value);
          let maxVal = parseInt(maxSlider.value);

          if (minVal > maxVal) {
            if (document.activeElement === minSlider) {
              minVal = maxVal;
              minSlider.value = minVal;
            } else {
              maxVal = minVal;
              maxSlider.value = maxVal;
            }
          }

          const parentText = minLabel && minLabel.parentElement ? minLabel.parentElement.textContent : '';
          const activeLocale = parentText.includes('₹') ? 'en-IN' : 'en-US'; 
          if (minLabel) minLabel.textContent = minVal.toLocaleString(activeLocale);
          if (maxLabel) maxLabel.textContent = maxVal.toLocaleString(activeLocale);
          
          const maxTotal = parseInt(minSlider.max) || 1;

          if (hiddenMin) {
            hiddenMin.value = minVal;
            hiddenMin.disabled = (minVal <= 0);
          }
          if (hiddenMax) {
            hiddenMax.value = maxVal;
            hiddenMax.disabled = (maxVal >= maxTotal);
          }

          const percentMin = (minVal / maxTotal) * 100;
          const percentMax = (maxVal / maxTotal) * 100;
          
          if (track) {
            track.style.left = percentMin + "%";
            track.style.width = (percentMax - percentMin) + "%";
          }
        };

        minSlider.addEventListener('input', updateSlider);
        maxSlider.addEventListener('input', updateSlider);
        
        updateSlider();
      });
    }

    debounce(fn, wait) {
      let t;
      return (...args) => {
        clearTimeout(t);
        t = setTimeout(() => fn.apply(this, args), wait);
      };
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    new CollectionFilters();
  });
{% endjavascript %}
