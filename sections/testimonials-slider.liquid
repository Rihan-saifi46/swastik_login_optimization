{%- liquid
  assign bg_color = section.settings.bg_color | default: '#fdfbf7'
  assign text_color = section.settings.text_color | default: '#0a2a26'
  assign accent_color = section.settings.accent_color | default: '#b38245'
-%}

<div class="testimonials-v2 section-spacing" id="TestimonialsSlider-{{ section.id }}" style="
  --bg-color: {{ bg_color }};
  --text-color: {{ text_color }};
  --accent-color: {{ accent_color }};
  --padding-top: {{ section.settings.padding_top | default: 40 }}px;
  --padding-bottom: {{ section.settings.padding_bottom | default: 40 }}px;
" data-autoplay="{{ section.settings.autoplay }}" data-autoplay-speed="{{ section.settings.autoplay_speed }}">
  <div class="testimonials-v2__container {% if section.settings.layout_style == 'centered' %}testimonials-v2__container--centered{% endif %}">
    
    {%- if section.settings.layout_style == 'centered' -%}
      <!-- Centered Header Layout matching the design -->
      <div class="testimonials-v2__header-centered">
        {%- if section.settings.subheading != blank -%}
          <div class="testimonials-v2__subheading-wrapper">
            <span class="testimonials-v2__line"></span>
            <span class="testimonials-v2__subheading">{{ section.settings.subheading | escape }}</span>
            <span class="testimonials-v2__line"></span>
          </div>
        {%- endif -%}



        {%- if section.settings.title != blank -%}
          <h2 class="testimonials-v2__heading-centered serif-font">
            {{ section.settings.title | escape }}
          </h2>
        {%- endif -%}

        {%- if section.settings.trust_copy != blank -%}
          <p class="testimonials-v2__description-centered">
            {{ section.settings.trust_copy | replace: 'Swastik Jewels', '<span class="text-gold">Swastik Jewels</span>' }}
          </p>
        {%- endif -%}
      </div>

      <!-- Slider block (Centered Layout) -->
      {% capture testimonials_cards %}
        {%- for block in section.blocks -%}
          <div class="testimonials-v2__card-wrapper" data-slide-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <div class="testimonials-v2__card">
              <div class="testimonials-v2__card-header">
                <div class="testimonials-v2__quote-icon">
                  <svg viewBox="0 0 24 20" fill="currentColor">
                    <path d="M5.5 20c-1.8 0-3.3-.7-4.5-2C.3 16.7 0 15 0 13c0-2.8 1-5.6 3.1-8.3C5.2 2 8 0 11.5 0v3.5C9.2 4.7 7.7 6.2 7 8c1.3.2 2.3.8 3 1.8.8 1 1.2 2.3 1.2 3.7 0 1.8-.6 3.3-1.8 4.5S6.8 20 5.5 20zm12 0c-1.8 0-3.3-.7-4.5-2-1.2-1.3-1.8-3-1.8-5 0-2.8 1-5.6 3.1-8.3C17.2 2 20 0 23.5 0v3.5c-2.3 1.2-3.8 2.7-4.5 4.5 1.3.2 2.3.8 3 1.8.8 1 1.2 2.3 1.2 3.7 0 1.8-.6 3.3-1.8 4.5s-2.6 2-3.9 2z"/>
                  </svg>
                </div>
                {%- if block.settings.rating > 0 -%}
                  <div class="testimonials-v2__rating" aria-label="{{ block.settings.rating }} out of 5 stars">
                    {%- for i in (1..5) -%}
                      {%- if i <= block.settings.rating -%}
                        <svg class="star star--filled" viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                      {%- else -%}
                        <svg class="star star--empty" viewBox="0 0 24 24" fill="currentColor" opacity="0.2"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              </div>
              
              <blockquote class="testimonials-v2__text">
                <p>{{ block.settings.text | escape }}</p>
              </blockquote>
              
              <div class="testimonials-v2__meta">
                <div class="testimonials-v2__author-row">
                  <span class="testimonials-v2__author">- {{ block.settings.author | escape }}</span>
                </div>
                <div class="testimonials-v2__location-row">
                  <span class="testimonials-v2__verify">
                    <svg class="testimonials-v2__verify-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                    </svg>
                    VERIFIED
                  </span>
                  <span class="testimonials-v2__location-dot">&bull;</span>
                  <span class="testimonials-v2__location">{{ block.settings.location | escape | upcase }}</span>
                </div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {% endcapture %}

      <div class="testimonials-v2__slider-viewport" data-slider-viewport>
        <div class="testimonials-v2__slider-track" data-slider-track>
          <div class="testimonials-v2__marquee-content">
            {{ testimonials_cards }}
          </div>
          <div class="testimonials-v2__marquee-content" aria-hidden="true">
            {{ testimonials_cards }}
          </div>
        </div>
      </div>

    {%- else -%}
      <!-- Original Split Layout -->
      <div class="testimonials-v2__left">
        {%- if section.settings.show_rating_badge -%}
          <div class="testimonials-v2__rating-badge">
            <div class="testimonials-v2__rating-stars">
              {%- for i in (1..5) -%}
                <svg class="star star--filled" viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
              {%- endfor -%}
            </div>
            {%- if section.settings.rating_badge_text != blank -%}
              <span class="testimonials-v2__rating-score">{{ section.settings.rating_badge_text }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <div class="testimonials-v2__subheading">{{ section.settings.subheading | escape }}</div>
        {%- endif -%}
        
        {%- if section.settings.title != blank -%}
          <h2 class="testimonials-v2__heading serif-font">
            {%- assign title_lines = section.settings.title | newline_to_br | split: '<br />' -%}
            {%- for line in title_lines -%}
              {%- assign stripped_line = line | strip -%}
              {%- if stripped_line contains '+' or stripped_line contains '0' or stripped_line contains '1' or stripped_line contains '2' or stripped_line contains '3' or stripped_line contains '4' or stripped_line contains '5' or stripped_line contains '6' or stripped_line contains '7' or stripped_line contains '8' or stripped_line contains '9' -%}
                <span class="testimonials-v2__heading-highlight">{{ stripped_line }}</span>
              {%- else -%}
                <span class="testimonials-v2__heading-line">{{ stripped_line }}</span>
              {%- endif -%}
            {%- endfor -%}
          </h2>
        {%- endif -%}

        {%- if section.settings.trust_copy != blank -%}
          <div class="testimonials-v2__trust-copy">
            <span class="testimonials-v2__trust-text">{{ section.settings.trust_copy | newline_to_br }}</span>
          </div>
        {%- endif -%}

        <div class="testimonials-v2__divider"></div>

        <div class="testimonials-v2__stats">
          {%- if section.settings.stat_1_value != blank -%}
            <div class="testimonials-v2__stat">
              <div class="testimonials-v2__stat-value">{{ section.settings.stat_1_value }}</div>
              <div class="testimonials-v2__stat-label">{{ section.settings.stat_1_label }}</div>
            </div>
          {%- endif -%}
          
          {%- if section.settings.stat_2_value != blank -%}
            <div class="testimonials-v2__stat">
              <div class="testimonials-v2__stat-value">{{ section.settings.stat_2_value }}</div>
              <div class="testimonials-v2__stat-label">{{ section.settings.stat_2_label }}</div>
            </div>
          {%- endif -%}
          
          {%- if section.settings.stat_3_value != blank -%}
            <div class="testimonials-v2__stat">
              <div class="testimonials-v2__stat-value">{{ section.settings.stat_3_value }}</div>
              <div class="testimonials-v2__stat-label">{{ section.settings.stat_3_label }}</div>
            </div>
          {%- endif -%}

          {%- if section.settings.stat_4_value != blank -%}
            <div class="testimonials-v2__stat">
              <div class="testimonials-v2__stat-value">{{ section.settings.stat_4_value }}</div>
              <div class="testimonials-v2__stat-label">{{ section.settings.stat_4_label }}</div>
            </div>
          {%- endif -%}
        </div>
      </div>

      <div class="testimonials-v2__right">
        <div class="testimonials-v2__slider-viewport" data-slider-viewport>
          <div class="testimonials-v2__slider-track" data-slider-track>
            {%- for block in section.blocks -%}
              <div class="testimonials-v2__card-wrapper" data-slide-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
                <div class="testimonials-v2__card">
                  <div class="testimonials-v2__card-header">
                    <div class="testimonials-v2__quote-icon">
                      <svg viewBox="0 0 24 20" fill="currentColor">
                        <path d="M5.5 20c-1.8 0-3.3-.7-4.5-2C.3 16.7 0 15 0 13c0-2.8 1-5.6 3.1-8.3C5.2 2 8 0 11.5 0v3.5C9.2 4.7 7.7 6.2 7 8c1.3.2 2.3.8 3 1.8.8 1 1.2 2.3 1.2 3.7 0 1.8-.6 3.3-1.8 4.5S6.8 20 5.5 20zm12 0c-1.8 0-3.3-.7-4.5-2-1.2-1.3-1.8-3-1.8-5 0-2.8 1-5.6 3.1-8.3C17.2 2 20 0 23.5 0v3.5c-2.3 1.2-3.8 2.7-4.5 4.5 1.3.2 2.3.8 3 1.8.8 1 1.2 2.3 1.2 3.7 0 1.8-.6 3.3-1.8 4.5s-2.6 2-3.9 2z"/>
                      </svg>
                    </div>
                    {%- if block.settings.rating > 0 -%}
                      <div class="testimonials-v2__rating" aria-label="{{ block.settings.rating }} out of 5 stars">
                        {%- for i in (1..5) -%}
                          {%- if i <= block.settings.rating -%}
                            <svg class="star star--filled" viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                          {%- else -%}
                            <svg class="star star--empty" viewBox="0 0 24 24" fill="currentColor" opacity="0.2"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    {%- endif -%}
                  </div>
                  
                  <blockquote class="testimonials-v2__text">
                    <p>{{ block.settings.text | escape }}</p>
                  </blockquote>
                  
                  <div class="testimonials-v2__meta">
                    <div class="testimonials-v2__author-row">
                      <span class="testimonials-v2__author">- {{ block.settings.author | escape }}</span>
                    </div>
                    <div class="testimonials-v2__location-row">
                      <span class="testimonials-v2__verify">
                        <svg class="testimonials-v2__verify-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                        </svg>
                        VERIFIED
                      </span>
                      <span class="testimonials-v2__location-dot">&bull;</span>
                      <span class="testimonials-v2__location">{{ block.settings.location | escape | upcase }}</span>
                    </div>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    {%- endif -%}

  </div>


</div>

{% stylesheet %}
.testimonials-v2 {
  background-color: var(--bg-color, #fdfbf7);
  padding-top: var(--padding-top, 40px);
  padding-bottom: var(--padding-bottom, 40px);
  overflow: hidden;
}

.testimonials-v2__container {
  max-width: 1400px;
  margin: 0 auto;
  display: flex;
  gap: 3.5rem;
  padding-left: 4.8rem;
  padding-right: 2rem;
  align-items: center;
}

.testimonials-v2__left {
  flex: 0 0 300px;
  max-width: 330px;
  padding-right: 0;
  display: flex;
  flex-direction: column;
}

.testimonials-v2__rating-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.8rem;
  margin-bottom: 2rem;
}

.testimonials-v2__rating-stars {
  display: flex;
  gap: 3px;
}

.testimonials-v2__rating-stars .star {
  width: 14px;
  height: 14px;
  color: var(--accent-color, #b38245);
}

.testimonials-v2__rating-score {
  font-family: 'Montserrat', sans-serif;
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--text-color, #0a2a26);
  letter-spacing: 0.02em;
}

.testimonials-v2__subheading {
  font-family: 'Montserrat', sans-serif;
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--text-color, #0a2a26);
  text-transform: uppercase;
  letter-spacing: 0.2em;
  margin-bottom: 1.6rem;
  opacity: 0.75;
}

.testimonials-v2__heading {
  font-size: 3.4rem;
  color: var(--text-color, #0a2a26);
  margin: 0 0 2rem 0;
  font-weight: 400;
  line-height: 1.15;
  display: flex;
  flex-direction: column;
}

.testimonials-v2__heading-line {
  display: block;
}

.testimonials-v2__heading-highlight {
  display: block;
  font-size: 5.2rem;
  font-weight: 500;
  color: var(--text-color, #0a2a26);
  line-height: 1.05;
  margin: 0.2rem 0;
}

.testimonials-v2__trust-copy {
  display: inline-flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.5rem;
  font-family: 'Montserrat', sans-serif;
  font-size: 1.35rem;
  font-weight: 600;
  color: var(--text-color, #0a2a26);
  opacity: 0.8;
  line-height: 1.45;
  margin-bottom: 2rem;
}

.testimonials-v2__heart-icon {
  width: 15px;
  height: 15px;
  color: var(--accent-color, #b38245);
  display: inline-block;
  vertical-align: middle;
  flex-shrink: 0;
}

.testimonials-v2__divider {
  height: 2px;
  background-color: var(--accent-color, #b38245);
  width: 70px;
  margin-bottom: 3rem;
}

.testimonials-v2__stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2.5rem 2rem;
}

.testimonials-v2__stat {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  text-align: left;
}

.testimonials-v2__stat-icon {
  width: 32px;
  height: 32px;
  color: var(--accent-color, #b38245);
  margin-bottom: 1.2rem;
}

.testimonials-v2__stat-value {
  font-family: 'Montserrat', sans-serif;
  font-size: 1.8rem;
  font-weight: 700;
  color: var(--text-color, #0a2a26);
  margin-bottom: 0.4rem;
}

.testimonials-v2__stat-label {
  font-family: 'Montserrat', sans-serif;
  font-size: 1.15rem;
  font-weight: 500;
  color: var(--text-color, #0a2a26);
  opacity: 0.7;
}

.testimonials-v2__right {
  flex: 1;
  min-width: 0;
  position: relative;
  display: flex;
  flex-direction: column;
}

.testimonials-v2__slider-viewport {
  overflow-x: auto;
  overflow-y: visible;
  padding: 2rem 0 3rem 0;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none; /* Firefox */
  mask-image: linear-gradient(to right, black 85%, transparent 100%);
  -webkit-mask-image: linear-gradient(to right, black 85%, transparent 100%);
}

.testimonials-v2__slider-viewport::-webkit-scrollbar {
  display: none; /* Chrome/Safari */
}

.testimonials-v2__slider-track {
  display: flex;
  gap: 2.4rem;
  width: max-content;
  padding-left: 0;
  padding-right: 6rem;
}

.testimonials-v2__card-wrapper {
  scroll-snap-align: start;
  scroll-snap-stop: always;
  flex-shrink: 0;
  width: 330px;
  transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.4s ease;
  filter: drop-shadow(0 4px 15px rgba(0,0,0,0.04));
}

.testimonials-v2__card {
  background: #ffffff;
  border-radius: 30px;
  padding: 3.2rem 2.8rem;
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100%;
}

.testimonials-v2__card::after {
  content: '';
  position: absolute;
  bottom: -12px;
  left: 60px; /* Aligned roughly with the start of the author text */
  width: 0;
  height: 0;
  border-left: 12px solid transparent;
  border-right: 12px solid transparent;
  border-top: 12px solid #ffffff;
}

.testimonials-v2__card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 1.6rem;
}

.testimonials-v2__quote-icon {
  color: var(--accent-color, #b38245);
  width: 20px;
  line-height: 0;
}

.testimonials-v2__rating {
  display: flex;
  gap: 2px;
}

.testimonials-v2__rating .star {
  width: 15px;
  height: 15px;
  color: var(--accent-color, #b38245);
}

.testimonials-v2__text {
  margin: 0 0 2.4rem 0;
  flex-grow: 1;
}

.testimonials-v2__text p {
  font-family: 'Montserrat', sans-serif;
  font-size: 1.4rem;
  line-height: 1.5;
  color: var(--text-color, #0a2a26);
  margin: 0;
  font-weight: 500;
}

.testimonials-v2__meta {
  margin-top: auto;
}

.testimonials-v2__author-row {
  margin-bottom: 0.6rem;
}

.testimonials-v2__author {
  font-family: 'Montserrat', sans-serif;
  font-size: 1.35rem;
  font-weight: 700;
  color: var(--text-color, #0a2a26);
}

.testimonials-v2__location-row {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  font-family: 'Montserrat', sans-serif;
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  color: var(--text-color, #0a2a26);
}

.testimonials-v2__verify {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  color: #10b981;
  background-color: rgba(16, 185, 129, 0.08);
  padding: 0.25rem 0.6rem;
  border-radius: 4px;
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.05em;
}

.testimonials-v2__verify-icon {
  width: 10px;
  height: 10px;
  color: #10b981;
  flex-shrink: 0;
}

.testimonials-v2__location {
  opacity: 0.65;
}

.testimonials-v2__location-row .testimonials-v2__location-dot {
  color: var(--accent-color, #b38245);
  opacity: 0.4;
  font-size: 1.2rem;
  line-height: 1;
  display: inline-block;
}

.testimonials-v2__container--centered .testimonials-v2__location-row {
  justify-content: center;
}

.testimonials-v2__dots-container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 2rem 0 0 0;
  width: 100%;
}

.testimonials-v2__dots {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1rem;
}

.testimonials-v2__nav-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  border: 1.5px solid var(--accent-color, #b38245);
  background-color: transparent;
  padding: 0;
  cursor: pointer;
  opacity: 0.5;
  transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}

.testimonials-v2__nav-dot.is-active {
  width: 26px;
  height: 10px;
  border-radius: 5px;
  background-color: var(--accent-color, #b38245);
  border-color: var(--accent-color, #b38245);
  opacity: 1;
}

.testimonials-v2__card-wrapper {
  scroll-snap-align: start;
  scroll-snap-stop: always;
  flex-shrink: 0;
  width: 330px;
  opacity: 0.8;
  transform: scale(0.98);
  transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.4s ease, filter 0.4s ease;
  filter: drop-shadow(0 2px 8px rgba(0,0,0,0.03));
}

.testimonials-v2__card-wrapper.is-active {
  opacity: 1;
  transform: scale(1);
  filter: drop-shadow(0 6px 20px rgba(0,0,0,0.07));
}

/* Centered Layout Styles */
.testimonials-v2__container--centered {
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding-left: 2rem;
  padding-right: 2rem;
  gap: 0;
}

.testimonials-v2__header-centered {
  max-width: 800px;
  margin: 0 auto 3rem auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.testimonials-v2__subheading-wrapper {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 2rem;
  width: auto;
  margin-bottom: 1.5rem;
}

.testimonials-v2__line {
  height: 1px;
  background-color: var(--accent-color, #b38245);
  width: 60px;
  opacity: 0.5;
}

.testimonials-v2__subheading {
  font-family: 'Montserrat', sans-serif;
  font-size: 1.3rem;
  font-weight: 600;
  color: var(--accent-color, #b38245);
  text-transform: uppercase;
  letter-spacing: 0.25em;
  margin-bottom: 0;
  opacity: 1;
}


.testimonials-v2__heading-centered {
  font-size: 4.2rem;
  color: var(--text-color, #0a2a26);
  margin: 0 0 1.5rem 0;
  font-weight: 500;
  line-height: 1.2;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 1rem;
}

.testimonials-v2__heart-wrapper {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  color: var(--accent-color, #b38245);
  flex-shrink: 0;
}

.testimonials-v2__heart-outline {
  width: 100%;
  height: 100%;
  transform: rotate(5deg);
}

.testimonials-v2__description-centered {
  font-family: 'Montserrat', sans-serif;
  font-size: 1.6rem;
  color: var(--text-color, #0a2a26);
  opacity: 0.8;
  margin: 0;
  line-height: 1.5;
}

.testimonials-v2__description-centered .text-gold {
  color: var(--accent-color, #b38245);
  font-weight: 600;
}

/* Make slider take full viewport area in centered layout */
.testimonials-v2__container--centered .testimonials-v2__slider-viewport {
  width: 100vw;
  margin-left: calc(-50vw + 50%);
  margin-right: calc(-50vw + 50%);
  overflow-x: hidden;
  overflow-y: visible;
  mask-image: none;
  -webkit-mask-image: none;
  scroll-snap-type: none;
  padding-bottom: 2rem;
}

.testimonials-v2__container--centered .testimonials-v2__slider-track {
  display: flex;
  gap: 0;
  width: max-content;
  margin: 0;
  padding: 0;
}

.testimonials-v2__container--centered .testimonials-v2__marquee-content {
  display: flex;
  gap: 2.4rem;
  padding-right: 2.4rem;
  animation: scroll-marquee 40s linear infinite;
  will-change: transform;
}

.testimonials-v2__container--centered .testimonials-v2__slider-track:hover .testimonials-v2__marquee-content {
  animation-play-state: paused;
}

@keyframes scroll-marquee {
  0% { transform: translateX(0); }
  100% { transform: translateX(-100%); }
}

.testimonials-v2__container--centered .testimonials-v2__card-wrapper {
  width: 380px;
  max-width: 90vw;
  opacity: 1 !important;
  transform: none !important;
  filter: drop-shadow(0 4px 15px rgba(0,0,0,0.04));
  scroll-snap-align: none;
}

.testimonials-v2__container--centered .testimonials-v2__dots-container {
  display: none;
}

