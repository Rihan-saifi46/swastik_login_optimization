      background: #fff;
    }
    .pp-guide-scroll-wrapper img {
      max-width: none !important;
      width: 750px !important;
    }
  }

  /* Premium Tables */
  .pp-guide-modal-content table { width: 100%; border-collapse: separate; border-spacing: 0; border: 1px solid var(--pp-border); border-radius: 12px; overflow: hidden; margin-bottom: 20px; }
  .pp-guide-modal-content th, .pp-guide-modal-content td { padding: 14px 16px; border-bottom: 1px solid var(--pp-border); border-right: 1px solid var(--pp-border); text-align: left; font-size: 14px; }
