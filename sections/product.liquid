<script>
(function() {
  // ==========================================
  // BULLETPROOF LUXURY GALLERY & ZOOM CONTROLLER
  // Uses Event Delegation and strips srcset to guarantee instant image swaps!
  // ==========================================
  window.ppActiveIndex = 0;

  function setMainImage(index) {
    const thumbs = Array.from(document.querySelectorAll('.pp-thumb-item'));
    const mainImg = document.getElementById('pp-main-image');
    const zoomImg = document.getElementById('pp-zoom-img');
    const thumbWrapper = document.querySelector('.pp-thumbnails-wrapper');

    if (!thumbs.length || !mainImg) return;
    
    // Normalize index to wrap around cleanly
    window.ppActiveIndex = (index + thumbs.length) % thumbs.length;
    
    // Update active class on thumbnails
    thumbs.forEach(t => t.classList.remove('is-active'));
    thumbs[window.ppActiveIndex].classList.add('is-active');
    
    // Extract new image source from thumbnail data-image
    const newSrc = thumbs[window.ppActiveIndex].getAttribute('data-image');
    if (newSrc) {
      // Remove srcset and sizes so browser doesn't override or ignore .src assignment!
      mainImg.removeAttribute('srcset');
      mainImg.removeAttribute('sizes');
      mainImg.setAttribute('src', newSrc);
      mainImg.src = newSrc;
      
      if (zoomImg) {
        zoomImg.removeAttribute('srcset');
        zoomImg.removeAttribute('sizes');
        let zoomSrc = newSrc.replace('width=800', 'width=1600').replace('width=1000', 'width=1600').replace('width=180', 'width=1600');
        zoomImg.setAttribute('src', zoomSrc);
        zoomImg.src = zoomSrc;
      }
    }

    // Smoothly scroll horizontal carousel to center the active thumbnail
    if (thumbWrapper && thumbs[window.ppActiveIndex]) {
      const thumbEl = thumbs[window.ppActiveIndex];
      const wrapWidth = thumbWrapper.clientWidth;
      const thumbWidth = thumbEl.clientWidth;
      const thumbLeft = thumbEl.offsetLeft;
      thumbWrapper.scrollTo({
        left: thumbLeft - (wrapWidth / 2) + (thumbWidth / 2),
        behavior: 'smooth'
      });
    }
  }

  function openZoomModal() {
    const zoomOverlay = document.getElementById('pp-zoom-overlay');
    const zoomImg = document.getElementById('pp-zoom-img');
    const mainImg = document.getElementById('pp-main-image');
    const thumbs = Array.from(document.querySelectorAll('.pp-thumb-item'));

    if (!zoomOverlay || !zoomImg || !mainImg) return;
    
    let src = thumbs.length && thumbs[window.ppActiveIndex] ? thumbs[window.ppActiveIndex].getAttribute('data-image') : mainImg.src;
    if (src) {
      src = src.replace('width=800', 'width=1600').replace('width=1000', 'width=1600').replace('width=180', 'width=1600');
      zoomImg.removeAttribute('srcset');
      zoomImg.removeAttribute('sizes');
      zoomImg.setAttribute('src', src);
      zoomImg.src = src;
    }
    zoomOverlay.classList.add('is-active');
    document.body.style.overflow = 'hidden';
  }

  function closeZoomModal() {
    const zoomOverlay = document.getElementById('pp-zoom-overlay');
    if (!zoomOverlay) return;
    zoomOverlay.classList.remove('is-active');
    document.body.style.overflow = '';
  }

  // Use Event Delegation on document so clicks work 100% reliably even after Shopify DOM updates!
  document.addEventListener('click', function(e) {
    // 1. Thumbnail click
    const thumbEl = e.target.closest('.pp-thumb-item');
    if (thumbEl) {
      e.preventDefault();
      e.stopPropagation();
      const allThumbs = Array.from(document.querySelectorAll('.pp-thumb-item'));
      const idx = allThumbs.indexOf(thumbEl);
      if (idx !== -1) setMainImage(idx);
      return;
    }

    // 2. Previous Arrow (Main Gallery or Fullscreen Zoom)
    if (e.target.closest('.pp-nav-prev') || e.target.closest('#pp-zoom-prev')) {
      e.preventDefault();
      e.stopPropagation();
      setMainImage(window.ppActiveIndex - 1);
      return;
    }

    // 3. Next Arrow (Main Gallery or Fullscreen Zoom)
    if (e.target.closest('.pp-nav-next') || e.target.closest('#pp-zoom-next')) {
      e.preventDefault();
      e.stopPropagation();
      setMainImage(window.ppActiveIndex + 1);
      return;
    }

    // 4. Open Zoom Modal (Clicking [+] button or Main Image)
    const isFullscreenBtn = e.target.closest('.pp-fullscreen-btn');
    const isMainImage = e.target.closest('#pp-main-image');
    if (isFullscreenBtn || isMainImage) {
      e.preventDefault();
      e.stopPropagation();
      // On mobile devices (< 768px), disable general tap-to-zoom on the main image area.
      // Only tapping the explicit Fullscreen button (.pp-fullscreen-btn) triggers zoom!
      if (isMainImage && !isFullscreenBtn && window.innerWidth < 768) {
        return;
      }
      openZoomModal();
      return;
    }

    // 5. Close Zoom Modal (Clicking X or dark background overlay)
    if (e.target.closest('.pp-zoom-close') || (e.target.classList && e.target.classList.contains('pp-zoom-overlay'))) {
      e.preventDefault();
      e.stopPropagation();
      closeZoomModal();
      return;
    }

    // 6. Thumbnail Carousel Scroll Arrows
    if (e.target.closest('.pp-thumb-nav-prev')) {
      e.preventDefault();
      e.stopPropagation();
      const wrap = document.querySelector('.pp-thumbnails-wrapper');
      if (wrap) wrap.scrollBy({ left: -220, behavior: 'smooth' });
      return;
    }
    if (e.target.closest('.pp-thumb-nav-next')) {
      e.preventDefault();
      e.stopPropagation();
      const wrap = document.querySelector('.pp-thumbnails-wrapper');
      if (wrap) wrap.scrollBy({ left: 220, behavior: 'smooth' });
      return;
    }

    // 7. Accordion Dropdown Toggle (Details)
    const accHeader = e.target.closest('.pp-acc-header');
    if (accHeader) {
      e.preventDefault();
      const item = accHeader.closest('.pp-acc-item');
      if (item) {
        const isOpen = item.classList.contains('is-open');
        if (isOpen) {
          item.classList.remove('is-open');
          accHeader.setAttribute('aria-expanded', 'false');
        } else {
          item.classList.add('is-open');
          accHeader.setAttribute('aria-expanded', 'true');
        }
      }
      return;
    }

    // 7b. Customize Accordion Toggle
    const custToggle = e.target.closest('.pp-customize-toggle');
    if (custToggle) {
      e.preventDefault();
      const wrap = custToggle.closest('.pp-customize-wrap');
      const content = wrap.querySelector('.pp-customize-content');
      if (wrap.classList.contains('is-open')) {
        wrap.classList.remove('is-open');
        custToggle.setAttribute('aria-expanded', 'false');
        content.style.display = 'none';
      } else {
        wrap.classList.add('is-open');
        custToggle.setAttribute('aria-expanded', 'true');
        content.style.display = 'block';
      }
      return;
    }

    // 8. Tab Button Switching (Product Details <-> Price Breakdown)
    const tabBtn = e.target.closest('.pp-tab-btn');
    if (tabBtn) {
      e.preventDefault();
      const card = tabBtn.closest('.pp-tabs-card');
      if (card) {
        const targetId = tabBtn.getAttribute('data-target');
        card.querySelectorAll('.pp-tab-btn').forEach(b => b.classList.remove('is-active'));
        card.querySelectorAll('.pp-tab-body').forEach(b => {
          b.classList.remove('is-active');
          b.style.display = 'none';
        });
        tabBtn.classList.add('is-active');
        const targetBody = card.querySelector('#' + targetId);
        if (targetBody) {
          targetBody.classList.add('is-active');
          targetBody.style.display = 'flex';
        }
      }
      return;
    }

    // 9. Read More Toggle Link (About This Jewellery)
    const readMoreBtn = e.target.closest('.pp-read-more-btn, .pp-read-more-link');
    if (readMoreBtn) {
      e.preventDefault();
      const moreText = document.querySelector('.pp-about-more');
      const textSpan = readMoreBtn.querySelector('.pp-rm-text');
      if (moreText) {
        if (moreText.style.display === 'none' || !moreText.style.display) {
          moreText.style.display = 'block';
          if (textSpan) textSpan.textContent = 'Read less -';
          readMoreBtn.classList.add('is-expanded');
        } else {
          moreText.style.display = 'none';
          if (textSpan) textSpan.textContent = 'Read more +';
          readMoreBtn.classList.remove('is-expanded');
        }
      }
      return;
    }

    // Quantity Plus/Minus Buttons
    if (e.target.closest('.pp-qty-plus')) {
      e.preventDefault();
      const input = document.querySelector('.pp-qty-input');
      if (input) input.value = parseInt(input.value || 1, 10) + 1;
      return;
    }
    if (e.target.closest('.pp-qty-minus')) {
      e.preventDefault();
      const input = document.querySelector('.pp-qty-input');
      if (input && parseInt(input.value || 1, 10) > 1) {
        input.value = parseInt(input.value || 1, 10) - 1;
      }
      return;
    }

    // Buy Now Button (Dynamic Checkout)
    if (e.target.closest('.pp-btn-buy')) {
      e.preventDefault();
      const form = document.getElementById('pp-product-form');
      if (form) {
        let retInput = form.querySelector('input[name="return_to"]');
        if (!retInput) {
          retInput = document.createElement('input');
          retInput.type = 'hidden';
          retInput.name = 'return_to';
          form.appendChild(retInput);
        }
        retInput.value = '/checkout';
        form.submit();
      }
      return;
    }

    // 8. Variant / Option Selection Button
    const optBtn = e.target.closest('.pp-opt-btn');
    if (optBtn) {
      e.preventDefault();
      const group = optBtn.closest('.pp-option-values') || optBtn.closest('.pp-option-group');
      if (group) {
        group.querySelectorAll('.pp-opt-btn').forEach(b => b.classList.remove('is-active'));
        optBtn.classList.add('is-active');
      }
      
      // If product has variants JSON, match selected options and update price/sku/hidden input
      const variantsJsonEl = document.getElementById('pp-variants-json');
      if (variantsJsonEl) {
        try {
          const variants = JSON.parse(variantsJsonEl.textContent || '[]');
          const activeBtns = Array.from(document.querySelectorAll('.pp-option-group .pp-opt-btn.is-active'));
          const selectedVals = activeBtns.map(b => b.getAttribute('data-value') || b.textContent.trim());
          const matched = variants.find(v => {
            return v.options && v.options.every((val, idx) => val === selectedVals[idx] || !selectedVals[idx]);
          });
          if (matched) {
            const variantIdInput = document.getElementById('pp-variant-id');
            if (variantIdInput) variantIdInput.value = matched.id;
            
            // Stock Indicator Logic
            const elStockStatus = document.querySelector('.pp-stock-status');
            const elBtnAdd = document.querySelector('.pp-btn-add');
            const elBtnAddText = elBtnAdd ? elBtnAdd.querySelector('span') : null;
            const elBtnBuy = document.getElementById('pp-buy-now');
            
            const variantInventoryEl = document.getElementById('pp-variant-inventory-json');
            let isAvailable = matched.available;
            let invMgmt = null;
            let invPolicy = 'deny';
            let invQty = 0;
            
            if (variantInventoryEl) {
              try {
                const inventories = JSON.parse(variantInventoryEl.textContent || '{}');
                const invInfo = inventories[matched.id];
                if (invInfo) {
                  isAvailable = invInfo.available;
                  invMgmt = invInfo.inventory_management;
                  invPolicy = invInfo.inventory_policy;
                  invQty = invInfo.inventory_quantity;
                }
              } catch (err) {
                console.error('Error parsing variant inventory json:', err);
              }
            }
            
            if (isAvailable) {
              if (invMgmt && invQty <= 0 && invPolicy === 'continue') {
                if (elStockStatus) {
                  elStockStatus.className = 'pp-stock-status pp-stock-status--made-to-order';
                  elStockStatus.innerHTML = '<span>Made to Order</span>';
                }
              } else {
                if (elStockStatus) {
                  elStockStatus.className = 'pp-stock-status pp-stock-status--in-stock';
                  elStockStatus.innerHTML = '<span>In Stock</span>';
                }
              }
              
              if (elBtnAdd) {
                elBtnAdd.removeAttribute('disabled');
                if (elBtnAddText) elBtnAddText.textContent = 'ADD TO CART';
              }
              if (elBtnBuy) {
                elBtnBuy.removeAttribute('disabled');
                elBtnBuy.style.display = '';
              }
            } else {
              if (elStockStatus) {
                elStockStatus.className = 'pp-stock-status pp-stock-status--sold-out';
                elStockStatus.innerHTML = '<span>Sold Out</span>';
              }
              
              if (elBtnAdd) {
                elBtnAdd.setAttribute('disabled', 'true');
                if (elBtnAddText) elBtnAddText.textContent = 'SOLD OUT';
              }
              if (elBtnBuy) {
                elBtnBuy.setAttribute('disabled', 'true');
                elBtnBuy.style.display = 'none';
              }
            }
            
            const formatMoney = (cents) => {
              return 'Rs. ' + (cents / 100).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            };
            const priceFormatted = formatMoney(matched.price);
            
            const priceEl = document.getElementById('pp-price');
            if (priceEl && matched.price) {
              priceEl.innerHTML = priceFormatted;
            }

            const comparePriceEl = document.getElementById('pp-compare-price');
            if (comparePriceEl) {
              if (matched.compare_at_price > matched.price) {
                comparePriceEl.innerHTML = 'MRP ' + formatMoney(matched.compare_at_price);
                comparePriceEl.style.display = '';
              } else {
                comparePriceEl.style.display = 'none';
              }
            }
            
              // --- DYNAMIC UI BREAKDOWN LOGIC ---
              const metaEl = document.getElementById('pp-metafields-json');
              if (metaEl) {
                const meta = JSON.parse(metaEl.textContent || '{}');
                const total = matched.price / 100;
                
                let color = selectedVals[0] || 'Gold';
                let purity = selectedVals[1] || '18K';
                let quality = selectedVals[2] || 'G-VS';
                
                const groups = Array.from(document.querySelectorAll('.pp-option-group'));
                groups.forEach(g => {
                  const lbl = g.querySelector('.pp-option-label');
                  if (!lbl) return;
                  const txt = lbl.textContent.toLowerCase();
                  const btn = g.querySelector('.pp-opt-btn.is-active');
                  const val = btn ? (btn.getAttribute('data-value') || btn.textContent.trim()) : null;
                  if (!val) return;
                  
                  if (txt.includes('color') || txt.includes('metal') || txt.includes('colour')) {
                    color = val;
                  } else if (txt.includes('purity') || txt.includes('gold') || txt.includes('carat') || txt.includes('karat')) {
                    purity = val;
                  } else if (txt.includes('quality') || txt.includes('diamond') || txt.includes('clarity') || txt.includes('grade')) {
                    quality = val;
                  }
                });
                
                // Update Summary Card
                const elSumMetal = document.getElementById('sum-val-metal');
                const elSumPurity = document.getElementById('sum-val-purity');
                const elSumQuality = document.getElementById('sum-val-quality');
                const elSumSize = document.getElementById('sum-val-size');
                if(elSumPurity) elSumPurity.textContent = purity;
                if(elSumQuality) elSumQuality.textContent = quality;
                if(elSumMetal) {
                  elSumMetal.textContent = color;
                }
                if(elSumSize && selectedVals.length > 3 && selectedVals[3] != undefined) elSumSize.textContent = selectedVals[3];
                
                const variantMetaEl = document.getElementById('pp-variant-metafields-json');
              let variantMeta = {};
              if (variantMetaEl) {
                const allVariantMetas = JSON.parse(variantMetaEl.textContent || '{}');
                variantMeta = allVariantMetas[matched.id] || {};
              }

              const safeParse = (val, defaultVal) => {
                const parsed = parseFloat(String(val).replace(/[^0-9.]/g, ''));
                return isNaN(parsed) ? defaultVal : parsed;
              };
              
              const making = safeParse(variantMeta.making_charges, 13500);
              const diamondValue = safeParse(variantMeta.diamond_value, 0);
              const stoneValue = safeParse(variantMeta.stone_value, 0);
              const gst = safeParse(variantMeta.gst_amount, 0);
              const goldValue = safeParse(variantMeta.gold_value, 0);
              const diaWeight = parseFloat(String(meta.diamond_weight || '1.75').replace(/[^0-9.]/g, '')) || 1.75;
              
              const goldRate = safeParse(variantMeta.custom_gold_rate, 0);
              const diaRate = safeParse(variantMeta.custom_diamond_rate, 0);
              const stoneRate = safeParse(variantMeta.custom_stone_rate, 0);
              const makingRate = safeParse(variantMeta.custom_making_charge_rate, 0);
              
              const fmt = (val) => 'Rs. ' + val.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
              
              const elMetal = document.getElementById('ui-detail-metal');
              if(elMetal) elMetal.textContent = `${purity} ${color}`;
              
              const elDiaQuality = document.getElementById('ui-detail-quality');
              if(elDiaQuality) elDiaQuality.textContent = quality;
              
              const elGoldLbl = document.getElementById('ui-label-gold');
              if(elGoldLbl) elGoldLbl.textContent = `Gold Value (${purity})`;
              
              const elDiaLbl = document.getElementById('ui-label-dia-val');
              if(elDiaLbl) elDiaLbl.textContent = `Diamond Value`;
              
              const elGoldRate = document.getElementById('ui-bd-gold-rate');
              if(elGoldRate) elGoldRate.textContent = `₹${goldRate} / gm`;
              const elGoldRateM = document.getElementById('ui-bd-gold-rate-m');
              if(elGoldRateM) elGoldRateM.textContent = `₹${goldRate}/gm`;
              
              const elDiaRate = document.getElementById('ui-bd-dia-rate');
              if(elDiaRate) elDiaRate.textContent = `₹${diaRate} / ct`;
              const elDiaRateM = document.getElementById('ui-bd-dia-rate-m');
              if(elDiaRateM) elDiaRateM.textContent = `₹${diaRate}/ct`;
              
              const elStoneRate = document.getElementById('ui-bd-stone-rate');
              if(elStoneRate) elStoneRate.textContent = `₹${stoneRate} / ct`;
              const elStoneRateM = document.getElementById('ui-bd-stone-rate-m');
              if(elStoneRateM) elStoneRateM.textContent = `₹${stoneRate}/ct`;
              
              const elMakingRate = document.getElementById('ui-bd-making-rate');
              if(elMakingRate) elMakingRate.textContent = `₹${makingRate} / gm`;
              
              const elMakingRateText = document.getElementById('ui-bd-making-rate-text');
              if(elMakingRateText) elMakingRateText.textContent = makingRate;

              const elGoldVal = document.getElementById('ui-price-gold');
              if(elGoldVal) elGoldVal.textContent = fmt(goldValue > 0 ? goldValue : 0);
              
              const elDiaVal = document.getElementById('ui-price-diamond');
              if(elDiaVal) elDiaVal.textContent = fmt(diamondValue);
              
              const stoneWeightStr = String(meta.stone_weight || '0').trim();
              const hasStone = stoneWeightStr !== '0' && stoneWeightStr !== '';
              const elStoneLbl = document.getElementById('ui-label-stone-val');
              if(elStoneLbl && hasStone) elStoneLbl.textContent = `Stone Value`;

              const elStoneVal = document.getElementById('ui-price-stone');
              const elStoneRow = document.getElementById('ui-row-stone');
              const elStoneDivider = document.getElementById('ui-divider-stone');
              if(elStoneVal) {
                elStoneVal.textContent = fmt(stoneValue);
                if(stoneValue > 0) {
                  if(elStoneRow) elStoneRow.style.setProperty('display', 'flex', 'important');
                  if(elStoneDivider) elStoneDivider.style.display = '';
                } else {
                  if(elStoneRow) elStoneRow.style.setProperty('display', 'none', 'important');
                  if(elStoneDivider) elStoneDivider.style.setProperty('display', 'none', 'important');
                }
              }
              
              const elMaking = document.getElementById('ui-price-making');
              if(elMaking) elMaking.textContent = fmt(making);
              
              const elGst = document.getElementById('ui-price-gst');
              if(elGst) elGst.textContent = fmt(gst);
              
              const elTotal = document.getElementById('ui-price-total');
              if(elTotal) elTotal.textContent = priceFormatted;
            }
          }
        } catch (err) {
          console.error('Error parsing variants JSON:', err);
        }
      }
      return;
    }

    // 8b. Clear Customizations Button
    const clearBtn = e.target.closest('#pp-clear-customizations');
    if (clearBtn) {
      e.preventDefault();
      const variantIdInput = document.getElementById('pp-variant-id');
      const variantsJsonEl = document.getElementById('pp-variants-json');
      if (variantIdInput && variantsJsonEl) {
        const defaultVariantId = variantIdInput.getAttribute('data-default-id');
        const variants = JSON.parse(variantsJsonEl.textContent || '[]');
        const defVar = variants.find(v => String(v.id) === defaultVariantId);
        
        if (defVar && defVar.options) {
          const optionGroups = document.querySelectorAll('.pp-option-group');
          optionGroups.forEach((group, idx) => {
            const targetVal = defVar.options[idx];
            if (targetVal) {
              const btn = Array.from(group.querySelectorAll('.pp-opt-btn')).find(b => (b.getAttribute('data-value') || b.textContent.trim()) === targetVal);
              if (btn && !btn.classList.contains('is-active')) {
                btn.click();
              }
            }
          });
        }
      }
      return;
    }
  });

  // Keyboard navigation for full screen modal
  document.addEventListener('keydown', function(e) {
    const zoomOverlay = document.getElementById('pp-zoom-overlay');
    if (e.key === 'Escape' && zoomOverlay && zoomOverlay.classList.contains('is-active')) {
      closeZoomModal();
    }
    if (e.key === 'ArrowLeft') setMainImage(window.ppActiveIndex - 1);
    if (e.key === 'ArrowRight') setMainImage(window.ppActiveIndex + 1);
  });

  // Touch swipe navigation for mobile gallery
  const mainImageWrap = document.querySelector('.pp-main-image-wrap');
  if (mainImageWrap) {
    let touchStartX = 0;
    let touchStartY = 0;
    mainImageWrap.addEventListener('touchstart', function(e) {
      if (e.touches && e.touches.length === 1) {
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
      }
    }, { passive: true });
    mainImageWrap.addEventListener('touchend', function(e) {
      if (!e.changedTouches || e.changedTouches.length === 0) return;
      const touchEndX = e.changedTouches[0].clientX;
      const touchEndY = e.changedTouches[0].clientY;
      const diffX = touchEndX - touchStartX;
      const diffY = touchEndY - touchStartY;
      if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 40) {
        if (diffX < 0) {
          setMainImage(window.ppActiveIndex + 1);
        } else {
          setMainImage(window.ppActiveIndex - 1);
        }
      }
    }, { passive: true });
  }
  // Recommendations Carousel Dots and Navigation are now handled dynamically by ProductRecommendations custom element class in sections/product-recommendations.liquid


  // Guide Modals Logic
  const guideBtns = document.querySelectorAll('.pp-guide-btn');
  guideBtns.forEach(btn => {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      const targetId = this.getAttribute('data-modal');
      const targetModal = document.getElementById(targetId);
      if (targetModal) {
        targetModal.classList.add('is-active');
        document.body.style.overflow = 'hidden';
      }
    });
  });

  const closeGuideModals = () => {
    document.querySelectorAll('.pp-guide-modal-overlay').forEach(modal => {
      modal.classList.remove('is-active');
    });
    document.body.style.overflow = '';
  };

  document.addEventListener('click', function(e) {
    if (e.target.closest('.pp-guide-modal-close')) {
      closeGuideModals();
    } else if (e.target.classList.contains('pp-guide-modal-overlay')) {
      closeGuideModals();
    }
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeGuideModals();
  });



  // Initialize dynamic fields on page load to ensure they match the active variant
  window.addEventListener('DOMContentLoaded', function() {
    const defaultActiveBtn = document.querySelector('.pp-option-group .pp-opt-btn.is-active');
    if (defaultActiveBtn) {
      defaultActiveBtn.click();
    }
  });
})();
</script>

