    display: block !important;
    margin: 0 !important;
  }
  .pp-about-desc {
    margin-bottom: 8px !important;
  }
  .pp-about-desc, .pp-about-desc p, .pp-about-desc div, .pp-about-short, .pp-about-more {
    font-family: 'Inter', var(--pp-font-sans), sans-serif !important;
