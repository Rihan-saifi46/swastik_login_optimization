    .pp-guide-modal-close { top: 24px; right: 24px; width: 40px; height: 40px; }
    .pp-guide-modal-content { font-size: 16px; margin-top: 0; }
    .pp-guide-modal-content h1, .pp-guide-modal-content h2, .pp-guide-modal-content h3 { font-size: 28px; }
  }
  .pp-btn-arrow { width: 20px; height: 20px; flex-shrink: 0; transition: transform 0.25s ease; }
  .pp-btn-buy:hover .pp-btn-arrow { transform: translateX(4px); }

  /* ==========================================================================
     5. BOTTOM SHOWCASE (Architectural Luxury Cards matching Mobile UI)
     ========================================================================== */
  .pp-bottom-showcase { max-width: 1000px; margin: 30px auto 50px auto; padding: 0 20px; font-family: var(--pp-font-sans); }
  .pp-bottom-showcase-grid { display: flex; flex-direction: column; gap: 20px; width: 100%; }
  .pp-bottom-card { background: var(--pp-bg-light); border: 1px solid var(--pp-border); border-radius: 20px; padding: 24px 32px; box-shadow: 0 8px 30px rgba(0, 0, 0, 0.02); transition: all 0.3s ease; }
  
  /* 1. About This Jewellery (Editorial Text Section - No Card Box/Border) */
  .pp-about-text-section {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 8px 4px 16px 4px !important;
    margin: 0 !important;
  }
  .pp-about-header {
    margin-bottom: 12px !important;
  }
  .pp-about-title {
    font-family: 'Inter', var(--pp-font-sans), sans-serif !important;
    font-size: 18px !important;
    font-weight: 700 !important;
    line-height: 1.3 !important;
    letter-spacing: -0.01em !important;
