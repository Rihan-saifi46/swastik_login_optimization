  @media (prefers-reduced-motion: reduce) {
    .pdp-coupon-overlay,
    .pdp-coupon-drawer,
    .pp-apply-coupon-btn,
    .pp-price-current,
    .pp-price-animating,
    .pp-price-original-struck {
      transition: none !important;
      animation: none !important;
      transform: none !important;
