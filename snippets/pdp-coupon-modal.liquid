{% doc %}
  Product Details Page (PDP) Coupon Modal and Controller for Swastik Jewels.
  Displays ONLY verified discount codes received from the CRM metafield integration,
  applies coupons via Shopify supported discount flow, and powers smooth animated price transitions.

  @param {product} product - The current product object
  @param {variant} current_variant - The currently selected product variant

  @example
  {% render 'pdp-coupon-modal', product: product, current_variant: current_variant %}
{% enddoc %}

{%- assign active_variant = current_variant | default: product.selected_or_first_available_variant -%}
<div
  id="pdp-initial-variant-data"
  data-variant-id="{{ active_variant.id }}"
  data-price="{{ active_variant.price }}"
  data-sku="{{ active_variant.sku }}"
  style="display: none;"
></div>

{%- assign product_coupon_metafield = product.metafields.custom.coupons -%}
{%- assign shop_coupon_metafield = shop.metafields.custom.coupons | default: shop.metafields.custom.global_coupons -%}

<!-- CRM Discount Data JSON scripts are rendered in product.liquid to ensure single authoritative source -->

<!-- PDP Coupon Modal / Drawer Overlay -->
<div
  class="pdp-coupon-overlay"
  id="PdpCouponModalOverlay"
  style="display: none;"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-labelledby="PdpCouponModalTitle"
>
  <div class="pdp-coupon-backdrop" id="PdpCouponBackdrop"></div>

  <div class="pdp-coupon-drawer" id="PdpCouponDrawer" tabindex="-1">
    <!-- Mobile Pull Indicator -->
    <div class="pdp-coupon-drag-handle" aria-hidden="true"></div>

    <!-- Header -->
    <div class="pdp-coupon-drawer-header">
      <div class="pdp-coupon-header-text">
        <div class="pdp-coupon-badge">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
          <span>EXCLUSIVE OFFERS</span>
        </div>
        <h3 class="pdp-coupon-drawer-title" id="PdpCouponModalTitle">Available Coupons</h3>
        <p class="pdp-coupon-drawer-subtitle">Apply an eligible discount code for savings on this order</p>
      </div>

      <button
        type="button"
        class="pdp-coupon-close-btn"
        id="PdpCouponCloseBtn"
        aria-label="Close coupon offers"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Manual Code Entry Form -->
    <div class="pdp-coupon-manual-box">
      <div class="pdp-coupon-input-group">
        <svg class="pdp-coupon-input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
          <line x1="7" y1="7" x2="7.01" y2="7"></line>
        </svg>
        <input
          type="text"
          id="PdpManualCouponInput"
          class="pdp-coupon-input"
          placeholder="Enter coupon code"
          autocomplete="off"
          autocapitalize="characters"
          spellcheck="false"
          aria-label="Enter coupon code"
        >
      </div>
      <button
        type="button"
        id="PdpManualApplyBtn"
        class="pdp-coupon-manual-btn"
      >
        <span>APPLY</span>
      </button>
    </div>

    <!-- In-modal Notification/Alert Message -->
    <div id="PdpCouponAlertMsg" class="pdp-coupon-alert-msg" style="display: none;" role="status" aria-live="polite"></div>

    <!-- Scrollable Coupon Cards List -->
    <div class="pdp-coupon-drawer-body" id="PdpCouponListContainer">
      <!-- Injected dynamically from authoritative CRM data -->
    </div>

    <!-- Footer Security Note -->
    <div class="pdp-coupon-drawer-footer">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>
      <span>Shopify discounts are verified and passed directly to your checkout.</span>
    </div>
  </div>
</div>

<style>
  /* Price Area Integration */
  .pp-price-box-top {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 14px !important;
    flex-wrap: wrap !important;
  }

  .pp-price-display-wrap {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .pp-price-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* Current and Discounted Price Display */
  .pp-price-current {
    font-family: var(--pp-font-sans, 'Inter', sans-serif) !important;
    font-size: 40px !important;
    font-weight: 700 !important;
    color: var(--pp-primary, #013F3E) !important;
    line-height: 1.1 !important;
    letter-spacing: -0.02em !important;
    transition: color 0.3s ease;
  }

  .pp-price-current.is-discounted {
    color: #013F3E !important;
  }

  .pp-price-animating {
    animation: ppPricePulse 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes ppPricePulse {
    0% {
      opacity: 0.4;
      transform: translateY(4px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Original Price Strikethrough */
  .pp-price-original-struck {
    font-family: var(--pp-font-sans, 'Inter', sans-serif);
    font-size: 20px;
    font-weight: 500;
    color: #777777;
    text-decoration: line-through;
    opacity: 0.85;
    position: relative;
    white-space: nowrap;
    animation: ppFadeIn 0.35s ease forwards;
  }

  .pp-price--discounted {
    color: var(--pp-primary, #013F3E) !important;
  }

  .pp-price--original {
    text-decoration: line-through !important;
    color: #888888 !important;
    margin-left: 8px;
    font-size: 20px;
    font-weight: 500;
  }

  @keyframes ppFadeIn {
    from { opacity: 0; transform: translateX(-4px); }
    to { opacity: 0.85; transform: translateX(0); }
  }

  /* Apply Coupon Trigger Button (Beside Price) */
  .pp-coupon-trigger-wrap {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
  }

  .pp-apply-coupon-btn {
    display: inline-flex !important;
    align-items: center !important;
    gap: 8px !important;
    padding: 8px 16px !important;
    background: #FCFBF9 !important;
    border: 1px solid rgba(212, 175, 55, 0.45) !important;
    border-radius: 20px !important;
    color: #013F3E !important;
    font-family: var(--pp-font-sans, 'Inter', sans-serif) !important;
    font-size: 11.5px !important;
    font-weight: 700 !important;
    letter-spacing: 0.06em !important;
    text-transform: uppercase !important;
    cursor: pointer !important;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1) !important;
    box-shadow: 0 2px 8px rgba(1, 63, 62, 0.05) !important;
    outline: none !important;
    line-height: 1 !important;
    white-space: nowrap !important;
  }

  .pp-apply-coupon-btn:hover {
    background: rgba(212, 175, 55, 0.12) !important;
    border-color: #D4AF37 !important;
    color: #012B2A !important;
    transform: translateY(-1px) !important;
    box-shadow: 0 4px 14px rgba(212, 175, 55, 0.22) !important;
  }

  .pp-apply-coupon-btn:active {
    transform: scale(0.97) !important;
  }

  .pp-apply-coupon-btn.is-applied {
    background: rgba(1, 63, 62, 0.07) !important;
    border-color: #013F3E !important;
    color: #013F3E !important;
  }

  .pp-apply-coupon-btn.is-applied .pp-coupon-btn-icon {
    color: #2E7D32 !important;
  }

  .pp-coupon-btn-icon {
    flex-shrink: 0;
    color: #B38245;
    transition: color 0.2s ease;
  }

  .pp-coupon-btn-badge {
    background: #013F3E;
    color: #FFFFFF;
    padding: 3px 8px;
    border-radius: 12px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.04em;
    display: inline-flex;
    align-items: center;
  }

  /* Quick Remove Button on PDP Trigger */
  .pp-coupon-quick-remove {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 26px !important;
    height: 26px !important;
    border-radius: 50% !important;
    border: 1px solid rgba(1, 63, 62, 0.18) !important;
    background: #FFFFFF !important;
    color: #666666 !important;
    cursor: pointer !important;
    padding: 0 !important;
    transition: all 0.2s ease !important;
    outline: none !important;
  }

  .pp-coupon-quick-remove:hover {
    background: #FFEBEE !important;
    border-color: #D32F2F !important;
    color: #D32F2F !important;
    transform: rotate(90deg) !important;
  }

  /* Savings Callout in Price Box Bottom */
  .pp-coupon-applied-callout {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 4px;
    animation: ppFadeIn 0.35s ease forwards;
  }

  .pp-coupon-savings-tag {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 10px;
    background: #E8F5E9;
    border: 1px solid #A5D6A7;
    border-radius: 6px;
    color: #1B5E20;
    font-family: var(--pp-font-sans, 'Inter', sans-serif);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.2;
  }

  .pp-coupon-savings-explanation {
    font-family: var(--pp-font-sans, 'Inter', sans-serif);
    font-size: 12px;
    color: #666666;
    font-weight: 500;
  }

  /* =========================================================
     MODAL & DRAWER STYLES
     ========================================================= */
  .pdp-coupon-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 9999999;
    display: none;
    align-items: center;
    justify-content: center;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    box-sizing: border-box;
  }

  .pdp-coupon-overlay.is-active {
    display: flex !important;
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
  }

  .pdp-coupon-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(1, 39, 38, 0.58);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    cursor: pointer;
  }

  .pdp-coupon-drawer {
    position: relative;
    width: 92%;
    max-width: 480px;
    max-height: 88vh;
    background: #FCFBF9;
    border: 1px solid rgba(1, 63, 62, 0.12);
    border-radius: 16px;
    padding: 24px 22px 18px;
    box-shadow: 0 20px 60px rgba(1, 39, 38, 0.28), 0 4px 16px rgba(0, 0, 0, 0.08);
    box-sizing: border-box;
    z-index: 2;
    display: flex;
    flex-direction: column;
    transform: scale(0.95) translateY(12px);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
    outline: none;
  }

  .pdp-coupon-overlay.is-active .pdp-coupon-drawer {
    transform: scale(1) translateY(0);
  }

  .pdp-coupon-drag-handle {
    display: none;
  }

  .pdp-coupon-drawer-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 16px;
    padding-bottom: 4px;
    gap: 12px;
  }

  .pdp-coupon-header-text {
    flex: 1;
  }

  .pdp-coupon-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 10px;
    background: rgba(212, 175, 55, 0.12);
    border: 1px solid rgba(212, 175, 55, 0.35);
    border-radius: 20px;
    color: #9E742E;
    font-family: var(--pp-font-sans, 'Inter', sans-serif);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 6px;
  }

  .pdp-coupon-badge svg {
    color: #D4AF37;
  }

  .pdp-coupon-drawer-title {
    font-family: 'Outfit', 'Cormorant Garamond', serif;
    font-size: 21px;
    font-weight: 600;
    color: #013F3E;
    margin: 0 0 4px;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }

  .pdp-coupon-drawer-subtitle {
    font-family: var(--pp-font-sans, 'Inter', sans-serif);
    font-size: 12.5px;
    color: #666666;
    margin: 0;
    line-height: 1.4;
    font-weight: 400;
  }

  .pdp-coupon-close-btn {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #FFFFFF;
    border: 1px solid rgba(1, 63, 62, 0.12);
    color: #013F3E;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: background-color 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
    flex-shrink: 0;
    outline: none;
  }

  .pdp-coupon-close-btn:hover {
    background: #F0EFEA;
    border-color: #013F3E;
    transform: rotate(90deg);
  }

  .pdp-coupon-close-btn:focus-visible {
    box-shadow: 0 0 0 2px #013F3E;
  }

  /* Manual Code Input */
  .pdp-coupon-manual-box {
    display: flex !important;
    align-items: stretch !important;
    gap: 10px !important;
    margin-bottom: 14px !important;
    width: 100% !important;
    box-sizing: border-box !important;
  }

  .pdp-coupon-input-group {
    flex: 1 1 auto !important;
    min-width: 0 !important;
    position: relative !important;
    display: flex !important;
    align-items: center !important;
    box-sizing: border-box !important;
  }

  .pdp-coupon-input-group .pdp-coupon-input-icon {
    position: absolute !important;
    left: 14px !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
    width: 16px !important;
    height: 16px !important;
    min-width: 16px !important;
    min-height: 16px !important;
    color: #888888 !important;
    pointer-events: none !important;
    z-index: 2 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    flex-shrink: 0 !important;
  }

  .pdp-coupon-input-group input.pdp-coupon-input,
  .pdp-coupon-input {
    width: 100% !important;
    min-width: 0 !important;
    height: 44px !important;
    line-height: normal !important;
    padding: 0 14px 0 42px !important;
    margin: 0 !important;
    background: #FFFFFF !important;
    border: 1px solid rgba(1, 63, 62, 0.18) !important;
    border-radius: 8px !important;
    font-family: var(--pp-font-sans, 'Inter', sans-serif) !important;
    font-size: 13px !important;
    font-weight: 600 !important;
    color: #013F3E !important;
    text-transform: uppercase !important;
    letter-spacing: 0.04em !important;
    outline: none !important;
    transition: border-color 0.2s ease, box-shadow 0.2s ease !important;
    box-sizing: border-box !important;
    -webkit-appearance: none !important;
    appearance: none !important;
  }

  .pdp-coupon-input-group input.pdp-coupon-input::placeholder,
  .pdp-coupon-input::placeholder {
    color: #999999 !important;
    text-transform: none !important;
    font-weight: 400 !important;
    letter-spacing: normal !important;
  }

  .pdp-coupon-input-group input.pdp-coupon-input:focus,
  .pdp-coupon-input:focus {
    border-color: #013F3E !important;
    box-shadow: 0 0 0 3px rgba(1, 63, 62, 0.1) !important;
  }

  .pdp-coupon-manual-btn {
    flex-shrink: 0 !important;
    padding: 0 20px !important;
    height: 44px !important;
    border-radius: 8px !important;
    background: #013F3E !important;
    color: #FFFFFF !important;
    border: none !important;
    font-family: var(--pp-font-sans, 'Inter', sans-serif) !important;
    font-size: 11.5px !important;
    font-weight: 700 !important;
    letter-spacing: 0.08em !important;
    cursor: pointer !important;
    transition: all 0.2s ease !important;
    outline: none !important;
    white-space: nowrap !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    box-sizing: border-box !important;
  }

  .pdp-coupon-manual-btn:hover {
    background: #012B2A !important;
    transform: translateY(-1px) !important;
  }

  .pdp-coupon-manual-btn:disabled {
    opacity: 0.6 !important;
    cursor: not-allowed !important;
    transform: none !important;
  }

  .pdp-coupon-alert-msg {
    padding: 8px 12px;
    border-radius: 8px;
    font-family: var(--pp-font-sans, 'Inter', sans-serif);
    font-size: 12px;
    line-height: 1.4;
    margin-bottom: 12px;
    animation: ppFadeIn 0.25s ease;
  }

  .pdp-coupon-alert-msg.is-success {
    background: #E8F5E9;
    color: #2E7D32;
    border: 1px solid #C8E6C9;
  }

  .pdp-coupon-alert-msg.is-error {
    background: #FFEBEE;
    color: #C62828;
    border: 1px solid #FFCDD2;
  }

  .pdp-coupon-drawer-body {
    flex: 1;
    overflow-y: auto;
    max-height: calc(88vh - 210px);
    padding: 2px 2px 6px;
    margin-bottom: 10px;
    box-sizing: border-box;
    -webkit-overflow-scrolling: touch;
  }

  .pdp-coupon-drawer-body::-webkit-scrollbar {
    width: 4px;
  }

  .pdp-coupon-drawer-body::-webkit-scrollbar-track {
    background: transparent;
  }

  .pdp-coupon-drawer-body::-webkit-scrollbar-thumb {
    background: rgba(1, 63, 62, 0.15);
    border-radius: 4px;
  }

  /* Coupon Card */
  .pdp-coupon-card {
    display: flex;
    align-items: stretch;
    background: #FFFFFF;
    border: 1px solid rgba(1, 63, 62, 0.12);
    border-radius: 12px;
    margin-bottom: 12px;
    position: relative;
    overflow: hidden;
    box-shadow: 0 3px 12px rgba(1, 63, 62, 0.03);
    transition: all 0.2s ease;
  }

  .pdp-coupon-card:last-child {
    margin-bottom: 0;
  }

  .pdp-coupon-card:hover {
    border-color: rgba(212, 175, 55, 0.45);
    box-shadow: 0 6px 18px rgba(1, 63, 62, 0.07);
  }

  .pdp-coupon-card.is-applied-card {
    border-color: #2E7D32;
    background: #FAFDF9;
    box-shadow: 0 4px 16px rgba(46, 125, 50, 0.1);
  }

  .pdp-coupon-card.is-ineligible-card {
    opacity: 0.75;
    background: #FBFBFA;
  }

  /* Notches */
  .pdp-coupon-card::before,
  .pdp-coupon-card::after {
    content: "";
    position: absolute;
    width: 14px;
    height: 14px;
    background: #FCFBF9;
    border-radius: 50%;
    z-index: 3;
    border: 1px solid rgba(1, 63, 62, 0.12);
    box-sizing: border-box;
  }

  .pdp-coupon-card::before {
    top: -7px;
    right: 32%;
  }

  .pdp-coupon-card::after {
    bottom: -7px;
    right: 32%;
  }

  .pdp-coupon-card-left {
    flex: 1.9;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }

  .pdp-coupon-card-header-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
    flex-wrap: wrap;
  }

  .pdp-coupon-card-discount {
    font-family: 'Outfit', sans-serif;
    font-size: 18px;
    font-weight: 700;
    color: #013F3E;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .pdp-coupon-status-tag {
    font-family: var(--pp-font-sans, 'Inter', sans-serif);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: 4px;
  }

  .pdp-coupon-status-tag.is-applied {
    background: #E8F5E9;
    color: #2E7D32;
    border: 1px solid #A5D6A7;
  }

  .pdp-coupon-status-tag.is-ineligible {
    background: #FFF3E0;
    color: #E65100;
    border: 1px solid #FFE0B2;
  }

  .pdp-coupon-card-desc {
    font-family: var(--pp-font-sans, 'Inter', sans-serif);
    font-size: 12px;
    color: #333333;
    font-weight: 500;
    line-height: 1.35;
    word-break: break-word;
    margin-bottom: 4px;
  }

  .pdp-coupon-card-condition {
    font-family: var(--pp-font-sans, 'Inter', sans-serif);
    font-size: 11px;
    color: #666666;
    margin-top: 2px;
    line-height: 1.3;
  }

  .pdp-coupon-card-condition.is-unmet {
    color: #C62828;
    font-weight: 600;
  }

  .pdp-coupon-card-expiry {
    font-family: var(--pp-font-sans, 'Inter', sans-serif);
    font-size: 10px;
    color: #888888;
