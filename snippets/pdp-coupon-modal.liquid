</style>

<script>
(function() {
  'use strict';

  const STORAGE_KEY = 'swastik_applied_coupon';
  let cachedCoupons = [];
  let isDataLoaded = false;
  let currentAppliedCode = '';

  function formatPriceINR(cents) {
    const rupees = cents / 100;
    return 'Rs. ' + rupees.toLocaleString('en-IN', {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    });
  }

  function getStoredCoupon() {
    try {
      return localStorage.getItem(STORAGE_KEY) || sessionStorage.getItem(STORAGE_KEY) || '';
    } catch (e) {
      return '';
    }
  }

  function setStoredCoupon(code) {
    try {
      if (code) {
        localStorage.setItem(STORAGE_KEY, code);
        sessionStorage.setItem(STORAGE_KEY, code);
        // Set standard Shopify storefront discount cookie directly
        document.cookie = 'discount_code=' + encodeURIComponent(code) + '; path=/; SameSite=Lax';
      } else {
        localStorage.removeItem(STORAGE_KEY);
        sessionStorage.removeItem(STORAGE_KEY);
        document.cookie = 'discount_code=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT';
      }
    } catch (e) {}
  }

  // Parse CRM coupon record
  function normalizeCrmCoupon(c) {
    if (!c || typeof c !== 'object') return null;
    const code = c.code || c.promo_code || '';
    if (!code || typeof code !== 'string') return null;

    // Filter expired discounts based on CRM timestamps
    const expiryRaw = c.endsAt || c.expiry_date || c.end_date || null;
    if (expiryRaw) {
      const expDate = new Date(expiryRaw);
      if (!isNaN(expDate.getTime()) && expDate.getTime() < Date.now()) {
        return null; // Inactive / Expired
      }
    }

    // Filter not-yet-started discounts
    const startsRaw = c.startsAt || c.start_date || null;
    if (startsRaw) {
      const startDate = new Date(startsRaw);
      if (!isNaN(startDate.getTime()) && startDate.getTime() > Date.now()) {
        return null; // Inactive / Future
      }
    }

    // Filter inactive/disabled status
    if (c.status && (c.status === 'inactive' || c.status === 'disabled' || c.status === 'draft' || c.status === 'expired')) {
      return null;
    }
    if (c.active === false || c.is_active === false) {
      return null;
    }

    let formattedExpiry = '';
    if (expiryRaw) {
      const expDate = new Date(expiryRaw);
      if (!isNaN(expDate.getTime())) {
        formattedExpiry = expDate.toLocaleDateString('en-IN', {
          day: 'numeric',
          month: 'short',
          year: 'numeric'
        });
      } else {
        formattedExpiry = String(expiryRaw).replace(/^Valid till\s*/i, '');
      }
    }

    let type = c.type || c.discount_type || 'percentage';
    let value = c.discount_value !== undefined ? c.discount_value :
      (c.value !== undefined ? c.value :
        (c.customerGets?.value?.percentage ? c.customerGets.value.percentage * 100 :
          (c.customerGets?.value?.discountAmount?.amount || 0)));

    if (type === 'percentage' && value > 0 && value < 1) {
      value = Math.round(value * 100);
    }

    const minOrder = c.min_order_value !== undefined && c.min_order_value !== null ? c.min_order_value :
      (c.minimum_order_value !== undefined && c.minimum_order_value !== null ? c.minimum_order_value :
        (c.minimumRequirement?.subtotal?.greaterThanOrEqualToSubtotal || null));

    const desc = c.short_description || c.title || c.campaign_name || '';

    const isDiamondOnly = Boolean(
      c.is_diamond_only === true ||
      c.is_diamond_only === 'true' ||
      c.isDiamondOnly === true ||
      c.isDiamondOnly === 'true' ||
      c.discount_target === 'diamond_only' ||
      c.discountTarget === 'diamond_only'
    );
    let diaPercent = parseFloat(
      c.diamond_discount_percent !== undefined ? c.diamond_discount_percent :
      (c.diamondDiscountPercent !== undefined ? c.diamondDiscountPercent :
      (isDiamondOnly ? value : 0))
    ) || 0;
    if (diaPercent > 0 && diaPercent <= 1) {
      diaPercent = Math.round(diaPercent * 100);
    }

    return {
      code: code.trim().toUpperCase(),
      title: c.title || '',
      type: type,
      value: parseFloat(value) || 0,
      discount_target: c.discount_target || c.discountTarget || (isDiamondOnly ? 'diamond_only' : 'entire_product'),
      is_diamond_only: isDiamondOnly,
      diamond_discount_percent: diaPercent,
      eligible_categories: Array.isArray(c.eligible_categories) ? c.eligible_categories : [],
      excluded_categories: Array.isArray(c.excluded_categories) ? c.excluded_categories : [],
      min_order_value: minOrder !== null ? parseFloat(minOrder) : null,
      expiry_date: formattedExpiry,
      short_description: desc
    };
  }

  function getVariantMetafields(variantId) {
    if (!variantId) return {};
    const el = document.getElementById('pp-variant-metafields-json');
    if (!el) return {};
    try {
      const all = JSON.parse(el.textContent || '{}');
      return all[String(variantId)] || all[variantId] || {};
    } catch (e) {
      return {};
    }
  }

  function getVariantDiamondValue(variantId) {
    const meta = getVariantMetafields(variantId);
    if (meta && meta.diamond_value !== undefined && meta.diamond_value !== null) {
      const parsed = parseFloat(String(meta.diamond_value).replace(/[^0-9.]/g, ''));
      if (!isNaN(parsed) && parsed > 0) return parsed;
    }
    // Fallback: check DOM breakdown element if available
    const diaPriceEl = document.getElementById('ui-price-diamond');
    if (diaPriceEl) {
      const inrAttr = diaPriceEl.getAttribute('data-inr-price');
      if (inrAttr) {
        const val = parseFloat(inrAttr) / 100;
        if (!isNaN(val) && val > 0) return val;
      }
      const text = diaPriceEl.textContent || '';
      const match = text.replace(/,/g, '').match(/[0-9.]+/);
      if (match) {
        const val = parseFloat(match[0]);
        if (!isNaN(val) && val > 0) return val;
      }
    }
    return 0;
  }

  // Authoritative CRM Loader: ONLY reads from CRM metafield elements
  function loadCrmCoupons(forceReload = false) {
    if (!forceReload && isDataLoaded && cachedCoupons.length > 0) return cachedCoupons;

    const rawList = [];

    // 1. Shop Metafields
    const shopJson = document.getElementById('pp-shop-coupons-json');
    if (shopJson) {
      try {
        const raw = JSON.parse(shopJson.textContent || '[]');
        if (Array.isArray(raw)) rawList.push(...raw);
      } catch (e) {}
    }

    // 2. Collection Metafields
    const colJson = document.getElementById('pp-collection-coupons-json');
    if (colJson) {
      try {
        const raw = JSON.parse(colJson.textContent || '[]');
        if (Array.isArray(raw)) {
          raw.forEach(item => {
            if (Array.isArray(item)) rawList.push(...item);
            else if (item && typeof item === 'object') rawList.push(item);
          });
        }
      } catch (e) {}
    }

    // 3. Product Metafields
    const prodJson = document.getElementById('pp-coupons-data-json');
    if (prodJson) {
      try {
        const raw = JSON.parse(prodJson.textContent || '[]');
        if (Array.isArray(raw)) rawList.push(...raw);
      } catch (e) {}
    }

    // Deduplicate and filter exclusively via CRM data rules
    const map = new Map();
    rawList.forEach(item => {
      const norm = normalizeCrmCoupon(item);
      if (norm && norm.code && !map.has(norm.code)) {
        map.set(norm.code, norm);
      }
    });

    cachedCoupons = Array.from(map.values());
    isDataLoaded = true;
    return cachedCoupons;
  }

  function getVariantCoupons(variantId) {
    const all = loadCrmCoupons();
    if (!variantId) return all;

    const varJson = document.getElementById('pp-variant-coupons-json');
    if (varJson) {
      try {
        const varMap = JSON.parse(varJson.textContent || '{}');
        const vCoupons = varMap[variantId];
        if (Array.isArray(vCoupons)) {
          const combined = [...all];
          vCoupons.forEach(item => {
            const norm = normalizeCrmCoupon(item);
            if (norm && norm.code && !combined.some(c => c.code === norm.code)) {
              combined.push(norm);
            }
          });
          return combined;
        }
      } catch (e) {}
    }

    return all;
  }

  function getCurrentVariant() {
    const variantIdInput = document.getElementById('pp-variant-id');
    const variantId = variantIdInput ? variantIdInput.value : null;
    const variantsJson = document.getElementById('pp-variants-json');

    if (variantsJson && variantId) {
      try {
        const list = JSON.parse(variantsJson.textContent || '[]');
        const matched = list.find(v => String(v.id) === String(variantId));
        if (matched) return matched;
      } catch (e) {}
    }

    // Fallback reading
    const priceEl = document.getElementById('pp-price');
    const priceCents = priceEl ? parseInt(priceEl.getAttribute('data-inr-price'), 10) : 0;
    const skuEl = document.getElementById('pp-sku');
    const sku = skuEl ? skuEl.textContent.trim() : '';

    return {
      id: variantId,
      price: priceCents,
      sku: sku,
      available: true
    };
  }

  function checkCategoryEligibility(coupon, variant) {
    if (!coupon) return false;
    const sku = (variant?.sku || document.getElementById('pp-sku')?.textContent || '').trim().toUpperCase();
    const skuPrefix = sku.match(/^[A-Z]+/)?.[0] || '';

    // Check excluded categories
    if (coupon.excluded_categories && coupon.excluded_categories.length > 0) {
      if (skuPrefix && coupon.excluded_categories.includes(skuPrefix)) {
        return false;
      }
    }

    // Check eligible categories
    if (coupon.eligible_categories && coupon.eligible_categories.length > 0) {
      if (skuPrefix && !coupon.eligible_categories.includes(skuPrefix)) {
        return false;
      }
    }

    return true;
  }

  // Smooth number counting animation
  function animatePriceNumber(element, startCents, endCents, durationMs = 450) {
    if (!element) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || durationMs <= 0) {
      element.innerHTML = formatPriceINR(endCents);
      return;
    }

    const startTime = performance.now();
    const diff = endCents - startCents;

    element.classList.add('pp-price-animating');

    function step(now) {
      const elapsed = now - startTime;
      const progress = Math.min(elapsed / durationMs, 1);
      const ease = 1 - Math.pow(1 - progress, 3);
      const current = Math.round(startCents + (diff * ease));

      element.innerHTML = formatPriceINR(current);

      if (progress < 1) {
        requestAnimationFrame(step);
      } else {
        element.innerHTML = formatPriceINR(endCents);
        setTimeout(() => {
          element.classList.remove('pp-price-animating');
        }, 100);
      }
    }

    requestAnimationFrame(step);
  }

  // Evaluate discount per CRM rules and Critical Pricing Rule
  function evaluateDiscountForVariant(coupon, variant) {
    if (!coupon || !variant || !variant.price) {
      return {
        isEligible: false,
        isDeterminable: false,
        discountAmount: 0,
        discountCents: 0,
        finalPriceCents: variant ? variant.price : 0,
        reason: 'Invalid variant or coupon'
      };
    }

    const originalPrice = variant.price / 100;

    // 1. Category check
    if (!checkCategoryEligibility(coupon, variant)) {
      return {
        isEligible: false,
        isDeterminable: false,
        discountAmount: 0,
        discountCents: 0,
        finalPriceCents: variant.price,
        reason: 'Not eligible for this jewellery category'
      };
    }

    // 2. Minimum order requirement check
    if (coupon.min_order_value && coupon.min_order_value > 0 && originalPrice < coupon.min_order_value) {
      return {
        isEligible: false,
        isDeterminable: false,
        discountAmount: 0,
        discountCents: 0,
        finalPriceCents: variant.price,
        shortfallRs: Math.ceil(coupon.min_order_value - originalPrice),
        reason: `Requires minimum order of ₹${coupon.min_order_value.toLocaleString('en-IN')}`
      };
    }

    let discountAmount = 0;

    // 3. Diamond-Only Discount check (e.g. TEST-30)
    if (coupon.is_diamond_only || coupon.discount_target === 'diamond_only') {
      // 1. Get the diamond value from the variant metafields JSON already on the page
      const diamondValue = getVariantDiamondValue(variant.id);
      let percent = parseFloat(coupon.diamond_discount_percent || 0);
      if (percent <= 0 && coupon.value) {
        const v = parseFloat(coupon.value);
        percent = v <= 1 ? v * 100 : v;
      } else if (percent > 0 && percent <= 1) {
        percent = percent * 100;
      }

      // 2. Calculate discount solely on diamond portion
      if (diamondValue > 0 && percent > 0) {
        discountAmount = (diamondValue * percent) / 100;
        const discountCents = Math.round(discountAmount * 100);
        return {
          isEligible: true,
          isDeterminable: true,
          discountAmount: discountAmount,
          discountCents: discountCents,
          finalPriceCents: Math.max(0, variant.price - discountCents),
          savingsLabel: `Save ${formatPriceINR(discountCents)} (${percent}% OFF Diamond Value)`,
          reason: ''
        };
      } else if (diamondValue === 0) {
        return {
          isEligible: false,
          isDeterminable: false,
          discountAmount: 0,
          discountCents: 0,
          finalPriceCents: variant.price,
          reason: 'This coupon is valid only on diamond jewellery'
        };
      } else {
        return {
          isEligible: true,
          isDeterminable: false,
          discountAmount: 0,
          discountCents: 0,
          finalPriceCents: variant.price,
          savingsLabel: `${percent}% OFF Diamond Value at Checkout`,
          reason: 'Discount applies to diamond value at checkout'
        };
      }
    }

    // 4. Standard coupon on entire price (e.g. WEL-D10)
    if (coupon.type === 'percentage' || (!coupon.type && coupon.value)) {
      const val = parseFloat(coupon.value) || 0;
      const percent = val <= 1 ? val * 100 : val;
      if (percent > 0 && percent <= 100) {
        discountAmount = originalPrice * (val <= 1 ? val : val / 100);
        const discountCents = Math.round(discountAmount * 100);
        return {
          isEligible: true,
          isDeterminable: true,
          discountAmount: discountAmount,
          discountCents: discountCents,
          finalPriceCents: Math.max(0, variant.price - discountCents),
          savingsLabel: `Save ${formatPriceINR(discountCents)} (${percent}% OFF)`,
          reason: ''
        };
      }
    } else if (coupon.type === 'fixed_amount' || coupon.type === 'fixed') {
      discountAmount = parseFloat(coupon.value) || 0;
      const discountCents = Math.round(discountAmount * 100);
      return {
        isEligible: true,
        isDeterminable: true,
        discountAmount: discountAmount,
        discountCents: Math.min(variant.price, discountCents),
        finalPriceCents: Math.max(0, variant.price - discountCents),
        savingsLabel: `Save ${formatPriceINR(discountCents)}`,
        reason: ''
      };
    }

    return {
      isEligible: true,
      isDeterminable: false,
      discountAmount: 0,
      discountCents: 0,
      finalPriceCents: variant.price,
      savingsLabel: 'Discount verified for checkout',
      reason: ''
    };
  }

  // Update PDP UI based strictly on CRM coupons
  function updatePdpPriceUI(shouldAnimate = false, explicitVariant = null) {
    const variant = explicitVariant || getCurrentVariant();
    const priceEl = document.getElementById('pp-price');
    const struckPriceEl = document.getElementById('pp-price-original-struck');
    const triggerBtn = document.getElementById('pp-apply-coupon-trigger');
    const triggerText = document.getElementById('pp-apply-coupon-text');
    const triggerBadge = document.getElementById('pp-coupon-btn-badge');
    const removeBtn = document.getElementById('pp-coupon-quick-remove');
    const calloutBox = document.getElementById('pp-coupon-applied-callout');
    const savingsTag = document.getElementById('pp-coupon-savings-tag');
    const savingsNote = document.getElementById('pp-coupon-savings-explanation');

    if (!priceEl || !variant) return;

    currentAppliedCode = getStoredCoupon();
    const coupons = getVariantCoupons(variant.id);
    const appliedCoupon = currentAppliedCode ? coupons.find(c => c.code.toUpperCase() === currentAppliedCode.toUpperCase()) : null;

    if (appliedCoupon && currentAppliedCode) {
      const evalResult = evaluateDiscountForVariant(appliedCoupon, variant);

      // Trigger button state
      if (triggerBtn) {
        triggerBtn.classList.add('is-applied');
        if (triggerText) triggerText.textContent = appliedCoupon.code;
        if (triggerBadge) {
          triggerBadge.textContent = 'APPLIED ✓';
          triggerBadge.style.display = 'inline-flex';
        }
      }
      if (removeBtn) removeBtn.style.display = 'inline-flex';

      // Price Display
      if (evalResult.isEligible && evalResult.isDeterminable && evalResult.discountCents > 0) {
        const originalPrice = variant.price / 100;
        const finalPrice = evalResult.finalPriceCents / 100;

        if (struckPriceEl) {
          struckPriceEl.classList.add('pp-price--original');
          struckPriceEl.innerHTML = formatPriceINR(variant.price);
          struckPriceEl.style.display = 'inline-block';

          priceEl.classList.add('is-discounted', 'pp-price--discounted');
          const startCents = shouldAnimate ? variant.price : evalResult.finalPriceCents;
          animatePriceNumber(priceEl, startCents, evalResult.finalPriceCents, shouldAnimate ? 450 : 0);
        } else {
          // Slash the price and update DOM directly
          priceEl.classList.add('is-discounted');
          priceEl.innerHTML = `
            <span class="pp-price--discounted">Rs. ${finalPrice.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</span>
            <span class="pp-price--original" style="text-decoration: line-through; color: #888; margin-left: 8px;">
              Rs. ${originalPrice.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
            </span>
          `;
        }

        if (calloutBox) calloutBox.style.display = 'flex';
        if (savingsTag) savingsTag.innerHTML = `✓ ${appliedCoupon.code} Applied (${evalResult.savingsLabel})`;
        if (savingsNote) savingsNote.textContent = 'Discount confirmed for this piece. Reflected at checkout.';
        if (window.DiamondSale && typeof window.DiamondSale.onCouponChange === 'function') {
          window.DiamondSale.onCouponChange(variant, appliedCoupon);
        }
      } else {
        // Ineligible or Cart-level: Keep original price per CRITICAL PRICING RULE
        if (struckPriceEl) {
          struckPriceEl.style.display = 'none';
          struckPriceEl.classList.remove('pp-price--original');
        }
        priceEl.classList.remove('is-discounted', 'pp-price--discounted');
        priceEl.innerHTML = formatPriceINR(variant.price);

        if (calloutBox) calloutBox.style.display = 'flex';
        if (savingsTag) savingsTag.innerHTML = `🏷️ ${appliedCoupon.code} Saved`;
        if (savingsNote) {
          if (!evalResult.isEligible && evalResult.shortfallRs) {
            savingsNote.textContent = `Add ₹${evalResult.shortfallRs.toLocaleString('en-IN')} more to your cart to activate discount at checkout.`;
          } else if (evalResult.reason) {
            savingsNote.textContent = evalResult.reason;
          } else {
            savingsNote.textContent = 'Special discount code applied. Final total confirmed in cart & checkout.';
          }
        }
      }
    } else {
      // No valid CRM coupon applied
      if (triggerBtn) {
        triggerBtn.classList.remove('is-applied');
        if (triggerText) triggerText.textContent = 'Apply Coupon';
        if (triggerBadge) triggerBadge.style.display = 'none';
      }
      if (removeBtn) removeBtn.style.display = 'none';
      if (struckPriceEl) {
        struckPriceEl.style.display = 'none';
        struckPriceEl.classList.remove('pp-price--original');
      }

      priceEl.classList.remove('is-discounted', 'pp-price--discounted');
      priceEl.innerHTML = formatPriceINR(variant.price);
      if (calloutBox) calloutBox.style.display = 'none';

      if (window.DiamondSale && typeof window.DiamondSale.onCouponChange === 'function') {
        window.DiamondSale.onCouponChange(variant, null);
      }
    }
  }

  // Render modal list strictly with CRM records
  function renderModalList() {
    const container = document.getElementById('PdpCouponListContainer');
    if (!container) return;

    const variant = getCurrentVariant();
    const coupons = getVariantCoupons(variant ? variant.id : null);
    const appliedCode = getStoredCoupon();

    if (!coupons || coupons.length === 0) {
      container.innerHTML = `
        <div class="pdp-coupon-empty-state">
          <svg class="pdp-coupon-empty-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
            <line x1="7" y1="7" x2="7.01" y2="7"></line>
          </svg>
          <div class="pdp-coupon-empty-title">No coupons available for this product right now.</div>
          <p class="pdp-coupon-empty-desc">Check back soon for exclusive promotions from Swastik Jewels.</p>
        </div>
      `;
      return;
    }

    let html = '';
    coupons.forEach(coupon => {
      const isApplied = appliedCode && appliedCode.toUpperCase() === coupon.code.toUpperCase();
      const evalResult = variant ? evaluateDiscountForVariant(coupon, variant) : { isEligible: true };

      let discountText = '';
      if ((coupon.is_diamond_only || coupon.discount_target === 'diamond_only') && (coupon.diamond_discount_percent || coupon.value)) {
        const pct = coupon.diamond_discount_percent || (coupon.value <= 1 ? coupon.value * 100 : coupon.value);
        discountText = `${pct}% OFF DIAMOND`;
      } else if (coupon.type === 'percentage') {
        discountText = `${coupon.value}% OFF`;
      } else {
        discountText = `₹${parseFloat(coupon.value || 0).toLocaleString('en-IN')} OFF`;
      }

      // ONLY use CRM description or title
      const descText = coupon.short_description || coupon.title || '';
      let conditionText = '';
      let isUnmet = false;

      if (!evalResult.isEligible && evalResult.reason) {
        conditionText = evalResult.reason;
        isUnmet = true;
      } else if (coupon.min_order_value && coupon.min_order_value > 0) {
        conditionText = `Valid on orders above ₹${coupon.min_order_value.toLocaleString('en-IN')}`;
      }

      const expiryText = coupon.expiry_date ? `Valid till ${coupon.expiry_date}` : '';

      let cardClass = 'pdp-coupon-card';
      if (isApplied) cardClass += ' is-applied-card';
      else if (!evalResult.isEligible) cardClass += ' is-ineligible-card';

      html += `
        <div class="${cardClass}">
          <div class="pdp-coupon-card-left">
            <div class="pdp-coupon-card-header-row">
              <span class="pdp-coupon-card-discount">${discountText}</span>
              ${isApplied ? '<span class="pdp-coupon-status-tag is-applied">APPLIED ✓</span>' : (!evalResult.isEligible ? '<span class="pdp-coupon-status-tag is-ineligible">RESTRICTED</span>' : '')}
            </div>
            ${descText ? `<div class="pdp-coupon-card-desc">${descText}</div>` : ''}
            ${conditionText ? `<div class="pdp-coupon-card-condition ${isUnmet ? 'is-unmet' : ''}">${conditionText}</div>` : ''}
            ${expiryText ? `<div class="pdp-coupon-card-expiry">${expiryText}</div>` : ''}
          </div>
          <div class="pdp-coupon-card-right">
            <div class="pdp-coupon-code-pill">${coupon.code}</div>
            ${isApplied ? `
              <button type="button" class="pdp-card-action-btn is-applied js-pdp-coupon-remove" data-code="${coupon.code}" aria-label="Remove coupon ${coupon.code}">
                <span>REMOVE</span>
              </button>
            ` : (evalResult.isEligible ? `
              <button type="button" class="pdp-card-action-btn js-pdp-coupon-apply" data-code="${coupon.code}" aria-label="Apply coupon ${coupon.code}">
                <span>APPLY</span>
              </button>
            ` : `
              <button type="button" class="pdp-card-action-btn is-disabled" disabled aria-label="Coupon ${coupon.code} not eligible">
                <span>APPLY</span>
              </button>
            `)}
          </div>
        </div>
      `;
    });

    container.innerHTML = html;
  }

  function showAlertMessage(msg, type = 'success') {
    const alertEl = document.getElementById('PdpCouponAlertMsg');
    if (!alertEl) return;
    alertEl.textContent = msg;
    alertEl.className = 'pdp-coupon-alert-msg ' + (type === 'error' ? 'is-error' : 'is-success');
    alertEl.style.display = 'block';

    setTimeout(() => {
      alertEl.style.display = 'none';
    }, 4000);
  }

  function openPdpModal() {
    const overlay = document.getElementById('PdpCouponModalOverlay');
    if (!overlay) return;

    // Ensure site coupon popup is closed if open
    if (typeof window.closeSiteCouponPopup === 'function') {
      const siteOverlay = document.getElementById('SiteCouponOverlay');
      if (siteOverlay && siteOverlay.classList.contains('is-active')) {
        window.closeSiteCouponPopup();
      }
    }

    renderModalList();

    const input = document.getElementById('PdpManualCouponInput');
    if (input) input.value = '';

    const alertEl = document.getElementById('PdpCouponAlertMsg');
    if (alertEl) alertEl.style.display = 'none';

    overlay.style.display = 'flex';
    void overlay.offsetWidth;
    overlay.classList.add('is-active');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';

    const drawer = document.getElementById('PdpCouponDrawer');
    if (drawer) drawer.focus();
  }

  function closePdpModal() {
    const overlay = document.getElementById('PdpCouponModalOverlay');
    if (!overlay) return;

    overlay.classList.remove('is-active');
    overlay.setAttribute('aria-hidden', 'true');

    // Only restore body scrolling if the site coupon overlay is not currently open
    const siteOverlay = document.getElementById('SiteCouponOverlay');
    if (!siteOverlay || !siteOverlay.classList.contains('is-active')) {
      document.body.style.overflow = '';
    }

    setTimeout(() => {
      if (!overlay.classList.contains('is-active')) {
        overlay.style.display = 'none';
      }
    }, 350);

    const triggerBtn = document.getElementById('pp-apply-coupon-trigger');
    if (triggerBtn) triggerBtn.focus();
  }

  // Application Flow: Saves verified CRM code, sets storefront cookie, passes to checkout
  function applyCouponCode(code, sourceBtn) {
    if (!code || typeof code !== 'string') return;
    const cleanCode = code.trim().toUpperCase();
    if (!cleanCode) return;

    const variant = getCurrentVariant();
    const coupons = getVariantCoupons(variant ? variant.id : null);
    const matchedCoupon = coupons.find(c => c.code.toUpperCase() === cleanCode);

    if (!matchedCoupon) {
      showAlertMessage(`Coupon code "${cleanCode}" is invalid or not available for this product.`, 'error');
      return;
    }

    const evalResult = evaluateDiscountForVariant(matchedCoupon, variant);
    if (!evalResult.isEligible) {
      showAlertMessage(evalResult.reason || 'This coupon is not eligible for this item.', 'error');
      return;
    }

    if (sourceBtn) {
      sourceBtn.setAttribute('disabled', 'true');
      const span = sourceBtn.querySelector('span');
      if (span) span.textContent = '...';
    }

    // Save to localStorage/sessionStorage & cookie for checkout
    setStoredCoupon(cleanCode);

    // Update PDP Price Transition smoothly
    updatePdpPriceUI(true);

    if (typeof window.showSwastikToast === 'function') {
      window.showSwastikToast(
        'Coupon Applied!',
        `Code ${cleanCode} has been applied to your order.`,
        false
      );
    }

    closePdpModal();

    if (sourceBtn) {
      sourceBtn.removeAttribute('disabled');
      const span = sourceBtn.querySelector('span');
      if (span) span.textContent = 'APPLY';
    }
  }

  function removeCouponCode() {
    setStoredCoupon('');
    updatePdpPriceUI(true);

    if (typeof window.showSwastikToast === 'function') {
      window.showSwastikToast('Coupon Removed', 'The coupon code has been removed.', false);
    }

    closePdpModal();
  }

  function initEvents() {
    document.addEventListener('click', function(e) {
      const trigger = e.target.closest('#pp-apply-coupon-trigger');
      if (trigger) {
        e.preventDefault();
        openPdpModal();
        return;
      }

      const quickRemove = e.target.closest('#pp-coupon-quick-remove');
      if (quickRemove) {
        e.preventDefault();
        removeCouponCode();
        return;
      }

      const closeBtn = e.target.closest('#PdpCouponCloseBtn');
      if (closeBtn) {
        e.preventDefault();
        closePdpModal();
        return;
      }

      const backdrop = e.target.closest('#PdpCouponBackdrop');
      if (backdrop) {
        e.preventDefault();
        closePdpModal();
        return;
      }

      const cardApplyBtn = e.target.closest('.js-pdp-coupon-apply');
      if (cardApplyBtn) {
        e.preventDefault();
        const code = cardApplyBtn.getAttribute('data-code');
        applyCouponCode(code, cardApplyBtn);
        return;
      }

      const cardRemoveBtn = e.target.closest('.js-pdp-coupon-remove');
      if (cardRemoveBtn) {
        e.preventDefault();
        removeCouponCode();
        return;
      }

      const manualBtn = e.target.closest('#PdpManualApplyBtn');
      if (manualBtn) {
        e.preventDefault();
        const input = document.getElementById('PdpManualCouponInput');
        if (!input || !input.value.trim()) {
          showAlertMessage('Please enter a valid coupon code.', 'error');
          return;
        }
        applyCouponCode(input.value.trim(), manualBtn);
        return;
      }
    });

    const manualInput = document.getElementById('PdpManualCouponInput');
    if (manualInput) {
      manualInput.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          const applyBtn = document.getElementById('PdpManualApplyBtn');
          if (applyBtn) applyBtn.click();
        }
      });
    }

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' || e.keyCode === 27) {
        const overlay = document.getElementById('PdpCouponModalOverlay');
        if (overlay && overlay.classList.contains('is-active')) {
          closePdpModal();
        }
      }

      const overlay = document.getElementById('PdpCouponModalOverlay');
      if (overlay && overlay.classList.contains('is-active') && e.key === 'Tab') {
        const focusable = overlay.querySelectorAll('button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])');
        if (focusable.length > 0) {
          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      }
    });
  }

  // Public API
  window.pdpCouponController = {
    init: function() {
      loadCrmCoupons();
      updatePdpPriceUI(false);
      initEvents();
    },
    onVariantChange: function(matchedVariant) {
      loadCrmCoupons(true);
      updatePdpPriceUI(true, matchedVariant);
      const overlay = document.getElementById('PdpCouponModalOverlay');
      if (overlay && overlay.classList.contains('is-active')) {
        renderModalList();
      }
    },
    openModal: openPdpModal,
    closeModal: closePdpModal,
    applyCoupon: applyCouponCode,
    removeCoupon: removeCouponCode,
    getAvailableCoupons: function(variantId) {
      return getVariantCoupons(variantId);
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      window.pdpCouponController.init();
    });
  } else {
    window.pdpCouponController.init();
  }
})();
</script>
