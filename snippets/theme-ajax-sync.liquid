{% doc %}
  Global theme script to manage card click behavior, AJAX add-to-cart,
  wishlist toggle synchronization, and visual toast notifications.

  @example
  {% render 'theme-ajax-sync' %}
{% enddoc %}

<style>
  /* Premium Toast Notification Styling (Swastik Jewels Luxury) */
  .toast-container {
    position: fixed;
    top: 24px;
    right: 24px;
    z-index: 9999999;
    display: flex;
    flex-direction: column;
    gap: 12px;
    pointer-events: none;
    max-width: calc(100vw - 32px);
  }

  .toast-item {
    background: radial-gradient(circle at 10% 10%, rgba(18, 64, 55, 0.96) 0%, rgba(3, 28, 24, 0.98) 100%);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(135, 195, 165, 0.28);
    color: #FFFFFF;
    padding: 18px 20px;
    border-radius: 18px;
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.42), 0 0 24px rgba(1, 63, 62, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.12);
    display: flex;
    align-items: flex-start;
    gap: 14px;
    width: 390px;
    max-width: 100%;
    pointer-events: auto;
    box-sizing: border-box;
    transform: translateX(40px) scale(0.96);
    opacity: 0;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.35s ease;
  }

  .toast-item.show {
    transform: translateX(0) scale(1);
    opacity: 1;
  }

  .toast-left {
    flex-shrink: 0;
  }

  .toast-icon-wrap {
    position: relative;
    display: inline-flex;
  }

  .toast-status-dot {
    position: absolute;
    top: -2px;
    right: -2px;
    width: 7px;
    height: 7px;
    background-color: #00E676;
    border-radius: 50%;
    box-shadow: 0 0 8px #00E676, 0 0 2px #FFFFFF;
    z-index: 2;
  }

  .toast-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: rgba(4, 40, 34, 0.85);
    border: 1px solid rgba(130, 200, 160, 0.3);
    color: #E2CE9F;
    flex-shrink: 0;
  }

  .toast-content {
    flex: 1;
    min-width: 0;
  }

  .toast-header-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 4px;
  }

  .toast-title {
    font-family: 'Outfit', 'Montserrat', sans-serif;
    font-size: 15.5px;
    font-weight: 600;
    color: #FFFFFF;
    margin: 0;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .toast-close {
    background: transparent;
    border: none;
    color: #FFFFFF;
    opacity: 0.5;
    cursor: pointer;
    padding: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s ease, transform 0.2s ease;
    border-radius: 4px;
    margin-top: -2px;
    margin-right: -4px;
  }

  .toast-close:hover {
    opacity: 1;
    transform: scale(1.1);
  }

  .toast-message {
    font-family: 'Inter', sans-serif;
    font-size: 12.5px;
    color: #D6E4E0;
    margin: 0 0 3px 0;
    line-height: 1.42;
    font-weight: 400;
  }

  .toast-hint {
    font-family: 'Inter', sans-serif;
    font-size: 11.5px;
    color: #8DA89F;
    margin: 0 0 10px 0;
    line-height: 1.35;
    font-weight: 400;
  }

  .toast-action-row {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    margin-top: 6px;
  }

  .toast-link-action {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: #E2BF7D;
    font-family: 'Inter', sans-serif;
    font-size: 12.5px;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid rgba(226, 191, 125, 0.45);
    padding-bottom: 1px;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .toast-link-action:hover {
    color: #FFFFFF;
    border-color: #FFFFFF;
    transform: translateX(2px);
  }

  @media (max-width: 600px) {
    .toast-container {
      top: 16px;
      right: 14px;
      left: 14px;
      align-items: center;
    }

    .toast-item {
      width: 100%;
      max-width: 400px;
      padding: 16px;
      border-radius: 16px;
      transform: translateY(-20px) scale(0.96);
    }

    .toast-item.show {
      transform: translateY(0) scale(1);
      opacity: 1;
    }
  }

  /* Add cursor styles to cards */
  .best-sellers__card,
  .new-arrivals__card {
    cursor: pointer;
  }

  /* Reset cursor for interactive components in card */
  .best-sellers__card button,
  .best-sellers__card a,
  .best-sellers__card .dot,
  .new-arrivals__card button,
  .new-arrivals__card a,
  .new-arrivals__card .dot {
    cursor: auto;
  }
  
  .best-sellers__wishlist-btn,
  .new-arrivals__wishlist-btn,
  .btn-add-cart,
  .btn-quick-view,
  .dot {
    cursor: pointer !important;
  }

  /* loading state for add to cart button */
  .btn-add-cart.btn-loading {
    opacity: 0.7;
    pointer-events: none;
    position: relative;
  }
  
  .btn-add-cart.btn-loading::after {
    content: "";
    position: absolute;
    width: 16px;
    height: 16px;
    top: 50%;
    left: 50%;
    margin-top: -8px;
    margin-left: -8px;
    border: 2px solid transparent;
    border-top-color: currentColor;
    border-radius: 50%;
    animation: toast-spinner 0.6s linear infinite;
  }

  @keyframes toast-spinner {
    to { transform: rotate(360deg); }
  }
  
  /* Make heart filled and red when active */
  .best-sellers__wishlist-btn.active svg,
  .new-arrivals__wishlist-btn.active svg,
  .product-single__wishlist-btn.active svg,
  .product-card-ui__wishlist.active svg {
    fill: #E25C5C !important;
    stroke: #E25C5C !important;
  }
</style>

<div class="toast-container" id="toast-container"></div>

<script>
  window.themeFallbackImage = '{{ "fallback-image.png" | asset_url }}';
  (function() {
    // 1. Initialize Mock Wishlist & Cart from initial values in header badges
    const wishlistBadge = document.getElementById('wishlist-count-badge');
    const cartBadge = document.getElementById('cart-count-badge');

    // Helper functions to update Badges
    window.updateWishlistBadge = function() {
      if (!wishlistBadge) return;
      const count = wishlist.length;
      wishlistBadge.innerText = count;
      wishlistBadge.style.display = count > 0 ? 'inline-flex' : 'none';
    };

    window.updateCartBadge = function() {
      // The cart badge is owned by the real Shopify cart.
      // Header renders cart.item_count server-side and window.updateGlobalCartCount
      // updates it after every real cart operation. Kept as a no-op for
      // backwards compatibility with any older inline handlers.
    };

    // Wishlist Initialization
    let wishlist = [];
    try {
      const storedWishlist = localStorage.getItem('wishlist');
      if (storedWishlist) {
        let parsed = JSON.parse(storedWishlist);
        // Clean up any mock data from previous bug
        wishlist = parsed.filter(id => !id.toString().startsWith('mock-id-'));
        if (wishlist.length !== parsed.length) {
          localStorage.setItem('wishlist', JSON.stringify(wishlist));
        }
      }
    } catch(e) {
      console.error('Local storage error: ', e);
    }
    window.updateWishlistBadge();

    // Cart count is rendered server-side from cart.item_count in the header and
    // kept in sync via window.updateGlobalCartCount after every real cart action.
    // No localStorage "mock" cart is used anymore.

    // Set initial active state of wishlist heart buttons on load
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('[data-product-id]').forEach(card => {
        const id = card.getAttribute('data-product-id');
        if (wishlist.includes(id)) {
          const heart = card.querySelector('.best-sellers__wishlist-btn, .new-arrivals__wishlist-btn, .product-single__wishlist-btn, .product-card-ui__wishlist');
          if (heart) heart.classList.add('active');
        }
      });
    });



    // 2. Global Toast Notification Generator (Swastik Jewels Luxury)
    window.showSwastikToast = function(title, message, isCart = false, extraHint = '', ctaText = 'View Cart & Checkout >') {
      const container = document.getElementById('toast-container');
      if (!container) return;

      const toast = document.createElement('div');
      toast.className = 'toast-item';
      
      const iconSVG = isCart 
        ? `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#E2CE9F" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>`
        : `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#E2CE9F" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>`;

      toast.innerHTML = `
        <div class="toast-left">
          <div class="toast-icon-wrap">
            <span class="toast-status-dot"></span>
            <div class="toast-icon">
              ${iconSVG}
            </div>
          </div>
        </div>
        <div class="toast-content">
          <div class="toast-header-row">
            <h4 class="toast-title">${title}</h4>
            <button type="button" class="toast-close" aria-label="Dismiss notification">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
          </div>
          ${message ? `<p class="toast-message">${message}</p>` : ''}
          ${extraHint ? `<p class="toast-hint">${extraHint}</p>` : ''}
          ${isCart ? `
            <div class="toast-action-row">
              <a href="/cart" class="toast-link-action">
                <span>${ctaText || 'View Cart & Checkout >'}</span>
              </a>
            </div>
          ` : ''}
        </div>
      `;

      let autoRemoveTimer = null;
      let cleanupTimer = null;

      function dismissToast(immediate = false) {
        if (autoRemoveTimer) clearTimeout(autoRemoveTimer);
        if (cleanupTimer) clearTimeout(cleanupTimer);
        if (immediate) {
          if (toast.parentElement) toast.remove();
          return;
        }
        toast.classList.remove('show');
        cleanupTimer = setTimeout(() => {
          if (toast.parentElement) toast.remove();
        }, 300);
      }

      // Close handler
      const closeBtn = toast.querySelector('.toast-close');
      if (closeBtn) {
        closeBtn.addEventListener('click', (e) => {
          e.preventDefault();
          dismissToast(false);
        });
      }

      // Action link click (e.g. "View Cart & Checkout >")
      const actionLink = toast.querySelector('.toast-link-action');
      if (actionLink) {
        actionLink.addEventListener('click', () => {
          dismissToast(true);
        });
      }

      container.appendChild(toast);

      // Trigger animation
      setTimeout(() => {
        toast.classList.add('show');
      }, 40);

      // Remove after 5 seconds
      autoRemoveTimer = setTimeout(() => {
        dismissToast(false);
      }, 5000);
    };

    // 3. (Removed JS card-wide click interceptor in favor of native title link pseudo-element for better performance)

    // 4. AJAX Wishlist click interceptor
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('.best-sellers__wishlist-btn, .new-arrivals__wishlist-btn, .product-single__wishlist-btn, .product-card-ui__wishlist');
      if (!btn) return;

      e.preventDefault();
      e.stopPropagation();

      const card = btn.closest('[data-product-id]');
      if (!card) return;

      const productId = card.getAttribute('data-product-id');
      const variantId = card.getAttribute('data-variant-id') || '';
      const url = card.getAttribute('href') || card.getAttribute('data-url') || '#';
      const titleElement = card.querySelector('.best-sellers__card-title, .new-arrivals__card-title, .product-single__title, .product-single__heading, .product-card-ui__title');
      const productTitle = titleElement ? titleElement.innerText.trim() : 'Product';
      
      const priceElement = card.querySelector('.price-current, .price-item--regular');
      const productPrice = priceElement ? priceElement.innerText.trim().replace(/[^0-9.-]+/g,"") * 100 : 0;
      
      const imgElement = card.querySelector('img');
      const productImg = imgElement ? imgElement.src : '';

      btn.classList.toggle('active');

      if (btn.classList.contains('active')) {
        if (!wishlist.includes(productId)) {
          wishlist.push(productId);
          localStorage.setItem('wishlist', JSON.stringify(wishlist));
          
          let detailedWishlist = JSON.parse(localStorage.getItem('wishlist_items_data') || '[]');
          detailedWishlist.push({
            id: productId,
            variant_id: variantId,
            title: productTitle,
            price: productPrice,
            image: productImg,
            url: url
          });
          localStorage.setItem('wishlist_items_data', JSON.stringify(detailedWishlist));
        }
        window.updateWishlistBadge();
        
        if (window.showSwastikToast) {
          showSwastikToast('Added to Wishlist', `${productTitle} has been saved to your likes.`, false);
        }
      } else {
        wishlist = wishlist.filter(id => id !== productId);
        localStorage.setItem('wishlist', JSON.stringify(wishlist));
        
        let detailedWishlist = JSON.parse(localStorage.getItem('wishlist_items_data') || '[]');
        detailedWishlist = detailedWishlist.filter(item => item.id !== productId);
        localStorage.setItem('wishlist_items_data', JSON.stringify(detailedWishlist));

        window.updateWishlistBadge();
        
        if (window.renderDrawerContent && document.getElementById('SidebarDrawer') && document.getElementById('SidebarDrawer').classList.contains('open')) {
          window.renderDrawerContent();
        }
        // User requested not to show the removed toast
      }
    });

    // 5. AJAX Add to Cart interceptor — uses the REAL Shopify cart with duplicate prevention.
    document.addEventListener('submit', (e) => {
      const form = e.target;

      // Only intercept product add-to-cart forms.
      const isCartForm = form.action.includes('/cart/add') || form.querySelector('[name="id"]') !== null;
      if (!isCartForm) return;

      e.preventDefault();

      const submitBtn = e.submitter || form.querySelector('[type="submit"], .btn-add-cart, .pp-btn-add') || (form.id ? document.querySelector('button[form="' + form.id + '"]') : null);

      // Prevent concurrent/rapid duplicate requests
      if (form.dataset.submitting === 'true' || (submitBtn && submitBtn.classList.contains('btn-loading'))) {
        return;
      }

      const formData = new FormData(form);
      const variantId = formData.get('id');

      form.dataset.submitting = 'true';
      if (submitBtn) submitBtn.classList.add('btn-loading');

      const rootUrl = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';

      // Verify current cart state from server to prevent duplicate variant additions
      fetch(rootUrl + 'cart.js', { cache: 'no-store' })
        .then(res => res.json())
        .then(cart => {
          const isAlreadyInCart = variantId && cart.items && cart.items.some(item => String(item.variant_id || item.id) === String(variantId));

          if (isAlreadyInCart) {
            form.dataset.submitting = 'false';
            if (submitBtn) submitBtn.classList.remove('btn-loading');
            if (window.updateGlobalCartCount) window.updateGlobalCartCount(cart.item_count);
            
            if (window.showSwastikToast) {
              window.showSwastikToast(
                'Already Added to Cart',
                '',
                true,
                '',
                'View Cart & Checkout >'
              );
            }
            return;
          }

          // Not present in cart — proceed with standard add
          return fetch(rootUrl + 'cart/add.js', {
            method: 'POST',
            headers: { 'Accept': 'application/json' },
            body: formData
          })
          .then(response => response.json().then(data => ({ ok: response.ok, data: data })))
          .then(result => {
            // If Shopify rejected the add (e.g. sold out, no variant selected), surface the real reason.
            if (!result.ok) throw result.data;
            // Re-read the real cart so the badge and drawer always match checkout.
            return fetch(rootUrl + 'cart.js', { cache: 'no-store' }).then(r => r.json());
          })
          .then(newCart => {
            form.dataset.submitting = 'false';
            if (submitBtn) submitBtn.classList.remove('btn-loading');
            if (window.updateGlobalCartCount) window.updateGlobalCartCount(newCart.item_count);
            if (window.openCartDrawer) window.openCartDrawer();
          });
        })
        .catch(err => {
          form.dataset.submitting = 'false';
          if (submitBtn) submitBtn.classList.remove('btn-loading');
          const message = (err && err.description) ? err.description : 'Sorry, this item could not be added. Please try again.';
          if (window.showSwastikToast) {
            showSwastikToast('Unable to add', message, false);
          }
        });
    });

    // 6. Header and Mobile Triggers for Drawer (using event delegation for reliability)
    document.addEventListener('click', (e) => {
      const wishlistTrigger = e.target.closest('.header__wishlist-trigger, .js-mobile-wishlist-trigger');
      if (wishlistTrigger) {
        e.preventDefault();
        if (window.openWishlistDrawer) window.openWishlistDrawer();
        return;
      }

      const cartTrigger = e.target.closest('.header__cart-trigger, .js-mobile-cart-trigger');
      if (cartTrigger) {
        e.preventDefault();
        if (window.openCartDrawer) window.openCartDrawer();
        return;
      }
    });

    // 7. Buy It Now button behavior
    document.addEventListener('click', (e) => {
      const buyNowBtn = e.target.closest('.btn-buy-now');
      if (buyNowBtn) {
        e.preventDefault();
        const form = buyNowBtn.closest('form');
        if (form) {
          const returnInput = document.createElement('input');
          returnInput.type = 'hidden';
          returnInput.name = 'return_to';
          returnInput.value = '/checkout';
          form.appendChild(returnInput);
          form.submit();
        }
      }
    });

    // 8. Centralized Checkout Protection
    const customerLoggedIn = {% if customer %}true{% else %}false{% endif %};
    
    if (!customerLoggedIn) {
      // Intercept clicks on links or buttons pointing to checkout
      document.addEventListener('click', function(e) {
        const target = e.target.closest('a[href*="/checkout"], button[name="checkout"], .btn-checkout, .pp-btn-buy, .btn-buy-now');
        if (target) {
          e.preventDefault();
          e.stopPropagation();
          handleCheckoutInterception(target);
        }
      }, true);

      // Intercept form submissions going to checkout
      document.addEventListener('submit', function(e) {
        const form = e.target;
        const isCheckoutSubmit = form.action.includes('/checkout') || 
                                 form.querySelector('input[name="return_to"]')?.value === '/checkout' ||
                                 e.submitter?.name === 'checkout' ||
                                 e.submitter?.classList.contains('btn-checkout');
        if (isCheckoutSubmit) {
          e.preventDefault();
          e.stopPropagation();
          handleCheckoutInterception(e.submitter || form);
        }
      }, true);
    }

    function handleCheckoutInterception(triggerElement) {
      // Close cart drawer if open
      if (typeof window.closeCartDrawer === 'function') {
        window.closeCartDrawer();
      } else {
        const cartDrawer = document.getElementById('CartDrawer');
        if (cartDrawer) cartDrawer.classList.remove('is-open');
        document.body.style.overflow = '';
      }

      // If it's a "Buy Now" action, add to cart via AJAX first so guest doesn't lose their selection
      const form = triggerElement.closest('form');
      if (form && (triggerElement.classList.contains('pp-btn-buy') || triggerElement.classList.contains('btn-buy-now'))) {
        const submitBtn = triggerElement;
        submitBtn.classList.add('btn-loading');
        
        fetch(window.Shopify.routes.root + 'cart/add.js', {
          method: 'POST',
          body: new FormData(form)
        })
        .then(response => {
          submitBtn.classList.remove('btn-loading');
          triggerLoginAndRedirectCheckout();
        })
        .catch(() => {
          submitBtn.classList.remove('btn-loading');
          triggerLoginAndRedirectCheckout();
        });
        return;
      }

      triggerLoginAndRedirectCheckout();
    }

    function triggerLoginAndRedirectCheckout() {
      // Store intent in sessionStorage for reliable post-login redirection
      sessionStorage.setItem('post_login_redirect', '/checkout');
      
      const accountEl = document.getElementById('storefront-shopify-account');
      if (accountEl) {
        // Dynamically update the sign-in URL redirection parameter (fallback)
        accountEl.setAttribute('sign-in-url', '/customer_authentication/login?return_to=/checkout');

        // Trigger the login overlay via click on the profile icon
        const trigger = accountEl.querySelector('[slot="signed-out-avatar"]');
        if (trigger) {
          trigger.click();
        }
      } else {
        // Fallback redirection to hosted login
        window.location.href = '/customer_authentication/login?return_to=/checkout';
      }
    }

  })();
</script>
