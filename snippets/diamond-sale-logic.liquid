{% comment %}
  Swastik Jewels — Scheduled 30% Diamond Sale Controller & Pre-Sale Warning Logic
  Sale Window: 6 November 2026, 2:00 PM – 6:00 PM IST (Asia/Kolkata, UTC+05:30)
  Discount: 30% on eligible diamond products
  Gateway: Paytm (standard checkout reused, NO Razorpay)
  Architecture: Strictly separates Shopify storefront promotional display from checkout discount enforcement.
{% endcomment %}

{%- assign is_diamond_product = false -%}
{%- if product -%}
  {%- assign p_title_lower = product.title | downcase -%}
  {%- assign p_type_lower = product.type | downcase -%}
  {%- if p_title_lower contains 'diamond' or p_type_lower contains 'diamond' -%}
    {%- assign is_diamond_product = true -%}
  {%- endif -%}
  {%- for tag in product.tags -%}
    {%- assign tag_lower = tag | downcase -%}
    {%- if tag_lower contains 'diamond' or tag_lower == 'diamond-sale' or tag_lower == 'dhanteras-sale' -%}
      {%- assign is_diamond_product = true -%}
    {%- endif -%}
  {%- endfor -%}
  {%- for col in product.collections -%}
    {%- assign col_h = col.handle | downcase -%}
    {%- if col_h contains 'diamond' -%}
      {%- assign is_diamond_product = true -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if product.metafields.custom.diamond_weight != blank -%}
    {%- assign is_diamond_product = true -%}
  {%- endif -%}
  {%- for variant in product.variants -%}
    {%- if variant.metafields.custom.diamond_value != blank and variant.metafields.custom.diamond_value > 0 -%}
      {%- assign is_diamond_product = true -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- assign cart_has_diamond = false -%}
{%- for item in cart.items -%}
  {%- assign item_title_l = item.product.title | downcase -%}
  {%- assign item_type_l = item.product.type | downcase -%}
  {%- if item_title_l contains 'diamond' or item_type_l contains 'diamond' -%}
    {%- assign cart_has_diamond = true -%}
  {%- endif -%}
  {%- for t in item.product.tags -%}
    {%- assign t_l = t | downcase -%}
    {%- if t_l contains 'diamond' or t_l == 'diamond-sale' or t_l == 'dhanteras-sale' -%}
      {%- assign cart_has_diamond = true -%}
    {%- endif -%}
  {%- endfor -%}
  {%- for col in item.product.collections -%}
    {%- assign c_h = col.handle | downcase -%}
    {%- if c_h contains 'diamond' -%}
      {%- assign cart_has_diamond = true -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if item.product.metafields.custom.diamond_weight != blank -%}
    {%- assign cart_has_diamond = true -%}
  {%- endif -%}
  {%- if item.variant.metafields.custom.diamond_value != blank and item.variant.metafields.custom.diamond_value > 0 -%}
    {%- assign cart_has_diamond = true -%}
  {%- endif -%}
{%- endfor -%}

<!-- Server-Authoritative Metadata for Diamond Sale -->
<script id="diamond-sale-config-json" type="application/json">
{
  "serverTimeUnix": {{ 'now' | date: '%s' | times: 1000 }},
  "saleStartIso": "2026-11-06T14:00:00+05:30",
  "saleEndIso": "2026-11-06T18:00:00+05:30",
  "timezone": "Asia/Kolkata",
  "discountPercent": 30,
  "discountCode": "DIAMOND30",
  "isCheckoutDiscountConfigured": true,
  "isProductPage": {% if product %}true{% else %}false{% endif %},
  "isCurrentProductEligible": {{ is_diamond_product | json }},
  "cartHasDiamond": {{ cart_has_diamond | json }},
  "currentVariantId": {{ product.selected_or_first_available_variant.id | default: 'null' }},
  "currentVariantPrice": {{ product.selected_or_first_available_variant.price | default: 'null' }},
  "currentVariantDiamondValue": {{ product.selected_or_first_available_variant.metafields.custom.diamond_value | default: 0 | times: 100 }}
}
</script>

<!-- PRE-SALE ACKNOWLEDGEMENT WARNING MODAL (Appears before Buy Now / Checkout before Nov 6, 2:00 PM IST) -->
<div id="DiamondSalePreSaleModal" class="sw-dia-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="swDiaModalTitle" style="display: none;">
  <div class="sw-dia-modal-backdrop" onclick="window.DiamondSale && window.DiamondSale.closePreSaleWarningModal()"></div>
  <div class="sw-dia-modal-container">
    <button type="button" class="sw-dia-modal-close" aria-label="Close dialog" onclick="window.DiamondSale && window.DiamondSale.closePreSaleWarningModal()">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="sw-dia-modal-header">
      <div class="sw-dia-modal-icon" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
      </div>
      <div class="sw-dia-modal-title-wrap">
        <span class="sw-dia-modal-badge">SCHEDULED FLASH SALE</span>
        <h3 id="swDiaModalTitle" class="sw-dia-modal-title">Upcoming 30% Diamond Sale Notice</h3>
      </div>
    </div>

    <div class="sw-dia-modal-body">
      <div class="sw-dia-schedule-banner">
        <span class="sw-dia-schedule-icon">⏰</span>
        <div class="sw-dia-schedule-text">
          <strong>Official Sale Window:</strong>
          <span>November 6, 2026 &bull; 2:00 PM – 6:00 PM IST</span>
        </div>
      </div>

      <p class="sw-dia-modal-desc">
        This eligible diamond jewellery piece qualifies for our scheduled <strong>30% Diamond Flash Sale</strong>.
        Because you are purchasing <strong>before the sale begins</strong>, the checkout order will be billed at the <strong>current original price</strong>.
      </p>

      <div class="sw-dia-price-comparison-box">
        <div class="sw-dia-comp-col">
          <span class="sw-dia-comp-label">Upcoming Sale Price</span>
          <span class="sw-dia-comp-sub">(Nov 6, 2–6 PM IST)</span>
          <span class="sw-dia-comp-val sw-dia-comp-val--promo" id="swDiaModalPromoPrice">Rs. 0.00</span>
        </div>
        <div class="sw-dia-comp-divider">vs</div>
        <div class="sw-dia-comp-col sw-dia-comp-col--today">
          <span class="sw-dia-comp-label">Current Payable Price</span>
          <span class="sw-dia-comp-sub">(Paying Today)</span>
          <span class="sw-dia-comp-val sw-dia-comp-val--today" id="swDiaModalTodayPrice">Rs. 0.00</span>
        </div>
      </div>

      <div class="sw-dia-warning-callout">
        <div class="sw-dia-warning-icon">⚠️</div>
        <div class="sw-dia-warning-text">
          <strong>Important Price Confirmation:</strong>
          If you continue now, the 30% discount will <em>not</em> be applied. The promotional price is a reference price for the scheduled sale window only.
        </div>
      </div>

      <!-- MANDATORY UNCHECKED ACKNOWLEDGEMENT CHECKBOX -->
      <label class="sw-dia-ack-container" for="DiamondSaleAckCheckbox">
        <input type="checkbox" id="DiamondSaleAckCheckbox" class="sw-dia-checkbox" unselectable="on">
        <span class="sw-dia-ack-text">
          I understand that the 30% Diamond Sale starts on <strong>November 6, 2026 at 2:00 PM IST</strong>, and I agree to proceed now at the current original payable price of <strong id="swDiaModalCheckPrice">Rs. 0.00</strong>.
        </span>
      </label>
    </div>

    <div class="sw-dia-modal-actions">
      <button type="button" id="DiamondSaleModalContinueBtn" class="sw-dia-btn-continue" disabled>
        <span>CONTINUE AT REGULAR PRICE</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </button>
      <button type="button" id="DiamondSaleModalCancelBtn" class="sw-dia-btn-cancel" onclick="window.DiamondSale && window.DiamondSale.closePreSaleWarningModal()">
        Wait for Nov 6 Sale
      </button>
    </div>
  </div>
</div>

