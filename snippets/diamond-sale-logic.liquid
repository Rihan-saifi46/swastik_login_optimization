<script>
(function() {
  'use strict';

  // Read server metadata
  const configEl = document.getElementById('diamond-sale-config-json');
  let config = {};
  if (configEl) {
    try {
      config = JSON.parse(configEl.textContent || '{}');
    } catch(e) {}
  }

  // Target timestamps in Asia/Kolkata (UTC+05:30)
  // 6 November 2026, 2:00 PM IST = 1793953800000 UTC
  // 6 November 2026, 6:00 PM IST = 1793968200000 UTC
  const SALE_START_UTC = Date.parse(config.saleStartIso || '2026-11-06T14:00:00+05:30');
  const SALE_END_UTC   = Date.parse(config.saleEndIso   || '2026-11-06T18:00:00+05:30');
  const DISCOUNT_PERCENT = config.discountPercent || 30;

  // Clock Synchronization with Server (immune to user client clock drift)
  let serverTimeOffset = 0;
  if (config.serverTimeUnix) {
    serverTimeOffset = Number(config.serverTimeUnix) - Date.now();
  }

  // Active testing override support (?diamond_sale_test_phase=pre-sale|active|post-sale)
  let manualTestPhase = null;
  try {
    const urlParams = new URLSearchParams(window.location.search);
    const testParam = urlParams.get('diamond_sale_test_phase');
    if (testParam && ['pre-sale', 'active', 'post-sale'].includes(testParam.toLowerCase())) {
      manualTestPhase = testParam.toLowerCase();
    }
  } catch(e) {}

  // Request atomic Date header from origin to guarantee accurate time synchronization
  try {
    fetch(window.location.href, { method: 'HEAD', cache: 'no-store' })
      .then(res => {
        const dateHeader = res.headers.get('date');
        if (dateHeader) {
          const atomicServerNow = new Date(dateHeader).getTime();
          serverTimeOffset = atomicServerNow - Date.now();
          if (DiamondSaleController) {
            DiamondSaleController.recalculate();
          }
        }
      })
      .catch(() => {});
  } catch(e) {}

  function getAtomicNow() {
    return Date.now() + serverTimeOffset;
  }

  function formatMoney(cents) {
    const val = (Number(cents) || 0) / 100;
    return 'Rs. ' + val.toLocaleString('en-IN', {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    });
  }

  // Controller Definition
  const DiamondSaleController = {
    config: config,
    currentPhase: 'pre-sale',
    isAcknowledgedForCheckout: false,
    activePendingAction: null,

    getSalePhase: function() {
      if (manualTestPhase) return manualTestPhase;
      const now = getAtomicNow();
      if (now < SALE_START_UTC) {
        return 'pre-sale';
      } else if (now >= SALE_START_UTC && now < SALE_END_UTC) {
        return 'active';
      } else {
        return 'post-sale';
      }
    },

    setTestPhase: function(phase) {
      if (!['pre-sale', 'active', 'post-sale', null].includes(phase)) {
        console.warn('[DiamondSale] Invalid phase. Choose "pre-sale", "active", "post-sale", or null.');
        return;
      }
      manualTestPhase = phase;
      this.recalculate();
      console.log('[DiamondSale] Test phase set to:', this.getSalePhase());
    },

    isProductEligible: function() {
      return Boolean(config.isCurrentProductEligible);
    },

    cartHasDiamond: function() {
      return Boolean(config.cartHasDiamond);
    },

    isCheckoutDiscountConfigured: function() {
      return Boolean(config.isCheckoutDiscountConfigured);
    },

    getCurrentVariantDiamondValue: function(variantId) {
      const targetId = variantId || config.currentVariantId;

      // 1. Check pp-variant-metafields-json
      const metaEl = document.getElementById('pp-variant-metafields-json');
      if (metaEl && targetId) {
        try {
          const allMeta = JSON.parse(metaEl.textContent || '{}');
          const vMeta = allMeta[String(targetId)] || allMeta[targetId];
          if (vMeta && vMeta.diamond_value !== undefined && vMeta.diamond_value !== null) {
            const parsed = parseFloat(String(vMeta.diamond_value).replace(/[^0-9.]/g, ''));
            if (!isNaN(parsed) && parsed > 0) {
              return Math.round(parsed * 100); // rupees to cents
            }
          }
        } catch(e) {}
      }

      // 2. Check DOM element #ui-price-diamond
      const domDiaEl = document.getElementById('ui-price-diamond');
      if (domDiaEl) {
        const inrAttr = domDiaEl.getAttribute('data-inr-price');
        if (inrAttr) {
          const val = parseFloat(inrAttr);
          if (!isNaN(val) && val > 0) return Math.round(val);
        }
        const text = domDiaEl.textContent || '';
        const match = text.replace(/,/g, '').match(/[0-9.]+/);
        if (match) {
          const val = parseFloat(match[0]);
          if (!isNaN(val) && val > 0) return Math.round(val * 100);
        }
      }

      // 3. Check config value passed from Liquid
      if (config.currentVariantDiamondValue && Number(config.currentVariantDiamondValue) > 0) {
        return Number(config.currentVariantDiamondValue);
      }

      return 0;
    },

    calculatePromotionalPrice: function(originalPriceCents, diamondValueCents) {
      const orig = Number(originalPriceCents) || 0;
      let diaVal = (diamondValueCents !== undefined && diamondValueCents !== null)
        ? Number(diamondValueCents)
        : this.getCurrentVariantDiamondValue();

      if (diaVal && diaVal > 0) {
        // 30% discount applies ONLY to the diamond component/value
        const discount = Math.round((diaVal * DISCOUNT_PERCENT) / 100);
        const promo = Math.max(0, orig - discount);
        return {
          originalCents: orig,
          diamondValueCents: diaVal,
          promoCents: promo,
          discountCents: discount,
          percent: DISCOUNT_PERCENT
        };
      } else {
        // If diamond component is not available, do NOT guess or discount full price
        return {
          originalCents: orig,
          diamondValueCents: 0,
          promoCents: orig,
          discountCents: 0,
          percent: 0
        };
      }
    },

    // Update PDP UI based on current phase and variant
    updatePdpPriceUI: function(variant, explicitCouponApplied) {
      if (!config.isProductPage || !this.isProductEligible()) return;

      const phase = this.getSalePhase();
      this.currentPhase = phase;

      const priceEl = document.getElementById('pp-price');
      const struckPriceEl = document.getElementById('pp-price-original-struck');
      const badgeEl = document.getElementById('pp-diamond-sale-badge');
      const noticeEl = document.getElementById('pp-diamond-sale-notice');
      const noticePill = document.getElementById('pp-dia-notice-pill');
      const noticeText = document.getElementById('pp-dia-notice-text');

      if (!priceEl) return;

      const targetVariantPrice = variant ? Number(variant.price) : Number(config.currentVariantPrice || 0);
      if (!targetVariantPrice) return;

      const targetVariantId = variant ? variant.id : config.currentVariantId;
      const diamondValCents = this.getCurrentVariantDiamondValue(targetVariantId);
      const calc = this.calculatePromotionalPrice(targetVariantPrice, diamondValCents);
      const hasRealDiscount = (calc.discountCents > 0 && calc.promoCents < calc.originalCents);

      // If a valid coupon is applied via pdp-coupon-modal, avoid collision
      if (explicitCouponApplied) {
        if (noticeEl) noticeEl.style.display = 'none';
        return;
      }

      if (phase === 'pre-sale') {
        if (hasRealDiscount) {
          priceEl.innerHTML = formatMoney(calc.promoCents);
          priceEl.classList.add('pp-price--discounted');

          if (struckPriceEl) {
            struckPriceEl.innerHTML = formatMoney(calc.originalCents);
            struckPriceEl.style.display = 'inline-block';
            struckPriceEl.classList.add('pp-price--original');
          }

          if (badgeEl) badgeEl.style.display = 'inline-flex';

          if (noticeEl) {
            noticeEl.style.display = 'block';
            if (noticePill) {
              noticePill.textContent = 'PROMOTIONAL REFERENCE PRICE';
              noticePill.classList.remove('pp-dia-notice-pill--live');
            }
            if (noticeText) {
              noticeText.innerHTML = `Upcoming 30% Diamond Sale starts Nov 6, 2:00 PM–6:00 PM IST (30% off diamond component: save ${formatMoney(calc.discountCents)}). Current payable price today is original price (<strong id="pp-dia-today-price">${formatMoney(calc.originalCents)}</strong>).`;
            }
          }
        } else {
          // No diamond value available: display regular price
          priceEl.innerHTML = formatMoney(calc.originalCents);
          priceEl.classList.remove('pp-price--discounted');
          if (struckPriceEl) struckPriceEl.style.display = 'none';
          if (badgeEl) badgeEl.style.display = 'none';
          if (noticeEl) noticeEl.style.display = 'none';
        }
      } else if (phase === 'active') {
        if (this.isCheckoutDiscountConfigured() && hasRealDiscount) {
          priceEl.innerHTML = formatMoney(calc.promoCents);
          priceEl.classList.add('pp-price--discounted');

          if (struckPriceEl) {
            struckPriceEl.innerHTML = formatMoney(calc.originalCents);
            struckPriceEl.style.display = 'inline-block';
            struckPriceEl.classList.add('pp-price--original');
          }

          if (badgeEl) badgeEl.style.display = 'inline-flex';

          if (noticeEl) {
            noticeEl.style.display = 'block';
            if (noticePill) {
              noticePill.textContent = 'FLASH SALE LIVE';
              noticePill.classList.add('pp-dia-notice-pill--live');
            }
            if (noticeText) {
              noticeText.innerHTML = `30% Diamond Sale discount active! Save ${formatMoney(calc.discountCents)} on the diamond component automatically at checkout.`;
            }
          }
        } else {
          priceEl.innerHTML = formatMoney(calc.originalCents);
          priceEl.classList.remove('pp-price--discounted');
          if (struckPriceEl) struckPriceEl.style.display = 'none';
          if (badgeEl) badgeEl.style.display = 'none';
          if (noticeEl) {
            noticeEl.style.display = 'block';
            if (noticePill) noticePill.textContent = 'FLASH SALE ACTIVE';
            if (noticeText) noticeText.innerHTML = 'Checkout discount is currently being finalized.';
          }
        }
      } else {
        // Phase 3: Post-Sale
        priceEl.innerHTML = formatMoney(calc.originalCents);
        priceEl.classList.remove('pp-price--discounted');
        if (struckPriceEl) {
          struckPriceEl.style.display = 'none';
          struckPriceEl.classList.remove('pp-price--original');
        }
        if (badgeEl) badgeEl.style.display = 'none';
        if (noticeEl) noticeEl.style.display = 'none';
      }
    },

    onVariantChange: function(variant) {
      if (!variant) return;
      config.currentVariantId = variant.id;
      config.currentVariantPrice = variant.price;
      this.updatePdpPriceUI(variant, false);
      this.updateModalPrices(variant.price, variant.id);
    },

    onCouponChange: function(variant, appliedCoupon) {
      this.updatePdpPriceUI(variant, Boolean(appliedCoupon));
    },

    updateModalPrices: function(originalPriceCents, variantId) {
      const orig = Number(originalPriceCents) || Number(config.currentVariantPrice) || 0;
      const diaVal = this.getCurrentVariantDiamondValue(variantId || config.currentVariantId);
      const calc = this.calculatePromotionalPrice(orig, diaVal);

      const modalPromo = document.getElementById('swDiaModalPromoPrice');
      const modalToday = document.getElementById('swDiaModalTodayPrice');
      const modalCheck = document.getElementById('swDiaModalCheckPrice');

      if (modalPromo) modalPromo.textContent = formatMoney(calc.promoCents);
      if (modalToday) modalToday.textContent = formatMoney(calc.originalCents);
      if (modalCheck) modalCheck.textContent = formatMoney(calc.originalCents);
    },

    shouldInterceptPDPBuyNow: function() {
      if (this.isAcknowledgedForCheckout) return false;
      const phase = this.getSalePhase();
      return (phase === 'pre-sale' && this.isProductEligible());
    },

    shouldInterceptCartCheckout: function() {
      if (this.isAcknowledgedForCheckout) return false;
      const phase = this.getSalePhase();
      return (phase === 'pre-sale' && this.cartHasDiamond());
    },

    openPreSaleWarningModal: function(options) {
      const modal = document.getElementById('DiamondSalePreSaleModal');
      const checkbox = document.getElementById('DiamondSaleAckCheckbox');
      const continueBtn = document.getElementById('DiamondSaleModalContinueBtn');

      if (!modal) return;

      this.activePendingAction = options ? options.onAcknowledge : null;

      // MANDATORY REQUIREMENT: Checkbox MUST be unchecked by default!
      if (checkbox) {
        checkbox.checked = false;
      }
      if (continueBtn) {
        continueBtn.disabled = true;
      }

      const origPrice = options && options.originalPriceCents ? options.originalPriceCents : config.currentVariantPrice;
      this.updateModalPrices(origPrice);

      modal.style.display = 'flex';
      document.body.classList.add('body-lock');
    },

    closePreSaleWarningModal: function() {
      const modal = document.getElementById('DiamondSalePreSaleModal');
      if (modal) {
        modal.style.display = 'none';
      }
      document.body.classList.remove('body-lock');
      this.activePendingAction = null;
    },

    confirmPreSaleAcknowledgement: function() {
      const checkbox = document.getElementById('DiamondSaleAckCheckbox');
      if (!checkbox || !checkbox.checked) return;

      this.isAcknowledgedForCheckout = true;
      sessionStorage.setItem('sw_diamond_sale_acknowledged', 'true');

      const action = this.activePendingAction;
      this.closePreSaleWarningModal();

      if (typeof action === 'function') {
        action();
      }
    },

    updateProductCardsPriceUI: function() {
      const self = this;
      const phase = self.getSalePhase();
      const isDiscountConfigured = self.isCheckoutDiscountConfigured();

      const selector = '.product-card-ui__price-row[data-diamond-eligible="true"], .pp-related-price-row[data-diamond-eligible="true"]';
      document.querySelectorAll(selector).forEach(function(row) {
        const currentEl = row.querySelector('.js-card-price-current') || row.querySelector('.price-current, .pp-rel-current');
        const originalEl = row.querySelector('.js-card-price-original') || row.querySelector('.price-original, .pp-rel-compare');
        if (!currentEl) return;

        const origCents = Number(row.getAttribute('data-original-price')) || 0;
        const promoCents = Number(row.getAttribute('data-promo-price')) || origCents;
        const hasRealDiscount = (promoCents > 0 && promoCents < origCents);

        function formatInr(cents) {
          const rupees = Math.round((Number(cents) || 0) / 100);
          return '₹' + rupees.toLocaleString('en-IN');
        }

        const card = row.closest('.product-card-ui, .pp-related-item-card');
        const badgeEl = card ? card.querySelector('.pp-rel-badge') : null;

        if (phase === 'pre-sale') {
          if (hasRealDiscount) {
            currentEl.textContent = formatInr(promoCents);
            if (originalEl) {
              originalEl.textContent = formatInr(origCents);
              originalEl.style.display = 'inline';
            }
          } else {
            currentEl.textContent = formatInr(origCents);
            if (originalEl) originalEl.style.display = 'none';
          }
        } else if (phase === 'active') {
          if (isDiscountConfigured && hasRealDiscount) {
            currentEl.textContent = formatInr(promoCents);
            if (originalEl) {
              originalEl.textContent = formatInr(origCents);
              originalEl.style.display = 'inline';
            }
          } else {
            currentEl.textContent = formatInr(origCents);
            if (originalEl) originalEl.style.display = 'none';
          }
        } else {
          // Post-sale: Restore normal original price, hide strikethrough
          currentEl.textContent = formatInr(origCents);
          if (originalEl) originalEl.style.display = 'none';
          if (badgeEl && badgeEl.getAttribute('data-original-badge')) {
            badgeEl.textContent = badgeEl.getAttribute('data-original-badge');
          }
        }
      });
    },

    recalculate: function() {
      this.updatePdpPriceUI(null, false);
      this.updateProductCardsPriceUI();
    },

    init: function() {
      const self = this;

      // Check session acknowledgement
      if (sessionStorage.getItem('sw_diamond_sale_acknowledged') === 'true') {
        self.isAcknowledgedForCheckout = true;
      }

      // Checkbox listener in modal
      const checkbox = document.getElementById('DiamondSaleAckCheckbox');
      const continueBtn = document.getElementById('DiamondSaleModalContinueBtn');

      if (checkbox && continueBtn) {
        checkbox.addEventListener('change', function() {
          continueBtn.disabled = !checkbox.checked;
        });

        continueBtn.addEventListener('click', function() {
          if (!continueBtn.disabled) {
            self.confirmPreSaleAcknowledgement();
          }
        });
      }

      // Authoritative CRM Status Sync (Optional remote status & clock sync)
      try {
        const crmStatusUrl = window.DiamondSaleCrmEndpoint || 'https://backend-api.swastikjewel.in/api/diamond-sale/status';
        fetch(crmStatusUrl, { method: 'GET', headers: { 'Accept': 'application/json' }, cache: 'no-cache' })
          .then(res => res.json())
          .then(data => {
            if (data && data.status === 'success') {
              if (data.checkout_discount_active !== undefined) {
                config.isCheckoutDiscountConfigured = Boolean(data.checkout_discount_active);
              }
              if (data.server_time_unix) {
                serverTimeOffset = Number(data.server_time_unix) - Date.now();
              }
              self.recalculate();
            }
          })
          .catch(() => {
            // Gracefully retain Liquid server metadata if CRM endpoint is unreachable or in dev
          });
      } catch(e) {}

      // Initial price display
      self.updatePdpPriceUI(null, false);
      self.updateProductCardsPriceUI();

      // Re-apply on dynamic section or filter reload
      document.addEventListener('shopify:section:load', function() {
        self.updateProductCardsPriceUI();
      });

      // Heartbeat timer every 10 seconds to detect sale start (2:00 PM) and end (6:00 PM) transitions
      setInterval(function() {
        const nextPhase = self.getSalePhase();
        if (nextPhase !== self.currentPhase) {
          self.currentPhase = nextPhase;
          self.recalculate();
        }
      }, 10000);

      // Global fallback click interceptor for checkout / buy-now buttons
      document.addEventListener('click', function(e) {
        if (self.isAcknowledgedForCheckout) return;
        const target = e.target.closest('a[href*="/checkout"], button[name="checkout"], .btn-checkout, .pp-btn-buy, .btn-buy-now');
        if (!target) return;
        if (target.disabled || target.classList.contains('is-out-of-stock') || target.getAttribute('aria-disabled') === 'true') return;

        const isBuyNow = target.classList.contains('pp-btn-buy') || target.classList.contains('btn-buy-now');
        if (isBuyNow && self.shouldInterceptPDPBuyNow()) {
          e.preventDefault();
          e.stopPropagation();
          const currentPriceAttr = document.getElementById('pp-price')?.getAttribute('data-inr-price');
          self.openPreSaleWarningModal({
            source: 'global_click_buy_now',
            originalPriceCents: currentPriceAttr,
            onAcknowledge: function() {
              if (target.tagName.toLowerCase() === 'button' && target.type === 'submit') {
                target.form ? target.form.submit() : target.click();
              } else {
                target.click();
              }
            }
          });
        } else if (!isBuyNow && self.shouldInterceptCartCheckout()) {
          e.preventDefault();
          e.stopPropagation();
          self.openPreSaleWarningModal({
            source: 'global_click_checkout',
            onAcknowledge: function() {
              if (target.tagName.toLowerCase() === 'a' && target.href) {
                window.location.href = target.href;
              } else if (target.form) {
                target.form.submit();
              } else {
                target.click();
              }
            }
          });
        }
      });
    }
  };

  // Expose Globally
  window.DiamondSale = DiamondSaleController;

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      DiamondSaleController.init();
    });
  } else {
    DiamondSaleController.init();
  }
})();
</script>
