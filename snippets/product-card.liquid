{% doc %}
  Renders a luxury product card matching the Solitaire Ring UI specification.

  @param {product} product - The product object to render.
{% enddoc %}

{% if product == blank %}
{% else %}
{% assign current_variant = product.selected_or_first_available_variant %}
{% assign original_price = current_variant.compare_at_price %}
{% assign price = current_variant.price %}

{%- assign is_diamond_product = false -%}
{%- if product -%}
  {%- assign p_title_lower = product.title | downcase -%}
  {%- assign p_type_lower = product.type | downcase -%}
  {%- if p_title_lower contains 'diamond' or p_type_lower contains 'diamond' -%}
    {%- assign is_diamond_product = true -%}
  {%- endif -%}
  {%- for tag in product.tags -%}
    {%- assign tag_lower = tag | downcase -%}
    {%- if tag_lower contains 'diamond' or tag_lower == 'diamond-sale' or tag_lower == 'dhanteras-sale' -%}
      {%- assign is_diamond_product = true -%}
    {%- endif -%}
  {%- endfor -%}
  {%- for col in product.collections -%}
    {%- assign col_h = col.handle | downcase -%}
    {%- if col_h contains 'diamond' -%}
      {%- assign is_diamond_product = true -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if product.metafields.custom.diamond_weight != blank -%}
    {%- assign is_diamond_product = true -%}
  {%- endif -%}
  {%- for variant in product.variants -%}
    {%- if variant.metafields.custom.diamond_value != blank and variant.metafields.custom.diamond_value > 0 -%}
      {%- assign is_diamond_product = true -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- if is_diamond_product -%}
  {%- assign variant_diamond_val = current_variant.metafields.custom.diamond_value | default: 0 | plus: 0 -%}
  {%- if variant_diamond_val > 0 -%}
    {%- assign diamond_val_cents = variant_diamond_val | times: 100 -%}
    {%- assign diamond_discount = diamond_val_cents | times: 30 | divided_by: 100 -%}
    {%- assign diamond_sale_promo_price = price | minus: diamond_discount | divided_by: 100 | round | times: 100 -%}
  {%- else -%}
    {%- assign diamond_val_cents = 0 -%}
    {%- assign diamond_sale_promo_price = price -%}
  {%- endif -%}
{%- endif -%}

{% assign class_prefix_default = class_prefix | default: 'best-sellers' %}
{% assign product_url = product.url %}
{% assign product_title = product.title %}

{{ 'component-product-card.css' | asset_url | stylesheet_tag }}

<a href="{{ product_url }}" class="product-card-ui" data-product-id="{{ product.id }}" data-variant-id="{{ current_variant.id }}">
  <!-- Image Area -->
  <div class="product-card-ui__image-wrapper">
    <div class="product-card-ui__wishlist">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
      </svg>
    </div>

    {% if product.featured_image %}
      <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product_title | escape }}" class="product-card-ui__img" loading="lazy" width="400" height="400">
    {% else %}
      <img src="{{ 'fallback-image.png' | asset_url }}" alt="Jewelry" class="product-card-ui__img" loading="lazy" width="400" height="400">
    {% endif %}
  </div>

  <!-- Content Area -->
  <div class="product-card-ui__content">
    <h3 class="product-card-ui__title">{{ product_title }}</h3>
    
    <div class="product-card-ui__pills">
      {%- assign card_is_mto = false -%}
      {%- if product.tags contains 'Made to Order' or product.tags contains 'made to order' or product.tags contains 'made-to-order' -%}
        {%- assign card_is_mto = true -%}
      {%- endif -%}
      {%- assign card_is_out_of_stock = false -%}
      {%- if current_variant.available == false -%}
        {%- assign card_is_out_of_stock = true -%}
      {%- elsif current_variant.inventory_management != blank and current_variant.inventory_quantity != blank and current_variant.inventory_quantity <= 0 and card_is_mto == false -%}
        {%- assign card_is_out_of_stock = true -%}
      {%- endif -%}

      {%- assign card_is_booked = false -%}
      {%- if current_variant.metafields.custom.reserved == true or current_variant.metafields.custom.reserved == 'true' or current_variant.metafields.custom.booked == true or current_variant.metafields.custom.booked == 'true' or current_variant.metafields.custom.booking_status == 'confirmed' or current_variant.metafields.custom.booking_status == 'booked' -%}
        {%- assign card_is_booked = true -%}
      {%- endif -%}
      {%- if product.metafields.custom.reserved == true or product.metafields.custom.reserved == 'true' or product.metafields.custom.booked == true or product.metafields.custom.booked == 'true' or product.metafields.custom.booking_status == 'confirmed' or product.metafields.custom.booking_status == 'booked' -%}
        {%- if product.has_only_default_variant or product.variants.size <= 1 -%}
          {%- assign card_is_booked = true -%}
        {%- endif -%}
      {%- endif -%}
      {%- assign card_v_id_str = current_variant.id | append: '' -%}
      {%- for tag in product.tags -%}
        {%- assign tag_lower = tag | downcase -%}
        {%- if tag_lower == 'dhanteras-reserved' or tag_lower == 'booked' or tag_lower == 'dhanteras-booked' or tag_lower == 'reserved' -%}
          {%- if product.has_only_default_variant or product.variants.size <= 1 -%}
            {%- assign card_is_booked = true -%}
          {%- endif -%}
        {%- elsif tag_lower contains 'dhanteras-reserved:' or tag_lower contains 'booked:' or tag_lower contains 'dhanteras-booked:' or tag_lower contains 'reserved:' -%}
          {%- if tag_lower contains card_v_id_str -%}
            {%- assign card_is_booked = true -%}
          {%- elsif product.has_only_default_variant or product.variants.size <= 1 -%}
            {%- assign card_is_booked = true -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if card_is_booked -%}
        <span class="product-card-ui__pill product-card-ui__pill--booked">BOOKED</span>
      {%- elsif card_is_out_of_stock -%}
        <span class="product-card-ui__pill product-card-ui__pill--sold-out product-card-ui__pill--out-of-stock">Out of Stock</span>
      {%- elsif card_is_mto and current_variant.inventory_policy == 'continue' -%}
        <span class="product-card-ui__pill product-card-ui__pill--made-to-order">Made to Order</span>
      {%- else -%}
        <span class="product-card-ui__pill product-card-ui__pill--in-stock">In Stock</span>
      {%- endif -%}
    </div>

    {% assign rev_count = product.id | modulo: 80 | plus: 48 %}
    <div class="product-card-ui__reviews">
      <span class="product-card-ui__stars">★★★★★</span>
      <span class="product-card-ui__review-count">({{ rev_count }})</span>
    </div>

    <div class="product-card-ui__price-row" data-diamond-eligible="{{ is_diamond_product }}" data-original-price="{{ price }}" data-diamond-value="{{ diamond_val_cents | default: 0 }}" data-promo-price="{{ diamond_sale_promo_price | default: price }}">
      {%- if is_diamond_product and diamond_sale_promo_price < price -%}
        <span class="price-current money js-card-price-current" data-inr-price="{{ diamond_sale_promo_price }}">{{ diamond_sale_promo_price | money_without_trailing_zeros | replace: 'Rs.', '₹' | replace: 'Rs ', '₹' | replace: 'Rs', '₹' | replace: '$', '₹' | replace: 'USD', '₹' | replace: '₹ ', '₹' }}</span>
        <s class="price-original money js-card-price-original" data-inr-price="{{ price }}">{{ price | money_without_trailing_zeros | replace: 'Rs.', '₹' | replace: 'Rs ', '₹' | replace: 'Rs', '₹' | replace: '$', '₹' | replace: 'USD', '₹' | replace: '₹ ', '₹' }}</s>
      {%- else -%}
        <span class="price-current money js-card-price-current" data-inr-price="{{ price }}">{{ price | money_without_trailing_zeros | replace: 'Rs.', '₹' | replace: 'Rs ', '₹' | replace: 'Rs', '₹' | replace: '$', '₹' | replace: 'USD', '₹' | replace: '₹ ', '₹' }}</span>
        {% if original_price > price %}
          <s class="price-original money js-card-price-original" data-inr-price="{{ original_price }}">{{ original_price | money_without_trailing_zeros | replace: 'Rs.', '₹' | replace: 'Rs ', '₹' | replace: 'Rs', '₹' | replace: '$', '₹' | replace: 'USD', '₹' | replace: '₹ ', '₹' }}</s>
        {% endif %}
      {%- endif -%}
    </div>

    <div class="product-card-ui__view-btn">
      <span>View Details</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="product-card-ui__bag-icon"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
    </div>
  </div>
</a>
{% endif %}
