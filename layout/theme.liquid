<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Montserrat:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ 'theme-custom.css' | asset_url | stylesheet_tag }}
    {{ 'custom.css' | asset_url | stylesheet_tag }}
    {{ 'critical.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'custom-cart-drawer.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>

    <script>
      window.shopUrl = '{{ request.origin }}';
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}'
      };
      window.cartStrings = {
        error: `{{ 'sections.cart.cart_error' | t }}`,
        quantityError: `{{ 'sections.cart.cart_quantity_error_html' | t: quantity: '[quantity]' }}`
      };
    </script>
    <script>
      // Global Wishlist Functions using native Shopify Customer API / LocalStorage
      window.wishlist = JSON.parse(localStorage.getItem('swastik_wishlist') || '[]');
      
      window.updateWishlistBadge = function() {
        const badges = document.querySelectorAll('.wishlist-count-badge');
        const count = window.wishlist.length;
        badges.forEach(b => {
          b.textContent = count;
          if (count > 0) {
            b.classList.remove('hidden');
          } else {
            b.classList.add('hidden');
          }
        });
      };

      window.toggleWishlist = async function(productId, btnElement) {
        if (!productId) return;
        productId = String(productId);
        const index = window.wishlist.indexOf(productId);
        
        // Optimistic UI toggle
        const isAdding = index === -1;
        if (isAdding) {
          window.wishlist.push(productId);
        } else {
          window.wishlist.splice(index, 1);
        }
        localStorage.setItem('swastik_wishlist', JSON.stringify(window.wishlist));
        window.updateWishlistBadge();

        // Update all buttons for this product
        document.querySelectorAll(`[data-product-id="${productId}"] .product-card-ui__wishlist, [data-product-id="${productId}"].product-card-ui__wishlist, .product-single__wishlist-btn`).forEach(btn => {
          if (isAdding) {
            btn.classList.add('active');
          } else {
            btn.classList.remove('active');
          }
        });

        // Trigger custom event for wishlist drawer to refresh
        document.dispatchEvent(new CustomEvent('wishlist:updated', { 
          detail: { wishlist: window.wishlist, productId: productId, action: isAdding ? 'add' : 'remove' } 
        }));
      };

      document.addEventListener('DOMContentLoaded', () => {
        window.updateWishlistBadge();
        // Initialize active state on product cards
        window.wishlist.forEach(id => {
          document.querySelectorAll(`[data-product-id="${id}"] .product-card-ui__wishlist, [data-product-id="${id}"].product-card-ui__wishlist`).forEach(btn => {
            btn.classList.add('active');
          });
        });

        // Global delegated click listener for wishlist buttons
        document.addEventListener('click', (e) => {
          const btn = e.target.closest('.product-card-ui__wishlist, .best-sellers__wishlist-btn, .new-arrivals__wishlist-btn, .product-single__wishlist-btn');
          if (!btn) return;
          
          e.preventDefault();
          e.stopPropagation();

          let card = btn.closest('[data-product-id]');
          let productId = card ? card.getAttribute('data-product-id') : btn.getAttribute('data-product-id');
          
          if (!productId) {
            const form = btn.closest('form[action*="/cart/add"]');
            if (form) {
              const idInput = form.querySelector('input[name="id"]');
              if (idInput) productId = idInput.value;
            }
          }

          if (productId) {
            window.toggleWishlist(productId, btn);
          }
        });
      });
    </script>
    <script>
      // Global Currency Formatter
      window.formatMoney = function(cents) {
        if (typeof cents === 'string') {
          cents = cents.replace('.', '');
        }
        var value = '';
        var placeholderRegex = /\{\{\s*(\w+)\s*\}\}/;
        var formatString = '₹ {{amount_no_decimals}}';
        
        function formatWithDelimiters(number, precision, thousands, decimal) {
          precision = precision || 0;
          thousands = thousands || ',';
          decimal = decimal || '.';
          
          if (isNaN(number) || number == null) {
            return 0;
          }
          
          number = (number / 100.0).toFixed(precision);
          
          var parts = number.split('.');
          var dollarsAmount = parts[0].replace(/(\d)(?=(\d\d\d)+(?!\d))/g, '$1' + thousands);
          var centsAmount = parts[1] ? decimal + parts[1] : '';
          
          return dollarsAmount + centsAmount;
        }

        var amount = (cents / 100.0);
        var formatter = new Intl.NumberFormat('en-IN', {
          style: 'currency',
          currency: 'INR',
          maximumFractionDigits: 2
        });
        return formatter.format(value);
      };
    </script>

    <meta name="facebook-domain-verification" content="ha2t4ybzlfsbl0x31lwx852h2wirkk" />

    {{ content_for_header }}
  </head>

  <body>
    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}

    {% render 'theme-ajax-sync' %}
    {% section 'cart-drawer' %}
    {% section 'wishlist-drawer' %}
    {% section 'whatsapp-widget' %}
    {% section 'video-call-modal' %}
    {% section 'coupon-popup' %}

    <!-- WhatsApp Click Tracking for Meta Pixel - Swastik Jewels -->
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        document.body.addEventListener('click', function (e) {
          var link = e.target.closest('a');
          if (!link) return;

          var href = link.getAttribute('href') || '';

          // Detects any WhatsApp link: wa.me or api.whatsapp.com
          if (href.indexOf('wa.me') !== -1 || href.indexOf('api.whatsapp.com') !== -1) {
            if (typeof fbq !== 'undefined') {
              fbq('track', 'Lead', {
                content_name: 'WhatsApp Click',
                content_category: 'WhatsApp Button'
              });
              console.log('Meta Pixel: WhatsApp Lead event fired');
            }
          }
        });
      });
    </script>

  </body>
</html>
